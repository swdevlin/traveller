module SummaryFixtures exposing (drizzleTree, fullGasGiant, fullMoon, fullPlanetoid, moonsPage, planetoidsPage)

{-| Output of the Rails API for the Big Drizzle campaign, kept to check the starmap decodes it.

  - drizzleTree: GET starmap/data/hex for one system (primary\_star), cut to a gas giant, terrestrial
    planets, belts and two planetoids
  - fullGasGiant: GET starmap/data/objects/:id for a gas giant with fifteen moons
  - fullMoon: the same for one of its moons
  - fullPlanetoid: the same for a planetoid of a belt
  - planetoidsPage: GET starmap/data/objects/:id/planetoids, page one of a belt's ninety-three planetoids
  - moonsPage: GET starmap/data/objects/:id/moons, page one of a gas giant's twenty-seven moons, cut to three rows

-}


