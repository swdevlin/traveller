<%%= form_with(model: <%= singular_table_name %>, class: 'contents') do |form| %>
  <div class='space-y-6 pb-10'>
    <%% if <%= singular_table_name %>.errors.any? %>
      <div class='card danger'>
        <header>
          <h3>Validation</h3>
        </header>
        <div class='mt-1 text-sm font-semibold'>
          <%%= pluralize(<%= singular_table_name %>.errors.count, 'error') %> prevented this <%= human_name.downcase %> from being saved
        </div>

        <ul class='error-list mt-3'>
          <%% <%= singular_table_name %>.errors.each do |error| %>
            <li><span><%%= error.full_message %></span></li>
          <%% end %>
        </ul>
      </div>
    <%% end %>
<% attributes.each_with_index do |attribute, index| -%>

<% if attribute.password_digest? -%>
    <div<%= index == 0 ? " class='mt-4'" : "" %>>
      <%%= form.label :password, class: 'edit-label' %>
      <%%= form.password_field :password,
                          class: 'w-full edit-base mt-2 sm:w-1/2',
                          aria: { invalid: <%= singular_table_name %>.errors[:password].any? } %>
    </div>

    <div>
      <%%= form.label :password_confirmation, class: 'edit-label' %>
      <%%= form.password_field :password_confirmation,
                          class: 'w-full edit-base mt-2 sm:w-1/2',
                          aria: { invalid: <%= singular_table_name %>.errors[:password_confirmation].any? } %>
    </div>
<% elsif attribute.attachments? -%>
    <div<%= index == 0 ? " class='mt-4'" : "" %>>
      <%%= form.label :<%= attribute.column_name %>, class: 'edit-label' %>
      <%%= form.<%= attribute.field_type %> :<%= attribute.column_name %>, multiple: true, class: 'edit-base mt-2' %>
    </div>
<% elsif attribute.attachment? -%>
    <div<%= index == 0 ? " class='mt-4'" : "" %>>
      <%%= form.label :<%= attribute.column_name %>, class: 'edit-label' %>
      <%%= form.<%= attribute.field_type %> :<%= attribute.column_name %>, class: 'edit-base mt-2' %>
    </div>
<% elsif attribute.type == :text -%>
    <div<%= index == 0 ? " class='mt-4'" : "" %>>
      <%%= form.label :<%= attribute.column_name %>, class: 'edit-label' %>
      <%%= form.text_area :<%= attribute.column_name %>,
                          rows: 4,
                          class: 'w-full edit-base mt-2 resize-y',
                          aria: { invalid: <%= singular_table_name %>.errors[:<%= attribute.column_name %>].any? } %>
    </div>
<% elsif attribute.type == :boolean -%>
    <div<%= index == 0 ? " class='mt-4'" : "" %>>
      <%%= form.label :<%= attribute.column_name %>, class: 'edit-label' %>
      <%%= form.check_box :<%= attribute.column_name %>, class: 'mt-2 rounded border-control-outline bg-panel-muted text-highlight focus:ring-highlight' %>
    </div>
<% else -%>
    <div<%= index == 0 ? " class='mt-4'" : "" %>>
      <%%= form.label :<%= attribute.column_name %>, class: 'edit-label' %>
      <%%= form.<%= attribute.field_type %> :<%= attribute.column_name %>,
                          class: 'w-full edit-base mt-2 sm:w-1/2',
                          aria: { invalid: <%= singular_table_name %>.errors[:<%= attribute.column_name %>].any? } %>
    </div>
<% end -%>
<% end -%>

    <div class='pt-2 flex flex-col sm:flex-row gap-2'>
      <%%= form.submit 'Update core', class: 'w-full sm:w-auto btn btn-primary' %>
      <%%= link_to 'Cancel', <%= singular_table_name %>.persisted? ? <%= singular_table_name %> : <%= plural_table_name %>_path, class: 'w-full sm:w-auto btn' %>
    </div>
  </div>
<%% end %>
