<%= content_for :title, @star.display_name %>
<%= content_for :page_kicker, "IISS Class 0/I Survey" %>
<%= content_for :page_title, @star.display_name %>
<%= content_for :iiss_form, 'FORM 0421B-0I' %>
<%= content_for :page_actions do %>
  <%= link_to edit_star_path(@star), class: 'btn-header' do %>
    <i class='fa-regular fa-pen-to-square' aria-hidden='true'></i> Edit
  <% end %>
  <%= render layout: 'application/actions_dropdown', locals: { menu_id: 'star-actions' } do %>
    <%= render 'application/copy_markdown_item', url: star_path(@star, format: :md) %>
  <% end %>
<% end %>

<%
  star_system = @star.star_system
  parsec = star_system&.parsec
  subsector = parsec&.subsector
%>

<% content_for :page_side do %>
  <%= render 'application/tags_sidebar', record: @star %>
  <% if subsector %>
    <%= render 'subsectors/map_embed', subsector: subsector, highlight: parsec.id %>
  <% end %>
<% end %>

<% nodes = orbit_strip_nodes(@star) %>
<%= render 'stellar_objects/orbit_strip_nav', nodes: nodes, index: nodes.index(@star) do %>
  <%= render(subsector || owns_campaign? ? 'application/two_column_page' : 'application/page', header_in_main: true) do %>
    <%= render @star %>
  <% end %>
<% end %>
