<%= render 'stellar_objects/object_context',
           hierarchy: [['Data Cores', data_cores_path], ['Survey Overlays', survey_overlays_path]] %>

<% content_for :title, @survey_overlay.name %>
<% content_for :page_kicker, 'Survey Overlay' %>
<% content_for :page_title, @survey_overlay.name %>

<%= render 'application/page' do %>
  <%= render @survey_overlay %>

  <%= link_to 'Edit', edit_survey_overlay_path(@survey_overlay), class: 'w-full sm:w-auto btn btn-primary' %>
  <%= button_to 'Delete',
                @survey_overlay,
                method: :delete,
                form_class: 'w-full sm:w-auto inline-flex m-0',
                class: 'w-full sm:w-auto btn btn-danger cursor-pointer',
                data: { turbo_confirm: "Delete #{@survey_overlay.name}?" } %>
<% end %>
