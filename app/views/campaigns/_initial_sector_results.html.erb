<div class='table-card'>
  <div class='table-banner'>
    <p>
      <% if query.present? && query.length >= 3 %>
        Search results
        <span class='pill ml-2'><%= sectors.length %></span>
      <% else %>
        Enter at least 3 characters to search
      <% end %>
    </p>
  </div>

  <% if sectors.any? %>
    <div class='table-scroll'>
      <table>
        <thead>
        <tr>
          <th scope='col'>Sector name</th>
          <th scope='col'>Coordinates</th>
          <th scope='col'>Tags</th>
          <th scope='col' class='text-right'></th>
        </tr>
        </thead>

        <tbody>
        <% sectors.each do |sector| %>
          <tr>
            <td class='font-medium'><%= sector['Name'] %></td>

            <td class='whitespace-nowrap'>
              <span class='pill'><%= sector['SectorX'] %>/<%= sector['SectorY'] %></span>
            </td>

            <td class='text-xs text-fg-muted'><%= sector['SectorTags'] %></td>

            <td class='text-right whitespace-nowrap'>
              <button type='button'
                      class='btn-header'
                      data-action='click->campaign-form#selectInitialSector'
                      data-name='<%= sector['Name'] %>'
                      data-x='<%= sector['SectorX'] %>'
                      data-y='<%= sector['SectorY'] %>'>
                Select
              </button>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>

  <% elsif query.present? && query.length >= 3 %>
    <div class='p-6 text-center text-fg-muted'>
      No sectors found matching "<%= query %>"
    </div>
  <% else %>
    <div class='p-6 text-center text-fg-muted'>
      <i class='fa-regular fa-globe text-2xl block mb-2'></i>
      <p>Search the Traveller Map database for your campaign's starting sector.</p>
    </div>
  <% end %>
</div>
