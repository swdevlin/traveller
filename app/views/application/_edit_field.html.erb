<%# locals: form:, attribute:, field_label: nil, required: false, calculated: false, unit: nil, row_data: {}, row_class: nil %>
<div class='<%= class_names('edit-row', local_assigns.fetch(:row_class, nil)) %>' <%= tag.attributes(data: local_assigns.fetch(:row_data, {})) %>>
  <div class='edit-label'>
    <%= local_assigns.fetch(:field_label, nil).presence || attribute.to_s.humanize %>
    <% if local_assigns.fetch(:required, false) %>
      <%= required_icon(form.object, attribute) %>
    <% end %>
    <% if local_assigns.fetch(:calculated, false) %>
      <i class='fa-regular fa-calculator ml-1'></i>
    <% end %>
  </div>

  <div class='edit-field'>
    <% unit = local_assigns.fetch(:unit, nil) %>
    <% if unit %>
      <div class='flex items-center gap-2'>
        <%= yield %>
        <span class='text-xs text-fg-muted'><%= unit %></span>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
    <%= render 'application/field_error', form: form, attribute: attribute %>
  </div>
</div>