<div>
  <div class='text-xs uppercase tracking-[0.22em] text-slate-400 pb-2'>
    Observations
  </div>

  <div class='<%= local_assigns[:notes].present? ? 'text-slate-200' : 'text-slate-400 italic' %>'>
    <div class='rounded-2xl border border-slate-700/70 bg-slate-950/40 p-2'>
      <div class='prose prose-invert max-w-none
            prose-headings:tracking-[0.2em] prose-headings:uppercase
            prose-a:text-deepnight-orange prose-a:no-underline hover:prose-a:underline
            prose-code:text-slate-200 prose-code:bg-slate-900/60 prose-code:px-1 prose-code:py-0.5 prose-code:rounded
            prose-pre:bg-slate-950/60 prose-pre:border prose-pre:border-slate-700/70 prose-pre:rounded-2xl'>
        <% if local_assigns[:notes].present? %>
          <%= render_markdown(notes) %>
        <% else %>
          No findings reported.
        <% end %>
      </div>
    </div>
  </div>
</div>
