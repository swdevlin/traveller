<%# Locals: header_in_main (optional) - render the title and actions above the main column only, not across both columns. %>
<% header_in_main = local_assigns.fetch(:header_in_main, false) %>
<div class="w-full">
  <div class="page-shell">
    <%= render 'application/page_header' unless header_in_main %>

    <div class="page-body">
      <div class="page-main">
        <% if header_in_main %>
          <div class='mb-4'>
            <%= render 'application/page_header' %>
          </div>
        <% end %>
        <%= yield %>
        <% if content_for?(:iiss_form) %>
          <div class="iiss-form pt-6">
            FORM <%= yield :iiss_form %>
          </div>
        <% end %>

        <%= yield :page_buttons if content_for?(:page_buttons) %>
      </div>

      <div class="page-side">
        <%= yield :page_side if content_for?(:page_side) %>
      </div>
    </div>
  </div>
</div>
