<header id='navbar'
        class='fixed top-0 inset-x-0 z-40 max-w-none px-4 py-2 flex items-center justify-between text-sm leading-tight bg-nav-bar/95 backdrop-blur border-b border-outline'>
  <%= link_to (current_campaign&.name || 'My Traveller Universe'),
              root_path,
              class: 'font-bold mr-6 text-highlight no-underline hover:underline hover:underline-offset-2 truncate min-w-0' %>

  <% if authenticated? %>
    <div class='flex items-center gap-6 flex-1 min-w-0'>
      <% if current_campaign %>
        <div class='relative w-32 sm:w-48 shrink-0'
             data-controller='global-search'
             data-global-search-search-url-value='<%= search_path %>' data-tour-step="nav-search">
          <input type='text'
                 placeholder='Search&hellip;'
                 autocomplete='off'
                 data-global-search-target='input'
                 data-action='input->global-search#search focus->global-search#inputFocused blur->global-search#inputBlurred'
                 class='w-full bg-panel-muted border border-outline rounded-lg px-3 py-1.5 pr-8 text-sm text-fg placeholder:text-fg-muted focus:outline-none focus:border-highlight/50 focus:ring-1 focus:ring-highlight/30 transition'>
          <kbd data-global-search-target='hint'
               class='pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-[10px] text-fg-muted border border-outline rounded px-1'>/</kbd>
          <div data-global-search-target='dropdown'
               class='hidden absolute top-full left-0 right-0 mt-1 z-50 bg-dropdown border border-outline rounded-lg shadow-xl overflow-hidden'>
            <ul data-global-search-target='list'></ul>
          </div>
        </div>
      <% end %>

      <% if current_campaign %>
        <% starmap_params = @starmap_center ? { cx: @starmap_center[0], cy: @starmap_center[1] } : {} %>
        <div data-tour-step="nav-starmap" class='shrink-0 font-medium'>
          <%= link_to 'Starmap', campaign_starmap_path(starmap_params), class: 'hover:text-highlight hover:underline hover:underline-offset-2', target: '_blank', rel: 'noopener' %>
        </div>
      <% end %>

      <div class='lg:hidden' data-controller='dropdown'>
        <button data-action='dropdown#toggle'
                aria-label='Open navigation menu'
                class='inline-flex items-center text-link hover:text-highlight cursor-pointer bg-transparent border-0 p-0'>
          <i class='fa-regular fa-bars'></i>
        </button>

        <div data-dropdown-target='menu'
             class='hidden absolute inset-x-0 top-full z-50 p-4 bg-dropdown border-b border-outline shadow-xl'>
          <ul class='flex flex-col gap-3 font-medium'>
            <%= render 'application/navbar_links' %>
          </ul>
        </div>
      </div>

      <nav class='hidden lg:block'>
        <ul class='flex items-center gap-6 font-medium'>
          <%= render 'application/navbar_links' %>
        </ul>
      </nav>
    </div>
  <% end %>

  <div class='justify-self-end flex items-center gap-4'>
    <% if authenticated? %>
      <div class='ml-6'
           data-controller='job-count'
           data-job-count-schema-name-value='<%= current_campaign&.schema_name %>'>
        <span class='inline-flex items-center gap-1 text-fg cursor-default'
              data-job-count-target='container'
              title='Background tasks'
              hidden>
          <i class='fa-regular fa-spinner-third fa-spin text-xs'></i>
          <span class='text-xs' data-job-count-target='count'>0</span>
        </span>
      </div>

      <% if current_campaign %>
        <div  data-tour-step="nav-campaign" class='relative' data-controller='dropdown'>
          <button data-action='dropdown#toggle'
                  class='inline-flex items-center gap-1 text-link hover:text-highlight cursor-pointer bg-transparent border-0 p-0 font-medium'>
            Campaign
            <i class='fa-regular fa-chevron-down text-xs'></i>
          </button>

          <div data-dropdown-target='menu'
               class='hidden absolute right-0 mt-2 w-44 rounded-lg border border-outline bg-dropdown shadow-xl z-50'>
            <%= link_to campaign_settings_path,
                        class: 'flex items-center px-4 py-2 text-sm text-link hover:bg-dropdown-hover hover:text-highlight no-underline rounded-t-lg' do %>
              <i class='fa-regular fa-planet-ringed mr-2 w-4 text-center'></i>
              Settings
            <% end %>

            <%= link_to ships_path,
                        class: 'flex items-center px-4 py-2 text-sm text-link hover:bg-dropdown-hover hover:text-highlight no-underline' do %>
              <i class='fa-regular fa-rocket mr-2 w-4 text-center'></i>
              Ships
            <% end %>

            <%= link_to data_cores_path,
                        class: 'flex items-center px-4 py-2 text-sm text-link hover:bg-dropdown-hover hover:text-highlight no-underline rounded-b-lg' do %>
              <i class='fa-regular fa-database mr-2 w-4 text-center'></i>
              Data Cores
            <% end %>
          </div>
        </div>
      <% end %>

      <div  data-tour-step="nav-theme" class='relative' data-controller='dropdown theme'>
        <button type='button'
                data-action='dropdown#toggle'
                class='inline-flex items-center text-link hover:text-highlight cursor-pointer bg-transparent border-0 p-0'
                title='Change theme'
                aria-label='Change theme'>
          <i class='fa-regular fa-swatchbook'></i>
        </button>

        <div data-dropdown-target='menu'
             class='hidden absolute right-0 mt-2 w-44 rounded-lg border border-outline bg-dropdown shadow-xl z-50'>
          <% ApplicationHelper::THEMES.each_with_index do |(theme, info), index| %>
            <button type='button'
                    data-action='theme#set'
                    data-theme-value='<%= theme %>'
                    class='w-full flex items-center justify-between px-4 py-2 text-sm text-link hover:bg-dropdown-hover hover:text-highlight <%= 'rounded-t-lg' if index.zero? %> <%= 'rounded-b-lg' if index == ApplicationHelper::THEMES.size - 1 %>'>
              <span><%= info[:label] %></span>
              <% if current_theme == theme %>
                <i class='fa-regular fa-check text-xs text-highlight'></i>
              <% end %>
            </button>
          <% end %>
        </div>
      </div>

      <%= button_to 'Sign out',
                    session_path,
                    method: :delete,
                    class: 'text-link hover:text-highlight hover:underline hover:underline-offset-2 cursor-pointer bg-transparent border-0 p-0 font-medium' %>
    <% else %>
      <%= link_to 'Sign in',
                  new_session_path,
                  class: 'text-link no-underline hover:text-highlight hover:underline hover:underline-offset-2' %>
    <% end %>

    <%= link_to (content_for?(:help_path) ? yield(:help_path) : contextual_help_path),
                class: 'text-link no-underline hover:text-highlight hover:underline hover:underline-offset-2',
                title: 'Open contextual help' do %>
      <i class='fa-regular fa-square-info'></i>
    <% end %>
  </div>
</header>
