<header id="navbar" class="fixed top-0 inset-x-0 z-40 max-w-none px-4 py-2 flex items-center justify-between text-sm leading-tight bg-slate-950/95 backdrop-blur border-b border-slate-800/60">
  <%= link_to (current_campaign&.name || 'My Traveller Universe'), root_path, class: 'font-bold mr-6 text-deepnight-orange no-underline hover:underline hover:underline-offset-2' %>

  <% if authenticated? %>
  <div class="flex items-center gap-6 flex-1 min-w-0">
    <% if current_campaign %>
    <div class="relative w-48 shrink-0"
         data-controller="global-search"
         data-global-search-search-url-value="<%= search_path %>">
      <input type="text"
             placeholder="Search&hellip;"
             autocomplete="off"
             data-global-search-target="input"
             data-action="input->global-search#search focus->global-search#inputFocused blur->global-search#inputBlurred"
             class="w-full bg-slate-900/60 border border-slate-700/60 rounded-lg px-3 py-1.5 pr-8 text-sm text-slate-200 placeholder-slate-500
                    focus:outline-none focus:border-deepnight-orange/50 focus:ring-1 focus:ring-deepnight-orange/30 transition">
      <kbd data-global-search-target="hint"
           class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-[10px] text-slate-500 border border-slate-600 rounded px-1">/</kbd>
      <div data-global-search-target="dropdown"
           class="hidden absolute top-full left-0 right-0 mt-1 z-50
                  bg-slate-900 border border-slate-700/60 rounded-lg shadow-xl overflow-hidden">
        <ul data-global-search-target="list"></ul>
      </div>
    </div>
    <% end %>
    <nav>
      <ul class="flex items-center gap-6 font-medium">
        <% if current_campaign %>
        <li>
          <%= link_to "Astrogation", sectors_path, class: "hover:text-traveller-red hover:underline hover:underline-offset-2" %>
        </li>
        <li>
          <%= link_to "Jumps", jump_logs_path, class: "hover:text-traveller-red hover:underline hover:underline-offset-2" %>
        </li>
        <% end %>
        <% if current_campaign %>
        <li>
          <%= link_to "Starmap", campaign_starmap_path, class: "hover:text-traveller-red hover:underline hover:underline-offset-2", target: "_blank", rel: "noopener" %>
        </li>
        <% end %>
        <li>
          <%= link_to "Reference Manual", "https://radiofreewaba.net/traveller/webindex.html", target: "_blank", rel: "noopener", class: "hover:text-traveller-red hover:underline hover:underline-offset-2" %>
        </li>
        <li>
          <%= link_to "Imperial Encyclopedia", "https://wiki.travellerrpg.com", target: "_blank", rel: "noopener", class: "hover:text-traveller-red hover:underline hover:underline-offset-2" %>
        </li>
        <li>
          <%= link_to "Charted Space", "https://travellermap.com", target: "_blank", rel: "noopener", class: "hover:text-traveller-red hover:underline hover:underline-offset-2" %>
        </li>
      </ul>
    </nav>
  </div>
  <% end %>

  <div class="justify-self-end flex items-center gap-4">
    <div class="ml-6"
         data-controller="job-count"
         data-job-count-schema-name-value="<%= current_campaign&.schema_name %>">
      <span class="inline-flex items-center gap-1 text-slate-300 cursor-default"
            data-job-count-target="container"
            title="Background tasks"
            hidden>
        <i class="fa-regular fa-spinner-third fa-spin text-xs"></i>
        <span class="text-xs" data-job-count-target="count">0</span>
      </span>
    </div>
    <% if authenticated? %>
      <% if current_campaign %>
      <div class='relative'
           data-controller='dropdown'>
        <button data-action='dropdown#toggle'
                class='inline-flex items-center gap-1 text-slate-200 hover:text-traveller-red cursor-pointer bg-transparent border-0 p-0 font-medium'>
          Campaign
          <i class='fa-regular fa-chevron-down text-xs'></i>
        </button>
        <div data-dropdown-target='menu'
             class='hidden absolute right-0 mt-2 w-44 rounded-lg border border-slate-700/60 bg-slate-900 shadow-xl z-50'>
          <%= link_to campaign_settings_path,
                      class: 'flex items-center px-4 py-2 text-sm text-slate-200 hover:bg-slate-800 hover:text-traveller-red no-underline rounded-t-lg' do %>
            <i class='fa-regular fa-planet-ringed mr-2 w-4 text-center'></i>
            Settings
          <% end %>
          <%= link_to ships_path,
                      class: 'flex items-center px-4 py-2 text-sm text-slate-200 hover:bg-slate-800 hover:text-traveller-red no-underline' do %>
            <i class='fa-regular fa-rocket mr-2 w-4 text-center'></i>
            Ships
          <% end %>
          <%= link_to data_cores_path,
                      class: 'flex items-center px-4 py-2 text-sm text-slate-200 hover:bg-slate-800 hover:text-traveller-red no-underline rounded-b-lg' do %>
            <i class='fa-regular fa-database mr-2 w-4 text-center'></i>
            Data Cores
          <% end %>
        </div>
      </div>
      <% end %>
        <%= button_to 'Sign out', session_path, method: :delete, class: 'hover:text-traveller-red hover:underline hover:underline-offset-2 cursor-pointer bg-transparent border-0 p-0 font-medium' %>
      <% else %>
      <%= link_to 'Sign in', new_session_path, class: 'no-underline hover:text-traveller-red hover:underline hover:underline-offset-2' %>
    <% end %>
    <%= link_to (content_for?(:help_path) ? yield(:help_path) : contextual_help_path),
                class: 'text-slate-200 no-underline hover:text-traveller-red hover:underline hover:underline-offset-2' do %>
      <i class="fa-regular fa-square-info"></i>
    <% end %>
  </div>
</header>
