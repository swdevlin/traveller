<header id="navbar" class="max-w-none px-4 py-2 flex items-center justify-between text-sm leading-tight">
  <div class="font-bold mr-6 text-deepnight-orange">Deepnight Revelation</div>
  <nav>
    <ul class="flex items-center gap-6 font-medium">
      <li>
        <%= link_to "Astrogation", sectors_path, class: "hover:text-traveller-red hover:underline hover:underline-offset-2" %>
      </li>
      <li>
        <%= link_to "Reference Manual", "https://radiofreewaba.net/traveller/webindex.html", target: "_blank", rel: "noopener", class: "hover:text-traveller-red hover:underline hover:underline-offset-2" %>
      </li>
      <li>
        <%= link_to "Imperial Encyclopedia", "https://wiki.travellerrpg.com", target: "_blank", rel: "noopener", class: "hover:text-traveller-red hover:underline hover:underline-offset-2" %>
      </li>
      <li>
        <%= link_to "Charted Space", "https://travellermap.com", target: "_blank", rel: "noopener", class: "hover:text-traveller-red hover:underline hover:underline-offset-2" %>
      </li>
    </ul>
  </nav>

  <div class="flex-1 mx-6 max-w-sm relative"
       data-controller="global-search"
       data-global-search-search-url-value="<%= search_path %>">
    <input type="text"
           placeholder="Search systems, sectors&hellip;"
           autocomplete="off"
           data-global-search-target="input"
           data-action="input->global-search#search"
           class="w-full bg-slate-900/60 border border-slate-700/60 rounded-lg px-3 py-1.5 text-sm text-slate-200 placeholder-slate-500
                  focus:outline-none focus:border-deepnight-orange/50 focus:ring-1 focus:ring-deepnight-orange/30 transition">
    <div data-global-search-target="dropdown"
         class="hidden absolute top-full left-0 right-0 mt-1 z-50
                bg-slate-900 border border-slate-700/60 rounded-lg shadow-xl overflow-hidden">
      <ul data-global-search-target="list"></ul>
    </div>
  </div>

  <div class="justify-self-end flex items-center gap-4">
    <div class="ml-6"
         data-controller="job-count">
      <span class="inline-flex items-center gap-1 text-slate-300 cursor-default"
            data-job-count-target="container"
            title="Background tasks"
            hidden>
        <i class="fa-regular fa-spinner-third fa-spin text-xs"></i>
        <span class="text-xs" data-job-count-target="count">0</span>
      </span>
    </div>
    <%= link_to settings_path,
                          class: 'inline-flex items-center gap-2 text-slate-200 hover:text-traveller-red hover:underline hover:underline-offset-2' do %>
      <span>Settings</span>
    <% end %>
    <%= link_to (content_for?(:help_path) ? yield(:help_path) : help_path),
                class: 'text-slate-200 no-underline hover:text-traveller-red hover:underline hover:underline-offset-2' do %>
      <i class="fa-regular fa-square-info"></i>
    <% end %>
  </div>
</header>
