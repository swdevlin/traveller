<% atmosphere = stellar_object.atmosphere %>
<% atmosphere_code = atmosphere&.code %>
<% atmosphere_tainted = atmosphere&.tainted? %>
<% population = stellar_object.population %>
<% population_code = population&.dig('code') %>
<% census_population = population&.dig('censusPopulation') %>
<% government = stellar_object.government ? Government.find_by(code: stellar_object.government.code) : nil %>
<% law_level = stellar_object.law_level ? LawLevel.find_by(code: stellar_object.law_level.code) : nil %>
<% tech_level_record = stellar_object.tech_level_code.present? ? TechLevel.find_by(code: stellar_object.tech_level_code) : nil %>

<%= render 'application/subsection', title: local_assigns.fetch(:title, 'Planetary Profile') %>

<div class="grid grid-cols-2 gap-3">
  <%= render 'application/data_block', label: 'UWP', value: stellar_object.uwp, value_style: :mono %>

  <% if stellar_object.starport_code.present? %>
    <% starport_code = stellar_object.starport_code %>
    <%= render 'application/data_block',
               label: 'Starport',
               value: safe_join([tag.span(starport_code, class: 'identifier-sm'), starport_summary(starport_code)].compact, ' '),
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    <%= render 'application/data_block', label: 'Berthing Cost', value: format_credits(stellar_object.berthing_cost) %>
    <%= render 'application/data_block', label: 'Fuel Cost', value: starport_fuel_cost_display(stellar_object) %>
  <% end %>

  <%= render 'application/data_block',
             label: 'Gravity',
             value: number_with_precision(stellar_object.gravity, precision: 2, strip_insignificant_zeros: true),
             suffix: 'g' %>

  <%= render 'application/data_block',
             label: 'Temperature',
             value: format_temperature_celsius(stellar_object.temperature),
             suffix: '°C' %>

  <% survival_requirement = atmosphere_survival_requirement(atmosphere_code, tainted: atmosphere_tainted) %>
  <% if atmosphere&.composition.present? %>
    <%# Own row so the composition always sits to the left of the survival requirement %>
    <div class='col-span-2 grid grid-cols-2 gap-3'>
      <%= render 'application/data_block', label: 'Atmosphere', value: atmosphere.composition %>
      <%= render 'application/data_block', label: 'Survival Req.', value: survival_requirement %>
    </div>
  <% else %>
    <%= render 'application/data_block', label: 'Survival Req.', value: survival_requirement %>
  <% end %>

  <% if stellar_object.hydrographics_liquid.present? %>
    <%= render 'application/data_block', label: 'Hydrographics Liquid', value: stellar_object.hydrographics_liquid %>
  <% end %>

  <% if population_code.present? %>
    <%= render 'application/data_block',
               label: 'Population',
               value: safe_join([tag.span(HexDigit.hex_digit(population_code.to_i), class: 'identifier-sm'), (population_code.to_i > 0 ? population_display(population_code, census_population) : nil)].compact, ' ') %>
  <% end %>

  <% no_government = stellar_object.no_government? %>
  <% no_law_level = stellar_object.no_law_level? %>
  <% no_tech_level = stellar_object.no_tech_level? %>

  <% if government %>
    <%= render 'application/data_block',
               label: 'Government',
               value: no_government ? '—' : safe_join([tag.span(HexDigit.hex_digit(government.code), class: 'identifier-sm'), government.government_type], ' '),
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
  <% end %>

  <% if law_level %>
    <%= render 'application/data_block',
               label: 'Law Level',
               value: no_law_level ? '—' : safe_join([tag.span(HexDigit.hex_digit(law_level.code), class: 'identifier-sm'), law_level.weapons], ' '),
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
  <% end %>

  <% if tech_level_record %>
    <div class="<%= no_tech_level ? '' : 'col-span-2' %>">
      <%= render 'application/data_block',
                 label: 'Tech Level',
                 value: no_tech_level ? '—' : safe_join([tag.span(HexDigit.hex_digit(tech_level_record.code), class: 'identifier-sm'), "#{tech_level_record.descriptor}; #{tech_level_record.short_description}"].compact, ' '),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    </div>
  <% end %>

  <%= render 'sophonts/native', stellar_object: stellar_object %>
  <%= render 'sophonts/extinct', stellar_object: stellar_object if stellar_object.extinct_sophont %>
  <%= render 'stellar_objects/reference_link_block', stellar_object: stellar_object %>
</div>

<% if local_assigns.fetch(:show_tags, false) && stellar_object.tags.any? %>
  <div class='mt-3'>
    <%= render 'application/tags', record: stellar_object %>
  </div>
<% end %>

<% unless local_assigns.fetch(:hide_transit_times, false) %>
  <%= render 'stellar_objects/jump_shadow_times', stellar_object: stellar_object, times_only: true %>
<% end %>
