<% atmosphere = stellar_object.atmosphere %>
<% atmosphere_code = atmosphere&.dig('code') %>
<% atmosphere_tainted = atmosphere&.dig('taint', 'code').present? %>
<% population = stellar_object.population %>
<% population_code = population&.dig('code') %>
<% government = stellar_object.government_code.present? ? Government.find_by(code: stellar_object.government_code) : nil %>
<% law_level = stellar_object.law_level_code.present? ? LawLevel.find_by(code: stellar_object.law_level_code) : nil %>
<% tech_level_record = stellar_object.tech_level_code.present? ? TechLevel.find_by(code: stellar_object.tech_level_code) : nil %>
<% sophont_status = if stellar_object.extinct_sophont then 'Extinct' elsif stellar_object.native_sophont then 'Extant' else 'None' end %>

<%= render 'application/subsection', title: 'Planetary Profile' %>

<div class="grid grid-cols-2 gap-3">
  <%= render 'application/data_block', label: 'UWP', value: stellar_object.uwp, value_style: :mono %>

  <% if stellar_object.starport_code.present? %>
    <% starport_code = stellar_object.starport_code %>
    <%= render 'application/data_block',
               label: 'Starport',
               value: safe_join([tag.span(starport_code, class: 'identifier-sm'), starport_summary(starport_code)].compact, ' '),
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
  <% end %>

  <%= render 'application/data_block',
             label: 'Gravity',
             value: number_with_precision(stellar_object.gravity, precision: 2, strip_insignificant_zeros: true),
             suffix: 'g' %>

  <%= render 'application/data_block',
             label: 'Temperature',
             value: format_temperature_celsius(stellar_object.temperature),
             suffix: '°C' %>

  <%= render 'application/data_block',
             label: 'Survival Req.',
             value: atmosphere_survival_requirement(atmosphere_code, tainted: atmosphere_tainted) %>

  <% if population_code.present? %>
    <%= render 'application/data_block',
               label: 'Population',
               value: safe_join([tag.span(HexDigit.hex_digit(population_code.to_i), class: 'identifier-sm'), (population_code.to_i > 0 ? population_range(population_code) : nil)].compact, ' ') %>
  <% end %>

  <% if government %>
    <%= render 'application/data_block',
               label: 'Government',
               value: safe_join([tag.span(HexDigit.hex_digit(government.code), class: 'identifier-sm'), government.government_type], ' '),
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
  <% end %>

  <% if law_level %>
    <%= render 'application/data_block',
               label: 'Law Level',
               value: safe_join([tag.span(HexDigit.hex_digit(law_level.code), class: 'identifier-sm'), law_level.weapons], ' '),
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
  <% end %>

  <% if tech_level_record %>
    <% has_population = population_code.present? && population_code.to_i > 0 %>
    <div class="<%= has_population ? 'col-span-2' : '' %>">
      <%= render 'application/data_block',
                 label: 'Tech Level',
                 value: safe_join([tag.span(HexDigit.hex_digit(tech_level_record.code), class: 'identifier-sm'), has_population ? "#{tech_level_record.descriptor}; #{tech_level_record.short_description}" : nil].compact, ' '),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    </div>
  <% end %>

  <%= render 'application/data_block', label: 'Native Sophont', value: sophont_status %>
</div>

<%= render 'stellar_objects/jump_shadow_times', stellar_object: stellar_object, times_only: true %>
