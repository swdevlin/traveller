<% population_code = population&.dig('code') %>
<% concentration_rating = population&.dig('concentrationRating') %>
<% urbanization_percentage = population&.dig('urbanizationPercentage') %>
<% major_cities = population&.dig('majorCities') %>
<% if population_code.present? %>
  <%= render 'application/data_block',
             label: 'Population',
             value: safe_join([tag.span(HexDigit.hex_digit(population_code), class: 'identifier-sm'), population_range(population_code)].compact, ' ') %>
  <% if concentration_rating.present? %>
    <%= render 'application/data_block',
               label: 'Concentration',
               value: safe_join([tag.span(concentration_rating, class: 'identifier-sm'), concentration_rating_description(concentration_rating)].compact, ' ') %>
  <% end %>
  <% if urbanization_percentage.present? %>
    <%= render 'application/data_block', label: 'Urbanisation', value: "#{urbanization_percentage}%" %>
  <% end %>
  <% if major_cities.present? %>
    <%= render 'application/data_block', label: 'Major Cities', value: major_cities %>
  <% end %>
<% end %>
