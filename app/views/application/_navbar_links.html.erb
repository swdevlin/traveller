<% if current_campaign %>
  <li data-tour-step="nav-jumps"><%= link_to 'Jumps', jump_logs_path, class: 'text-nav-fg hover:text-nav-hover hover:underline hover:underline-offset-2' %></li>
  <li data-tour-step="nav-route">
    <%= link_to 'Route', new_route_plan_path(from_id: @route_from_system&.id),
                class: 'text-nav-fg hover:text-nav-hover hover:underline hover:underline-offset-2' %>
  </li>
<% end %>

<li data-tour-step="nav-resources" class='relative' data-controller='dropdown'>
  <button data-action='dropdown#toggle'
          class='inline-flex items-center gap-1 text-nav-fg hover:text-nav-hover cursor-pointer bg-transparent border-0 p-0 font-medium'>
    Resources
    <i class='fa-regular fa-chevron-down text-xs'></i>
  </button>

  <div data-dropdown-target='menu'
       class='hidden absolute left-0 mt-2 w-48 rounded-lg border border-outline bg-dropdown shadow-xl z-50'>
    <% if current_campaign %>
      <%= link_to 'Reference', rulebook_search_path,
                  class: 'flex items-center px-4 py-2 text-sm text-nav-fg hover:bg-dropdown-hover hover:text-nav-hover no-underline first:rounded-t-lg' %>
    <% end %>

    <%= link_to 'https://wiki.travellerrpg.com', target: '_blank', rel: 'noopener',
                class: 'flex items-center justify-between px-4 py-2 text-sm text-nav-fg hover:bg-dropdown-hover hover:text-nav-hover no-underline first:rounded-t-lg' do %>
      Encyclopedia
      <i class='fa-regular fa-arrow-up-right-from-square text-xs text-fg-muted'></i>
    <% end %>

    <%= link_to 'https://travellermap.com', target: '_blank', rel: 'noopener',
                class: 'flex items-center justify-between px-4 py-2 text-sm text-nav-fg hover:bg-dropdown-hover hover:text-nav-hover no-underline last:rounded-b-lg' do %>
      Charted Space
      <i class='fa-regular fa-arrow-up-right-from-square text-xs text-fg-muted'></i>
    <% end %>
  </div>
</li>
