<div class="w-full">
  <div class="page-shell">
    <div class="page-header">
      <div>
        <% if content_for?(:page_kicker) %>
          <div class="page-kicker">
            <%= yield :page_kicker %>
          </div>
        <% end %>

        <div class="page-title">
          <%= yield :page_title %>
        </div>
      </div>

      <div class="page-actions">
        <%= yield :page_actions if content_for?(:page_actions) %>
      </div>
    </div>

    <div class="page-body">
      <div class="page-main">
        <%= yield %>
      </div>
    </div>
  </div>
</div>
