<%# locals: form:, attribute:, checked:, label: nil, checked_value: '1', unchecked_value: '0', checkbox_data: {} %>
<%
  label_text       = local_assigns.fetch(:label, nil)
  checked_value    = local_assigns.fetch(:checked_value, '1')
  unchecked_value  = local_assigns.fetch(:unchecked_value, '0')
  extra_data       = local_assigns.fetch(:checkbox_data, {})
  hint_text        = local_assigns.fetch(:hint, nil)
  btn_class        = checked ? 'bg-toggle-on' : 'bg-toggle-off'
  knob_class       = checked ? 'translate-x-5 bg-toggle-knob-on' : 'translate-x-0 bg-toggle-knob-off'
%>
<% toggle_html = capture do %>
  <div data-controller='boolean-toggle'>
    <%= form.check_box attribute,
          { checked: checked,
            class: 'sr-only',
            data: { boolean_toggle_target: 'checkbox' }.merge(extra_data) },
          checked_value, unchecked_value %>
    <button type='button'
            role='switch'
            aria-checked='<%= checked %>'
            data-action='boolean-toggle#toggle'
            data-boolean-toggle-target='button'
            class='relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none <%= btn_class %>'>
      <span data-boolean-toggle-target='indicator'
            class='pointer-events-none inline-block h-5 w-5 transform rounded-full shadow ring-0 transition duration-200 ease-in-out <%= knob_class %>'></span>
    </button>
  </div>
<% end %>

<% if label_text %>
  <div class='flex items-center gap-3 py-2'>
    <%= toggle_html %>
    <span class='edit-label'><%= label_text %></span>
  </div>
  <% if hint_text %>
    <p class='text-xs text-fg-muted mt-1'><%= hint_text %></p>
  <% end %>
<% else %>
  <%= toggle_html %>
<% end %>
