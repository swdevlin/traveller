<%= render 'application/subsection', title: 'Biological Data' %>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
  <% if stellar_object.habitability_rating.present? %>
    <%= render 'application/data_block',
               label: 'Habitability Rating',
               value: safe_join([tag.span(stellar_object.habitability_rating, class: 'identifier-sm'), habitability_rating_description(stellar_object.habitability_rating)], ' '),
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
  <% end %>
  <%= render 'application/data_block', label: 'Biomass Rating', value: stellar_object.biomass_rating %>
  <% if stellar_object.biodiversity_rating.present? %>
    <%= render 'application/data_block',
               label: 'Biodiversity Rating',
               value: safe_join([tag.span(HexDigit.hex_digit(stellar_object.biodiversity_rating), class: 'identifier-sm'), biodiversity_description(stellar_object.biodiversity_rating)], ' '),
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
  <% end %>
  <% if stellar_object.biocomplexity_rating.present? %>
    <%= render 'application/data_block',
               label: 'Biocomplexity Rating',
               value: safe_join([tag.span(stellar_object.biocomplexity_rating, class: 'identifier-sm'), biocomplexity_description(stellar_object.biocomplexity_rating)], ' '),
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
  <% end %>
  <% if stellar_object.resource_rating.present? %>
    <%= render 'application/data_block',
               label: 'Resource Rating',
               value: safe_join([tag.span(HexDigit.hex_digit(stellar_object.resource_rating), class: 'identifier-sm'), resource_rating_description(stellar_object.resource_rating)], ' '),
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
  <% end %>
</div>
