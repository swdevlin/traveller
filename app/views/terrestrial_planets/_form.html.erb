<% star = stellar_object.orbiting_star %>

<%= form_with(model: stellar_object, scope: :stellar_object, url: stellar_object_path(stellar_object), class: 'contents') do |form| %>
  <div class='space-y-2 pb-10'>
    <%= render 'application/form_errors', errors: stellar_object.errors.where(:base) %>

    <%= render 'application/edit_field', form: form, attribute: :name do %>
      <%= form.text_field :name, class: 'edit-base w-100' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :starport_code, field_label: 'Starport' do %>
      <%= form.select :starport_code,
                      options_for_select(
                        StellarObjectsHelper::STARPORT_CODES.map { |k, v| ["#{k} – #{v}", k] },
                        stellar_object.starport_code
                      ),
                      { include_blank: 'Select starport' },
                      class: 'edit-base' %>
    <% end %>

    <% if star %>
      <div class='flex items-center gap-2 pt-2'>
        <div class='text-xs uppercase tracking-[0.22em] text-deepnight-orange'>Orbital Data</div>
        <div class='h-px flex-1 bg-slate-700/70'></div>
      </div>

      <%= render 'application/edit_field', form: form, attribute: :orbit, required: true do %>
        <%= form.number_field :orbit,
                              value: format_precision(stellar_object.orbit, precision: 5),
                              class: 'edit-base sm:w-28 w-24',
                              step: 'any',
                              min: star.minimum_orbit %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :period do %>
        <%= form.number_field :period,
                              value: format_precision(stellar_object.period, precision: 5),
                              class: 'edit-base sm:w-28 w-24',
                              step: 'any' %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :retrograde do %>
        <%= form.check_box :retrograde,
                           { checked: stellar_object.retrograde, class: 'rounded bg-slate-950 border-slate-700' },
                           'true', 'false' %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :rotation do %>
        <%= form.number_field :rotation,
                              value: format_precision(stellar_object.rotation, precision: 5),
                              class: 'edit-base sm:w-28 w-24',
                              step: 'any' %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :inclination do %>
        <%= form.number_field :inclination,
                              value: format_precision(stellar_object.inclination, precision: 5),
                              class: 'edit-base sm:w-28 w-24',
                              step: 'any' %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :eccentricity do %>
        <%= form.number_field :eccentricity,
                              value: format_precision(stellar_object.eccentricity, precision: 5),
                              class: 'edit-base sm:w-28 w-24',
                              step: 'any' %>
      <% end %>
    <% end %>

    <div class='flex items-center gap-2 pt-2'>
      <div class='text-xs uppercase tracking-[0.22em] text-deepnight-orange'>Physical Data</div>
      <div class='h-px flex-1 bg-slate-700/70'></div>
    </div>

    <div data-controller='planet-size' class='space-y-6'>
      <%= render 'application/edit_field', form: form, attribute: :size_code, field_label: 'Size', required: true do %>
        <%= form.select :size_code,
                        options_for_select(
                          StellarObjectsHelper::SIZE_DESCRIPTIONS.map { |k, v| ["#{HexDigit.hex_digit(k)} – #{v}", k] },
                          stellar_object.size_code
                        ),
                        { include_blank: 'Select size' },
                        class: 'edit-base',
                        data: { planet_size_target: 'size', action: 'planet-size#sizeChanged' } %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :diameter do %>
        <%= form.number_field :diameter,
                              value: format_precision(stellar_object.diameter, precision: 5),
                              class: 'edit-base sm:w-28 w-24',
                              step: 'any',
                              data: { planet_size_target: 'diameter', action: 'planet-size#recalculate' } %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :density do %>
        <%= form.number_field :density,
                              value: format_precision(stellar_object.density, precision: 5),
                              class: 'edit-base sm:w-28 w-24',
                              step: 'any',
                              data: { planet_size_target: 'density', action: 'planet-size#recalculate' } %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :mass, field_label: 'Mass ☉', calculated: true do %>
        <%= form.number_field :mass,
                              value: format_precision(stellar_object.mass, precision: 5),
                              class: 'edit-base sm:w-28 w-24',
                              step: 'any',
                              data: { planet_size_target: 'mass' } %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :gravity, calculated: true do %>
        <%= form.number_field :gravity,
                              value: format_precision(stellar_object.gravity, precision: 5),
                              class: 'edit-base sm:w-28 w-24',
                              step: 'any',
                              data: { planet_size_target: 'gravity' } %>
      <% end %>
    </div>

    <div class='flex items-center gap-2 pt-2'>
      <div class='text-xs uppercase tracking-[0.22em] text-deepnight-orange'>Environmental Data</div>
      <div class='h-px flex-1 bg-slate-700/70'></div>
    </div>

    <%= render 'application/edit_field', form: form, attribute: :temperature do %>
      <%= form.number_field :temperature,
                            value: format_precision(stellar_object.temperature, precision: 5),
                            class: 'edit-base sm:w-28 w-24',
                            step: 'any' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :axial_tilt, field_label: 'Axial Tilt' do %>
      <%= form.number_field :axial_tilt,
                            value: format_precision(stellar_object.axial_tilt, precision: 5),
                            class: 'edit-base sm:w-28 w-24',
                            step: 'any' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :albedo do %>
      <%= form.number_field :albedo,
                            value: format_precision(stellar_object.albedo, precision: 5),
                            class: 'edit-base sm:w-28 w-24',
                            step: 'any' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :greenhouse do %>
      <%= form.number_field :greenhouse,
                            value: format_precision(stellar_object.greenhouse, precision: 5),
                            class: 'edit-base sm:w-28 w-24',
                            step: 'any' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :atmosphere_code, field_label: 'Atmosphere', required: true do %>
      <%= form.select :atmosphere_code,
                      options_for_select(
                        StellarObjectsHelper::ATMOSPHERE_DESCRIPTIONS.map { |k, v| ["#{HexDigit.hex_digit(k)} – #{v}", k] },
                        stellar_object.atmosphere_code
                      ),
                      { include_blank: 'Select atmosphere' },
                      class: 'edit-base' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :atmosphere_composition, field_label: 'Composition' do %>
      <%= form.text_field :atmosphere_composition,
                          value: stellar_object.atmosphere_composition,
                          class: 'edit-base w-full sm:max-w-xl' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :hydrographics_code, field_label: 'Hydrographics', required: true do %>
      <%= form.select :hydrographics_code,
                      options_for_select(
                        StellarObjectsHelper::HYDROGRAPHICS_DESCRIPTIONS.map { |k, v| ["#{HexDigit.hex_digit(k)} – #{v}", k] },
                        stellar_object.hydrographics_code
                      ),
                      { include_blank: 'Select hydrographics' },
                      class: 'edit-base' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :hydrographics_liquid, field_label: 'Liquid' do %>
      <%= form.text_field :hydrographics_liquid,
                          value: stellar_object.hydrographics_liquid,
                          class: 'edit-base w-full sm:max-w-xl' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :hydrographics_distribution, field_label: 'Distribution' do %>
      <%= form.select :hydrographics_distribution,
                      options_for_select(
                        StellarObjectsHelper::HYDROGRAPHICS_DISTRIBUTION_DESCRIPTIONS.map { |k, v| ["#{HexDigit.hex_digit(k)} – #{v}", k] },
                        stellar_object.hydrographics_distribution
                      ),
                      { include_blank: 'Select distribution' },
                      class: 'edit-base' %>
    <% end %>

    <div class='flex items-center gap-2 pt-2'>
      <div class='text-xs uppercase tracking-[0.22em] text-deepnight-orange'>Biological Data</div>
      <div class='h-px flex-1 bg-slate-700/70'></div>
    </div>

    <%= render 'application/edit_field', form: form, attribute: :biomass_rating, field_label: 'Biomass Rating' do %>
      <%= form.number_field :biomass_rating,
                            value: stellar_object.biomass_rating,
                            class: 'edit-base sm:w-28 w-24',
                            step: 1 %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :biodiversity_rating, field_label: 'Biodiversity Rating' do %>
      <%= form.number_field :biodiversity_rating,
                            value: stellar_object.biodiversity_rating,
                            class: 'edit-base sm:w-28 w-24',
                            step: 1 %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :biocomplexity_rating, field_label: 'Biocomplexity Rating' do %>
      <%= form.text_field :biocomplexity_rating,
                          value: stellar_object.biocomplexity_rating,
                          class: 'edit-base w-24' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :resource_rating, field_label: 'Resource Rating' do %>
      <%= form.number_field :resource_rating,
                            value: stellar_object.resource_rating,
                            class: 'edit-base sm:w-28 w-24',
                            step: 1,
                            min: 2,
                            max: 12 %>
    <% end %>

    <div class='flex items-center gap-2 pt-2'>
      <div class='text-xs uppercase tracking-[0.22em] text-deepnight-orange'>Social Data</div>
      <div class='h-px flex-1 bg-slate-700/70'></div>
    </div>

    <%= render 'application/edit_field', form: form, attribute: :population_code, field_label: 'Population' do %>
      <%= form.number_field :population_code,
                            value: stellar_object.population_code,
                            class: 'edit-base sm:w-28 w-24',
                            step: 1,
                            min: 0,
                            max: 12 %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :native_sophont, field_label: 'Native Sophont' do %>
      <%= form.check_box :native_sophont,
                         { checked: stellar_object.native_sophont, class: 'rounded bg-slate-950 border-slate-700' },
                         'true', 'false' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :extinct_sophont, field_label: 'Extinct Sophont' do %>
      <%= form.check_box :extinct_sophont,
                         { checked: stellar_object.extinct_sophont, class: 'rounded bg-slate-950 border-slate-700' },
                         'true', 'false' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :government_code, field_label: 'Government' do %>
      <%= form.select :government_code,
                      options_for_select(
                        Government.order(:code).map { |g| ["#{HexDigit.hex_digit(g.code)} – #{g.government_type}", g.code] },
                        stellar_object.government_code
                      ),
                      { include_blank: 'Select government' },
                      class: 'edit-base' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :law_level_code, field_label: 'Law Level' do %>
      <%= form.select :law_level_code,
                      options_for_select(
                        LawLevel.where.not(weapons: [nil, '']).order(:code).map { |l| ["#{HexDigit.hex_digit(l.code)} – #{l.weapons}", l.code] },
                        stellar_object.law_level_code
                      ),
                      { include_blank: 'Select law level' },
                      class: 'edit-base' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :tech_level_code, field_label: 'Tech Level' do %>
      <%= form.number_field :tech_level_code,
                            value: stellar_object.tech_level_code,
                            class: 'edit-base sm:w-28 w-24',
                            step: 1,
                            min: 0,
                            max: 35 %>
    <% end %>

    <div class='edit-row-notes'>
      <div class='edit-label'>Observations<%= required_icon(stellar_object, :notes) %></div>
      <%= form.text_area :notes, rows: 6, class: 'edit-base mt-2 w-full resize-y' %>
      <%= render 'application/field_error', form: form, attribute: :notes %>
    </div>

    <div class='pt-2 flex flex-col sm:flex-row gap-2'>
      <%= form.submit 'Update core', class: 'w-full sm:w-auto btn btn-primary' %>
      <%= link_to 'Cancel', stellar_object_path(stellar_object), class: 'w-full sm:w-auto btn' %>
    </div>
  </div>
<% end %>