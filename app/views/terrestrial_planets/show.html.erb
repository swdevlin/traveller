<%= content_for :title, @stellar_object.name.presence || @stellar_object.type.underscore.humanize %>
<%= content_for :page_kicker, "IISS Class IV Survey" %>
<%= content_for :page_title, @stellar_object.name.presence || @stellar_object.type.underscore.humanize %>
<%= content_for :iiss_form, '0421D-II.III' %>

<%= content_for :page_buttons do %>
  <%= link_to "Edit", edit_stellar_object_path(@stellar_object), class: "w-full sm:w-auto btn btn-primary" %>
  <%= render 'application/back_button',
             path: stellar_objects_path,
             label: 'Stellar Objects',
             class: 'w-full sm:w-auto' %>
  <%= button_to "Delete",
                stellar_object_path(@stellar_object),
                method: :delete,
                form_class: "w-full sm:w-auto inline-flex m-0",
                class: "w-full sm:w-auto btn btn-danger cursor-pointer",
                data: { turbo_confirm: "Are you sure?" } %>
<% end %>

<%= render 'application/page' do %>
  <%= render @stellar_object %>
<% end %>
