<% allegiance = terrestrial_planet.allegiance %>
<% star = terrestrial_planet.orbiting_star %>
<% star_system = star.star_system %>

<% allegiance_value =
     if allegiance
       safe_join([
                   allegiance.name,
                   content_tag(:span, allegiance.code, class: "identifier")
                 ])
     else
       "None"
     end
%>

<div id="<%= dom_id terrestrial_planet %>" class="space-y-6">
  <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-5">
    <%= render 'application/data_block', label: 'UWP', value: terrestrial_planet.uwp, value_style: :mono %>

    <% if star %>
      <%= render 'application/data_block',
                 label: 'Orbiting',
                 value: link_to(star.display_name,
                                star_path(star),
                                class: 'hover:underline underline-offset-4') %>
    <% end %>
    <%= render 'application/data_block',
               label: 'Star System',
               value: link_to(star_system.display_name,
                              star_system_path(star_system),
                              class: 'hover:underline underline-offset-4') %>

    <%= render 'application/data_block',
               label: 'Subsector',
               value: link_to(star_system.parsec.subsector.name,
                              subsector_path(star_system.parsec.subsector),
                              class: 'hover:underline underline-offset-4') %>

    <%= render 'application/data_block',
               label: 'Sector',
               value: link_to(
                 star_system.parsec.sector.name,
                 sector_path(star_system.parsec.sector),
                 class: 'hover:underline underline-offset-4'
               ),
               value_wrap_class: 'flex flex-wrap items-center gap-2',
               suffix: tag.span(star_system.parsec.hex_code, class: 'identifier') %>

    <%= render 'application/data_block',
               label: 'Allegiance',
               value: allegiance_value %>
  </div>

  <div class="flex items-center gap-4 pt-2">
    <div class="text-xs uppercase tracking-[0.22em] text-deepnight-orange">
      Orbital Data
    </div>
    <div class="h-px flex-1 bg-slate-700/70"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
    <%= render 'application/data_block', label: 'Orbit', value: number_with_precision(terrestrial_planet.orbit, precision: 2, strip_insignificant_zeros: true) %>
    <%= render 'application/data_block', label: 'AU', value: number_with_precision(terrestrial_planet.au, precision: 2, strip_insignificant_zeros: true) %>
    <%= render 'application/data_block', label: 'Period', value: format_period(terrestrial_planet.period) %>
    <%= render 'application/data_block', label: 'Effective HZCO Deviation', value: number_with_precision(terrestrial_planet.effective_hzco_deviation, precision: 2, strip_insignificant_zeros: true) %>
    <%= render 'application/data_block', label: 'Retrograde', value: terrestrial_planet.retrograde ? 'Yes' : 'No' %>
    <%= render 'application/data_block', label: 'Inclination', value: number_with_precision(terrestrial_planet.inclination, precision: 2, strip_insignificant_zeros: true), suffix: '°' %>
    <%= render 'application/data_block', label: 'Eccentricity', value: number_with_precision(terrestrial_planet.eccentricity, precision: 2, strip_insignificant_zeros: true) %>
  </div>

  <%= render 'stellar_objects/jump_shadow_times', stellar_object: terrestrial_planet %>

  <div class="flex items-center gap-4">
    <div class="text-xs uppercase tracking-[0.22em] text-deepnight-orange">
      Physical Data
    </div>
    <div class="h-px flex-1 bg-slate-700/70"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
    <%= render 'application/data_block', label: 'Diameter', value: number_with_delimiter(terrestrial_planet.diameter), suffix: 'km' %>
    <%= render 'application/data_block', label: 'Mass', value: number_with_precision(terrestrial_planet.mass, precision: 2, strip_insignificant_zeros: true), suffix: '☉' %>
    <%= render 'application/data_block', label: 'Gravity', value: number_with_precision(terrestrial_planet.gravity, precision: 2, strip_insignificant_zeros: true), suffix: 'g' %>
    <%= render 'application/data_block', label: 'Density', value: number_with_precision(terrestrial_planet.density, precision: 2, strip_insignificant_zeros: true), suffix: '☉' %>
  </div>

  <div class="flex items-center gap-4">
    <div class="text-xs uppercase tracking-[0.22em] text-deepnight-orange">
      Environmental Data
    </div>
    <div class="h-px flex-1 bg-slate-700/70"></div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
    <%= render 'application/data_block', label: 'Temperature', value: format_temperature_celsius(terrestrial_planet.temperature), suffix: '°C' %>
    <%= render 'application/data_block', label: 'Rotation', value: number_with_precision(terrestrial_planet.rotation, precision: 2, strip_insignificant_zeros: true), suffix: 'hours' %>
    <%= render 'application/data_block', label: 'Axial Tilt', value: number_with_precision(terrestrial_planet.axial_tilt, precision: 2, strip_insignificant_zeros: true), suffix: '°' %>
    <%= render 'application/data_block', label: 'Albedo', value: number_with_precision(terrestrial_planet.albedo, precision: 2, strip_insignificant_zeros: true) %>
    <%= render 'application/data_block', label: 'Greenhouse', value: number_with_precision(terrestrial_planet.greenhouse, precision: 2, strip_insignificant_zeros: true) %>
  </div>

  <div class="flex items-center gap-4">
    <div class="text-xs uppercase tracking-[0.22em] text-deepnight-orange">
      Biological Data
    </div>
    <div class="h-px flex-1 bg-slate-700/70"></div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
    <%= render 'application/data_block', label: 'Native Sophont', value: terrestrial_planet.native_sophont ? 'Yes' : 'No' %>
    <%= render 'application/data_block', label: 'Extinct Sophont', value: terrestrial_planet.extinct_sophont ? 'Yes' : 'No' %>
    <%= render 'application/data_block', label: 'Biomass Rating', value: terrestrial_planet.biomass_rating %>
    <% if terrestrial_planet.biodiversity_rating.present? %>
      <%= render 'application/data_block',
                 label: 'Biodiversity Rating',
                 value: safe_join([tag.span(HexDigit.hex_digit(terrestrial_planet.biodiversity_rating), class: 'identifier-sm'), biodiversity_description(terrestrial_planet.biodiversity_rating)], ' '),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    <% end %>

    <% if terrestrial_planet.biocomplexity_rating.present? %>
      <%= render 'application/data_block',
                 label: 'Biocomplexity Rating',
                 value: safe_join([tag.span(terrestrial_planet.biocomplexity_rating, class: 'identifier-sm'), biocomplexity_description(terrestrial_planet.biocomplexity_rating)], ' '),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    <% end %>
    <% if terrestrial_planet.resource_rating.present? %>
      <%= render 'application/data_block',
                 label: 'Resource Rating',
                 value: safe_join([tag.span(HexDigit.hex_digit(terrestrial_planet.resource_rating), class: 'identifier-sm'), resource_rating_description(terrestrial_planet.resource_rating)], ' '),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    <% end %>
  </div>

  <%= render 'application/observation_block',
             notes: terrestrial_planet.notes %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 border-t border-slate-700 pt-6">
  </div>
</div>
