<div>
  <%= render 'application/data_block',
             label: 'Bases',
             value: star_system.facilities.any? ?
               safe_join(star_system.facilities.order(:code).map { |f|
                 link_to(f.code, facility_path(f), title: f.name, class: 'identifier-sm no-underline hover:no-underline')
               }, ' ') :
               tag.span('None', class: 'text-fg-muted'),
             value_wrap_class: 'flex flex-wrap items-center gap-2',
             suffix: link_to(edit_bases_star_system_path(star_system),
                             data: { turbo_frame: 'modal' },
                             class: 'btn-header') {
               tag.i(class: 'fa-regular fa-pen-to-square')
             } %>
</div>
