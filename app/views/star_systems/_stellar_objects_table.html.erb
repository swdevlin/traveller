<div class="t-card">
  <div class="t-card-header">
    <div class="flex items-center justify-between gap-3">
      <p class="t-card-title">
        Star System
      </p>
    </div>
  </div>

  <div class="t-scroll-x">
    <table class="t-table">
      <thead class="t-thead">
      <tr>
        <th scope="col" class="t-th">
          id
        </th>
        <th scope="col" class="t-th">
          au
        </th>
        <th scope="col" class="t-th">
          name
        </th>
        <th scope="col" class="t-th">
          Orbit #
        </th>
        <th scope="col" class="t-th">
          Eccentricity
        </th>
        <th scope="col" class="t-th">
          Period
        </th>
        <th scope="col" class="t-th">
          SAH/UWP
        </th>
        <th scope="col" class="t-th">
          Sub
        </th>
        <th scope="col" class="t-th">
          notes
        </th>
        <th scope="col" class="t-th">
          Actions
        </th>
      </tr>
      </thead>
      <tbody class="t-tbody">
      <%= render "star_row", star: primary, indent: 0 %>
      </tbody>
    </table>
  </div>
</div>
