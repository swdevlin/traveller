<div class='table-card'>
  <div class='table-banner'>
    <p>Stellar Objects</p>

    <div class='actions'>
      <%# buttons/links will live here %>
    </div>
  </div>

  <div class='table-scroll'>
    <table>
      <thead>
      <tr>
        <th scope='col'>ID</th>
        <% if show_orbit_number? %>
          <th scope='col' class='text-right'>Orbit #</th>
        <% end %>
        <% if show_au? %>
          <th scope='col' class='text-right'>AU</th>
        <% end %>
        <th scope='col'>Name</th>
        <th scope='col' class='text-right'>Period</th>
        <th scope='col'>SAH/UWP</th>
        <th scope='col' class='text-right'>Habitability</th>
        <th scope='col' class='text-right'>Resource</th>
        <th scope='col' class='text-right'>Moons</th>
        <th scope='col'>Notes</th>
        <th scope='col' class='text-right actions-cell'>Actions</th>
      </tr>
      </thead>

      <tbody>
      <%= render 'star_row', star: primary, indent: 0 %>
      </tbody>
    </table>
  </div>
</div>