<tr class="t-tr">
  <td class="t-td-nowrap">
    <span class="t-pill"><%= stellar_object.orbit_sequence %></span>
  </td>

  <td class="t-td">
    <%= number_with_precision(stellar_object.au, precision: 2) %>
  </td>

  <td class="t-td">
    <% if @star_system.main_world.present? && stellar_object == @star_system.main_world %>
      <i class='fa-regular fa-globe mr-2' title='Main world'></i>
    <% end %>
    <%= stellar_object.name %>
  </td>

  <td class="t-td">
    <%= number_with_precision(stellar_object.orbit, precision: 2, strip_insignificant_zeros: true) %>
  </td>

  <td class="t-td">
    <%= number_with_precision(stellar_object.eccentricity, precision: 2, strip_insignificant_zeros: true) %>
  </td>

  <td class="t-td">
    <% if stellar_object.respond_to?(:period) %>
      <%= number_with_precision(stellar_object.period, precision: 2, strip_insignificant_zeros: true) %>
    <% end %>
  </td>

  <td class="t-td">
    <%= link_to stellar_object_path(stellar_object), class: "text-slate-300 hover:text-traveller-red/90" do %>
      <% if stellar_object.is_a?(GasGiant) %>
        <%= stellar_object.code %>
      <% else %>
        <%= stellar_object.uwp %>
      <% end %>
    <% end %>
  </td>

  <td class="t-td">
  </td>

  <td class="t-td">
    <% if stellar_object.is_a?(GasGiant) %>
      <%= stellar_object.type.underscore.humanize %>
    <% elsif stellar_object.is_a?(PlanetoidBelt) %>
      Rating: <%= stellar_object.resource_rating %>
    <% else %>
      <%= temperature_label(stellar_object.temperature) %>
    <% end %>
  </td>

  <td class="t-td-right">
    <div class="t-actions">
      <%= link_to edit_stellar_object_path(stellar_object),
                  class: "text-slate-300 hover:text-traveller-red/90",
                  title: "Edit" do %>
        <i class="fa-solid fa-pen-to-square"></i>
      <% end %>

      <%= button_to stellar_object_path(stellar_object),
                    method: :delete,
                    form_class: "inline",
                    class: "text-slate-300 hover:text-traveller-red/90",
                    title: "Delete",
                    data: { turbo_confirm: "Delete this stellar object?" } do %>
        <i class="fa-solid fa-trash"></i>
      <% end %>
    </div>
  </td>
</tr>
