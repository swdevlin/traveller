<tr class="transition hover:bg-slate-900/80" style="--indent: <%= (local_assigns[:indent] || 0) %>px;">
  <td class="px-4 py-3 whitespace-nowrap align-middle">
    <%= number_with_precision(stellar_object.au, precision: 2) %>
  </td>

  <td class="px-4 py-3 whitespace-nowrap align-middle">
    <%= stellar_object.orbit_sequence %>
  </td>

  <td class="px-4 py-3 whitespace-nowrap align-middle">
    <% if @star_system.main_world.present? && stellar_object == @star_system.main_world %>
      <i class='fa-regular fa-globe mr-2' title='Main world'></i>
    <% end %>
    <%= stellar_object.name %>
  </td>

  <td class="pl-8 pr-4 py-3 whitespace-nowrap align-middle" style="padding-left: calc(1rem + var(--indent));">
    <%= stellar_object.type.underscore.humanize %>
  </td>

  <td class="px-4 py-3 whitespace-nowrap align-middle">
    <% if stellar_object.is_a?(GasGiant) %>
      <%= stellar_object.code %>
    <% else %>
      <%= stellar_object.uwp %>
    <% end %>
  </td>

  <td class="px-2 py-3 whitespace-nowrap align-middle text-right">
    <div class="inline-flex items-center justify-end gap-2">
      <%= link_to edit_stellar_object_path(stellar_object),
                  class: "text-slate-300 hover:text-traveller-red/90",
                  title: "Edit" do %>
        <i class="fa-solid fa-pen-to-square"></i>
      <% end %>

      <%= button_to stellar_object_path(stellar_object),
                    method: :delete,
                    form_class: "inline",
                    class: "text-slate-300 hover:text-traveller-red/90",
                    title: "Delete",
                    data: { turbo_confirm: "Delete this stellar object?" } do %>
        <i class="fa-solid fa-trash"></i>
      <% end %>
    </div>
  </td>
</tr>
