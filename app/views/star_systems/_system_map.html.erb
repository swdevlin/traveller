<% if star_system.stars.any? %>
  <% layout = StarSystemMapLayout.new(star_system) %>
  <div class="subway-map-container">
    <svg xmlns="http://www.w3.org/2000/svg"
         width="100%"
         viewBox="0 0 <%= layout.svg_width %> <%= layout.svg_height %>"
         preserveAspectRatio="xMinYMid meet"
         class="subway-map">
      <%= render partial: 'system_map_inner', formats: [:svg], locals: { layout: layout, linkable: true } %>
    </svg>
  </div>
<% end %>
