<% layout ||= (StarSystemMapLayout.new(star_system, moons: map_moons_mode) if star_system.stars.any?) %>
<% if layout %>
  <div class="subway-map-container">
    <svg xmlns="http://www.w3.org/2000/svg"
         width="<%= layout.svg_width %>"
         viewBox="0 0 <%= layout.svg_width %> <%= layout.svg_height %>"
         preserveAspectRatio="xMinYMid meet"
         class="subway-map">
      <%= render partial: 'star_systems/system_map_inner', formats: [:svg], locals: { layout: layout, linkable: true } %>
    </svg>
  </div>
<% end %>