<tr class="t-tr">
  <td class="t-td">
    <span class="identifier"><%= star.orbit_sequence %></span>
  </td>

  <td class="t-td">
    <%= number_with_precision(star.au, precision: 2) %>
  </td>

  <td class="t-td">
    <%= star.name %> <%= star.spectral_classification %>
  </td>

  <td class="t-td">
    <%= star.orbit %>
  </td>

  <td colspan="5" class="t-td">
  </td>

  <td class="t-td-right">
    <div class="t-actions">
      <%= link_to edit_star_path(star),
                  class: "text-slate-300 hover:text-traveller-red/90",
                  title: "Edit" do %>
        <i class="fa-solid fa-pen-to-square"></i>
      <% end %>

      <%= button_to star_path(star),
                    method: :delete,
                    form_class: "inline",
                    class: "text-slate-300 hover:text-traveller-red/90",
                    title: "Delete",
                    data: { turbo_confirm: "Delete this star?" } do %>
        <i class="fa-solid fa-trash"></i>
      <% end %>
    </div>
  </td>
</tr>

<% if star.companion.present? %>
  <%= render 'star_row', star: star.companion, indent: indent + 8 %>
<% end %>

<% star.orbiting_bodies.each do |ob| %>
  <% if ob.is_a?(Star) %>
    <%= render 'star_row', star: ob, indent: indent + 8 %>
  <% else %>
    <%= render 'stellar_object_row', stellar_object: ob, indent: indent + 8 %>
  <% end %>
<% end %>
