<tr class="t-tr">
  <td class="t-td">
    <span class="t-pill"><%= star.orbit_sequence %></span>
  </td>

  <td class="t-td text-right">
    <%= number_with_precision(star.au, precision: 1)  if star.au > 0 %>
  </td>

  <td class="t-td">
    <%= star.name %>
  </td>

  <td class="t-td text-right">
    <%= number_with_precision(star.orbit, precision: 1) if star.orbit > 0 %>
  </td>

  <td class="t-td text-right">
    <%= number_with_precision(star.eccentricity, precision: 1) if star.eccentricity > 0 %>
  </td>

  <td class="t-td text-right">
    <%= format_period(star.period) if star.period > 0 %>
  </td>

  <td colspan="3" class="t-td">
    <%= link_to star.spectral_classification, star_path(star), class: "hover:text-traveller-red/90" %>
  </td>

  <td class="t-td-right">
    <div class="t-actions">
      <%= link_to edit_star_path(star),
                  class: "text-slate-300 hover:text-traveller-red/90",
                  title: "Edit" do %>
        <i class="fa-solid fa-pen-to-square"></i>
      <% end %>

      <%= button_to star_path(star),
                    method: :delete,
                    form_class: "inline",
                    class: "text-slate-300 hover:text-traveller-red/90",
                    title: "Delete",
                    data: { turbo_confirm: "Delete this star?" } do %>
        <i class="fa-solid fa-trash"></i>
      <% end %>
    </div>
  </td>
</tr>

<% star.orbiting_bodies.each do |ob| %>
  <% if ob.is_a?(Star) %>
    <%= render 'star_row', star: ob, indent: indent + 8 %>
  <% else %>
    <%= render 'stellar_object_row', stellar_object: ob, indent: indent + 8 %>
  <% end %>
<% end %>
