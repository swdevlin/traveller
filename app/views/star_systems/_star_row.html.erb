<tr class="transition hover:bg-slate-900/80" style="--indent: <%= (local_assigns[:indent] || 0) %>px;">
  <td class="px-4 py-3 whitespace-nowrap align-middle">
    <%= number_with_precision(star.au, precision: 2) %>
  </td>

  <td class="px-4 py-3 whitespace-nowrap align-middle">
    <%= star.orbit_sequence %>
  </td>

  <td class="px-4 py-3 whitespace-nowrap align-middle">
    <%= star.name %>
  </td>

  <td class="px-4 py-3 whitespace-nowrap align-middle" style="padding-left: calc(1rem + var(--indent));">
    <%= star.spectral_classification %>
  </td>

  <td class="px-4 py-3 whitespace-nowrap align-middle" style="padding-left: calc(1rem + var(--indent));">
  </td>

  <td class="px-2 py-3 whitespace-nowrap align-middle text-right">
    <div class="inline-flex items-center justify-end gap-2">
      <%= link_to edit_star_path(star),
                  class: "text-slate-300 hover:text-traveller-red/90",
                  title: "Edit" do %>
        <i class="fa-solid fa-pen-to-square"></i>
      <% end %>

      <%= button_to star_path(star),
                    method: :delete,
                    form_class: "inline",
                    class: "text-slate-300 hover:text-traveller-red/90",
                    title: "Delete",
                    data: { turbo_confirm: "Delete this star?" } do %>
        <i class="fa-solid fa-trash"></i>
      <% end %>
    </div>
  </td>
</tr>

<% if star.companion.present? %>
  <%= render 'star_row', star: star.companion, indent: indent + 8 %>
<% end %>

<% star.orbiting_bodies.each do |ob| %>
  <% if ob.is_a?(Star) %>
    <%= render 'star_row', star: ob, indent: indent + 8 %>
  <% else %>
    <%= render 'stellar_object_row', stellar_object: ob, indent: indent + 8 %>
  <% end %>
<% end %>
