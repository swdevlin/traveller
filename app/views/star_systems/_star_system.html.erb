<div id="<%= dom_id star_system %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <%= link_to star_system.parsec.subsector.name, subsector_path(star_system.parsec.subsector) %> subsector
    <strong class="block font-medium mb-1"><%= link_to star_system.parsec.sector.name, subsector_path(star_system.parsec.subsector) %> <%= star_system.parsec.hex_code %></strong>
  </div>
  <div>
    <strong class="block font-medium mb-1">Main world UWP</strong><%= star_system.main_world_uwp %>
  </div>
  <div>
    <strong class="block font-medium mb-1">System</strong>
  </div>
  <%= render "stellar_objects_table", primary: star_system.primary_star %>
  <div>
    <strong class="block font-medium mb-1">Notes</strong>
    <%= star_system.notes %>
  </div>
</div>
