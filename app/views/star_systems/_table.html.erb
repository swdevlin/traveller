<div class='table-card mt-4'>
  <div class='table-banner'>
    <p>Star systems</p>

    <div class='actions'>
      <% if local_assigns[:new_url].present? %>
        <%= link_to new_url, class: 'btn-header' do %>
          <i class='fa-regular fa-plus'></i>
          Add
        <% end %>
      <% end %>
    </div>
  </div>

  <div class='table-scroll'>
    <table>
      <thead>
      <tr>
        <th scope='col' class='w-20'>Location</th>
        <th scope='col'>Name</th>
        <th scope='col'>Bases</th>
        <th scope='col'></th>
        <th scope='col'>Statistics</th>
        <th scope='col'>Trade codes</th>
        <th scope='col'>Stars</th>
        <th scope='col'>Allegiance</th>
        <th scope='col'>Zone</th>
        <th scope='col'><span class='tracking-[0.2em]'>PBG</span></th>
        <th scope='col'>SI</th>
        <th scope='col' class='text-right whitespace-nowrap w-16 actions-cell'>Actions</th>
      </tr>
      </thead>

      <tbody>
      <% star_systems.each do |star_system| %>
        <tr class='cursor-pointer'
            data-controller='row-link'
            data-row-link-url-value='<%= star_system_path(star_system) %>'
            data-action='click->row-link#navigate'>
          <td class='whitespace-nowrap'>
            <%= star_system.parsec.subsector_hex_code %>
          </td>

          <td class='whitespace-nowrap'>
            <%= star_system.name %>
          </td>

          <td class='whitespace-nowrap'>
            <%= star_system.facilities_string %>
          </td>

          <td class='text-center'>
            <% if star_system.locked? %>
              <i class='fa-regular fa-lock' title='Locked'></i>
            <% end %>
          </td>

          <td class='whitespace-nowrap'>
            <%= star_system.main_world_uwp %>
            <% if star_system.native_sophont %>
              <i class='fa-regular fa-user-alien ml-1' title='Native sophont'></i>
            <% end %>
            <% if star_system.extinct_sophont %>
              <i class='fa-kit fa-light-user-alien-slash ml-1' title='Extinct sophont'></i>
            <% end %>
          </td>

          <td class='whitespace-nowrap'>
            <%= star_system.trade_codes_string %>
          </td>

          <td class='whitespace-nowrap'>
            <%= star_system.table_description %>
          </td>

          <td class='whitespace-nowrap'>
            <% if star_system.allegiance %>
              <%= render 'allegiances/pill', allegiance: star_system.allegiance %>
            <% end %>
          </td>

          <td class='whitespace-nowrap'>
            <% if (tz = star_system.travel_zone) %>
              <span class='pill'><%= tz.code %></span>
            <% end %>
          </td>

          <td class='whitespace-nowrap'>
            <span class='tracking-[0.2em]'><%= star_system.pbg %></span>
            <% if star_system.has_gas_giant? %>
              <i class='fa-regular fa-planet-ringed'></i>
            <% end %>
          </td>

          <td class='whitespace-nowrap'>
            <%= star_system.survey_index %>
          </td>

          <td class='actions-cell'>
            <div class='action-group'>
              <%= link_to edit_star_system_path(star_system), class: 'action', title: 'Edit' do %>
                <i class='fa-regular fa-pen-to-square'></i>
              <% end %>

              <%= button_to star_system_path(star_system),
                            method: :delete,
                            class: 'action danger',
                            title: 'Delete',
                            data: { turbo_confirm: 'Delete this star system?' } do %>
                <i class='fa-regular fa-trash'></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>