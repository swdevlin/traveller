<div class="overflow-hidden rounded-xl border border-slate-700/60 bg-slate-900/70 shadow-xl mt-4">
  <div class="bg-gradient-to-r from-slate-900 via-sky-900/40 to-slate-900 px-4 py-3 sm:px-6 sm:py-4">
    <div class="flex items-center justify-between gap-3">
      <p class="text-xs font-medium tracking-[0.2em] text-slate-300 uppercase">
        Star Systems
      </p>

      <% if local_assigns[:new_url].present? %>
        <%= link_to new_url,
            class: "inline-flex items-center gap-2 rounded-lg border border-slate-700/70 bg-slate-950/40 px-3 py-2.5 text-xs font-semibold text-slate-200 underline-offset-2 hover:border-traveller-red/60 hover:text-traveller-red/90 hover:bg-slate-950/70 transition" do %>
          <i class="fa-solid fa-plus text-[0.7rem]"></i>
          Add
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full table-fixed divide-y divide-slate-700 text-sm">
      <thead class="bg-slate-900/80">
      <tr>
        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-300 w-20">
          Location
        </th>
        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-300">
          Name
        </th>
        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-300">
          bases
        </th>
        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-300">
          Statistics
        </th>
        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-300">
          Trade codes
        </th>
        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-300">
          Travel codes
        </th>
        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-300">
          Stars
        </th>
        <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-300">
          PBG
        </th>
        <th scope="col" class="px-2 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-300 w-16 whitespace-nowrap">
          Actions
        </th>
      </tr>
      </thead>
      <tbody class="divide-y divide-slate-800 bg-slate-950/60">
      <% star_systems.each do |star_system| %>
        <tr class="transition hover:bg-slate-900/80">
          <td class="px-4 py-3 whitespace-nowrap align-middle">
            <%= link_to star_system.parsec.subsector_hex_code, star_system %>
          </td>

          <td class="px-4 py-3 whitespace-nowrap align-middle">
            <%= star_system.name %>
          </td>

          <td class="px-4 py-3 whitespace-nowrap align-middle">
          </td>

          <td class="px-4 py-3 whitespace-nowrap align-middle">
            <%= star_system.main_world_uwp %>
          </td>

          <td class="px-4 py-3 whitespace-nowrap align-middle">
            <%= star_system.trade_codes_string %>
          </td>

          <td class="px-4 py-3 whitespace-nowrap align-middle">
          </td>

          <td class="px-4 py-3 whitespace-nowrap align-middle">
            <%= star_system.table_description %>
          </td>

          <td class="px-2 py-3 whitespace-nowrap align-middle">
            <%= star_system.pbg %>
            <% if star_system.has_gas_giant? %>
              <i class="fa-regular fa-planet-ringed"></i>
            <% end %>
          </td>

          <td class="px-2 py-3 whitespace-nowrap align-middle text-right">
            <div class="inline-flex items-center justify-end gap-2">
              <%= link_to edit_star_system_path(star_system),
                          class: "text-slate-300 hover:text-traveller-red/90",
                          title: "Edit" do %>
                <i class="fa-solid fa-pen-to-square"></i>
              <% end %>

              <%= button_to star_system_path(star_system),
                            method: :delete,
                            form_class: "inline",
                            class: "text-slate-300 hover:text-traveller-red/90",
                            title: "Delete",
                            data: { turbo_confirm: "Delete this star system?" } do %>
                <i class="fa-solid fa-trash"></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>
