<%= modal(title: 'Edit Trade Codes', padding: true, advance: false, overlay: false) do %>
  <%= form_with url: update_trade_codes_star_system_path(@star_system) do |f| %>
    <input type="hidden" name="trade_code_ids[]" value="">

    <div class='grid grid-cols-2 sm:grid-cols-3 gap-2'>
      <% @trade_codes.each do |tc| %>
        <% selected = @current_ids.include?(tc.id) %>

        <div class='flex items-center gap-3 px-3 py-2.5'>
          <div data-controller='boolean-toggle' class='flex-shrink-0'>
            <%= check_box_tag 'trade_code_ids[]', tc.id, selected,
                               multiple: true,
                               class: 'sr-only',
                               data: { boolean_toggle_target: 'checkbox' } %>
            <button type='button'
                    role='switch'
                    aria-checked='<%= selected %>'
                    data-action='boolean-toggle#toggle'
                    data-boolean-toggle-target='button'
                    class='relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none <%= selected ? 'bg-toggle-on' : 'bg-toggle-off' %>'>
              <span data-boolean-toggle-target='indicator'
                    class='pointer-events-none inline-block h-5 w-5 transform rounded-full shadow ring-0 transition duration-200 ease-in-out <%= selected ? 'translate-x-5 bg-toggle-knob-on' : 'translate-x-0 bg-toggle-knob-off' %>'></span>
            </button>
          </div>
          <div class='min-w-0'>
            <span class='identifier-sm'><%= tc.code %></span>
            <div class='text-xs text-fg mt-0.5 truncate'><%= tc.definition %></div>
          </div>
        </div>
      <% end %>
    </div>

    <div class='mt-4 flex justify-end'>
      <%= f.submit 'Save', class: 'btn btn-primary' %>
    </div>
  <% end %>
<% end %>
