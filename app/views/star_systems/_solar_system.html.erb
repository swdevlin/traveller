<div id="<%= dom_id star_system %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Parsec:</strong>
    <%= star_system.parsec_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= star_system.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Meta:</strong>
    <%= star_system.meta %>
  </div>
</div>
