<%= content_for :title, @star_system.name.presence || 'Unlabelled System' %>
<%= content_for :page_kicker, 'IISS Class III Survey' %>
<%= content_for :page_title, @star_system.name.presence || 'Unlabelled System' %>
<%= content_for :iiss_form, '0421D' %>
<%= content_for :page_buttons do %>
  <div class='flex items-center justify-between'>
    <div class='flex flex-wrap gap-2'>
      <%= link_to 'Edit', edit_star_system_path(@star_system), class: 'w-full sm:w-auto btn btn-primary' %>
      <%= link_to 'Replace', replace_star_system_path(@star_system),
                  class: "w-full sm:w-auto btn btn-secondary #{@star_system.locked? ? 'opacity-50 pointer-events-none' : ''}",
                  title: @star_system.locked? ? 'Unlock this star system to replace it' : nil %>
      <% unless @star_system.has_populated_world? %>
        <%= link_to 'Social Characteristics', assign_social_characteristics_star_system_path(@star_system),
                    class: 'w-full sm:w-auto btn btn-secondary',
                    data: { turbo_frame: 'modal' } %>
      <% end %>
      <%= button_to 'Delete',
                    @star_system,
                    method: :delete,
                    form_class: 'inline-block',
                    class: 'w-full btn btn-danger',
                    data: { turbo_confirm: 'Are you sure?' } %>
    </div>
    <button type='button'
            title='Copy as markdown'
            class='text-slate-400 hover:text-slate-200'
            data-controller='clipboard'
            data-clipboard-markdown-url-value='<%= star_system_path(@star_system, format: :md) %>'
            data-action='click->clipboard#copyMarkdown'>
      <i class='fa-brands fa-markdown'></i>
    </button>
  </div>
<% end %>

<% parsec = @star_system.parsec %>
<% subsector = parsec&.subsector %>

<%= content_for :page_side do %>
  <% if subsector %>
    <%= render 'subsectors/map_embed', subsector: subsector, highlight: parsec.id %>
  <% end %>

  <div class='mt-6'>
    <%= render 'application/subsection', title: 'Network Links' %>
    <div class='flex justify-between items-start mt-2'>
      <div id="network-links-<%= @star_system.id %>" class='flex-1'>
        <% star_system_links = @star_system.network_links %>
        <% if star_system_links.any? %>
          <table class='data-table w-full text-sm'>
            <thead>
              <tr>
                <th>System</th>
                <th></th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% star_system_links.each do |link| %>
                <%= render 'network_link_row', link: link, star_system_id: @star_system.id %>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class='text-sm text-slate-400'>No network links.</p>
        <% end %>
      </div>
      <% if CommunicationNetwork.any? %>
        <%= link_to link_modal_star_system_path(@star_system),
                    class: 'btn btn-sm shrink-0 ml-4',
                    data: { turbo_frame: 'modal' } do %>
          <i class='fa-regular fa-plus mr-1'></i> Add Link
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<%= render 'application/two_column_page' do %>
  <%= render @star_system %>
<% end %>
