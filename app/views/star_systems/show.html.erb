<% parsec = @star_system.parsec %>
<% subsector = parsec&.subsector %>
<% sector = subsector&.sector %>

<%
  hierarchy = []
  hierarchy << [parsec.display_name, sector_path(sector)] if sector
  hierarchy << [parsec.subsector_display_name, subsector_path(subsector)] if subsector
%>
<%= render 'stellar_objects/object_context', hierarchy: hierarchy %>

<%= content_for :title, @star_system.name.presence || "#{sector.name}/#{parsec.hex_code}" %>
<%= content_for :page_kicker, 'IISS Class III Survey' %>
<%= content_for :page_title, @star_system.name.presence || "#{sector.name}/#{parsec.hex_code}" %>
<%= content_for :iiss_form, '0421D' %>
<%= content_for :page_actions do %>
  <%= link_to edit_star_system_path(@star_system), class: 'btn-header' do %>
    <i class='fa-regular fa-pen-to-square' aria-hidden='true'></i> Edit
  <% end %>
  <%= render 'star_systems/actions_menu', star_system: @star_system %>
<% end %>

<%= content_for :page_side do %>
  <% if @star_system.main_world_with_uwp? && @star_system.main_world.respond_to?(:atmosphere) %>
    <div class='mb-6'>
      <%= render 'application/planetary_body_sidebar_summary',
                 stellar_object: @star_system.main_world,
                 title: 'Main World Planetary Profile',
                 hide_transit_times: true,
                 show_tags: true %>
    </div>
  <% end %>

  <% if subsector %>
    <%= render 'subsectors/map_embed', subsector: subsector, highlight: parsec.id %>
  <% end %>

  <% if parsec %>
    <%= render 'star_systems/jump_survey', star_system: @star_system %>
  <% end %>

  <div class='mt-6'>
    <%= render 'application/subsection', title: 'Jump Route Links' %>
    <div id="jump-route-links-<%= @star_system.id %>" class='mt-2'>
      <% star_system_links = @star_system.jump_route_links %>
      <div class='table-card'>
        <div class='table-banner'>
          <p>Jump route links</p>
          <div class='actions'>
            <% if JumpRoute.any? %>
              <%= link_to link_modal_star_system_path(@star_system),
                          class: 'btn-header',
                          data: { turbo_frame: 'modal' } do %>
                <i class='fa-regular fa-plus'></i>
                Add
              <% end %>
            <% end %>
          </div>
        </div>
        <div class='table-scroll'>
          <table>
            <thead>
              <tr>
                <th>System</th>
                <th></th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% star_system_links.each do |link| %>
                <%= render 'jump_route_link_row', link: link, star_system_id: @star_system.id %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%= render 'application/two_column_page', header_in_main: true do %>
  <%= render @star_system %>
<% end %>
