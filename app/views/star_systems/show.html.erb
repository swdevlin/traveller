<%= content_for :title, @star_system.name.presence || 'Unlabelled System' %>
<%= content_for :page_kicker, 'IISS Class III Survey' %>
<%= content_for :page_title, @star_system.name.presence || 'Unlabelled System' %>
<%= content_for :iiss_form, '0421D' %>
<%= content_for :page_buttons do %>
  <%= link_to 'Edit', edit_star_system_path(@star_system), class: 'w-full sm:w-auto btn btn-primary' %>
  <%= link_to 'Replace', replace_star_system_path(@star_system),
              class: "w-full sm:w-auto btn btn-secondary #{@star_system.locked? ? 'opacity-50 pointer-events-none' : ''}",
              title: @star_system.locked? ? 'Unlock this star system to replace it' : nil %>
  <%= button_to 'Delete',
                @star_system,
                method: :delete,
                form_class: 'sm:inline-block mt-2 sm:mt-0',
                class: 'w-full btn btn-danger',
                data: { turbo_confirm: 'Are you sure?' } %>
<% end %>

<% parsec = @star_system.parsec %>
<% subsector = parsec&.subsector %>

<%= content_for :page_side do %>
  <% if subsector %>
    <%= render 'subsectors/map_embed', subsector: subsector, highlight: parsec.id %>
  <% end %>
<% end %>

<%= render 'application/two_column_page' do %>
  <%= render @star_system %>
<% end %>
