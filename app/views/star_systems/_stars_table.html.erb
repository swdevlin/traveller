<div class='table-card'>
  <div class='table-banner'>
    <p>Stars</p>
  </div>

  <div class='table-scroll'>
    <table>
      <thead>
      <tr>
        <th scope='col'>ID</th>
        <% if show_orbit_number? %>
          <th scope='col' class='text-right'>Orbit #</th>
        <% end %>
        <% if show_au? %>
          <th scope='col' class='text-right'>AU</th>
        <% end %>
        <th scope='col'>Class</th>
        <th scope='col' class='text-right'>Diameter</th>
        <th scope='col' class='text-right'>Ecc</th>
        <th scope='col' class='text-right'>Period</th>
        <th scope='col' class='text-right'>HZCO</th>
        <th scope='col' class='text-right actions-cell'>Actions</th>
      </tr>
      </thead>

      <tbody>
      <% stars.each do |star| %>
        <tr class='cursor-pointer'
            data-controller='row-link'
            data-row-link-url-value='<%= star_path(star) %>'
            data-action='click->row-link#navigate'>
          <td class='whitespace-nowrap'>
            <span class='pill'><%= star.orbit_sequence %></span>
          </td>

          <% if show_orbit_number? %>
            <td class='text-right'><%= number_with_precision(star.orbit, precision: 2, strip_insignificant_zeros: true) %></td>
          <% end %>
          <% if show_au? %>
            <td class='text-right'><%= number_with_precision(star.au, precision: 2, strip_insignificant_zeros: true) %></td>
          <% end %>
          <td class='whitespace-nowrap'>
            <%= star.spectral_classification %>
          </td>

          <td class='text-right'><%= number_with_precision(star.diameter, precision: 2, strip_insignificant_zeros: true) %></td>
          <td class='text-right'><%= number_with_precision(star.eccentricity, precision: 2, strip_insignificant_zeros: true) %></td>
          <td class='text-right'><%= format_period(star.period) %></td>
          <td class='text-right'><%= format_precision(star.hzco) %></td>

          <td class='actions-cell'>
            <div class='action-group'>
              <%= link_to edit_star_path(star), class: 'action', title: 'Edit' do %>
                <i class='fa-regular fa-pen-to-square'></i>
              <% end %>

              <% unless star.orbiting.nil? %>
                <%= button_to star_path(star),
                              method: :delete,
                              class: 'action danger',
                              title: 'Delete',
                              data: { turbo_confirm: "Delete #{star.spectral_classification}?" } do %>
                  <i class='fa-regular fa-trash'></i>
                <% end %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>