<%= modal(title: 'Edit Bases', padding: true, advance: false, overlay: false) do %>
  <%= form_with url: update_bases_star_system_path(@star_system) do |f| %>
    <input type='hidden' name='facility_ids[]' value=''>

    <div class='grid grid-cols-2 sm:grid-cols-3 gap-2'>
      <% @facilities.each do |facility| %>
        <% selected = @current_ids.include?(facility.id) %>

        <div class='flex items-center gap-3 px-3 py-2.5'>
          <div data-controller='boolean-toggle' class='flex-shrink-0'>
            <%= check_box_tag 'facility_ids[]', facility.id, selected,
                               multiple: true,
                               class: 'sr-only',
                               data: { boolean_toggle_target: 'checkbox' } %>
            <button type='button'
                    role='switch'
                    aria-checked='<%= selected %>'
                    data-action='boolean-toggle#toggle'
                    data-boolean-toggle-target='button'
                    class='toggle'>
              <span data-boolean-toggle-target='indicator'></span>
            </button>
          </div>

          <div class='min-w-0'>
            <span class='identifier-sm'><%= facility.code %></span>
            <div class='text-xs text-fg mt-0.5 truncate'><%= facility.name %></div>
          </div>
        </div>
      <% end %>
    </div>

    <div class='mt-4 flex justify-end'>
      <%= f.submit 'Save', class: 'btn btn-primary' %>
    </div>
  <% end %>
<% end %>