<%
  handout = @handout
  n = ->(value) { value.round(3) }
-%><svg xmlns="http://www.w3.org/2000/svg"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     width="<%= handout.width %>mm" height="<%= handout.height %>mm"
     viewBox="0 0 <%= handout.width %> <%= handout.height %>">
  <style>
    .f-mono { font-family: "JetBrains Mono", ui-monospace, monospace; }
    .f-display { font-family: "Orbitron", system-ui, sans-serif; }

    /* Print palette for the subway map: dark ink on white, in place of the screen's light-on-black. */
    .subway-track { stroke: #6b7c8a; stroke-width: 4; stroke-linecap: round; }
    .subway-branch { stroke: #6b7c8a; stroke-width: 4; stroke-linecap: round; stroke-dasharray: 8 4; }
    .subway-moon { stroke: #6b7c8a; stroke-width: 2; stroke-linecap: round; stroke-dasharray: 6 4; opacity: 0.7; }
    .subway-star { stroke: #1b2733; stroke-width: 2; }
    .subway-gas-giant { stroke: #6d28d9; stroke-width: 2; }
    .subway-terrestrial { stroke: #1b2733; stroke-width: 1.5; }
    .subway-planetoid-belt { fill: none; stroke: #5b6b7a; stroke-width: 2; stroke-dasharray: 3 3; }
    .subway-junction { fill: #6b7c8a; stroke: none; }
    .subway-other-body { fill: #94a3b8; stroke: #475569; stroke-width: 2; }
    .subway-label { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; fill: #1b2733; }
    .subway-star-label { font-family: "Orbitron", system-ui, sans-serif; font-size: 12px; fill: #1b2733; text-transform: uppercase; letter-spacing: 0.05em; }
    .subway-au-label { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 12px; fill: #5b6b7a; }
    .subway-sublabel { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 10px; fill: #334155; }
    .subway-sublabel-halo { stroke: #ffffff; stroke-width: 4px; paint-order: stroke; }
  </style>

  <rect width="100%" height="100%" fill="#ffffff"/>

<% handout.items.each do |item| %>
<% case item %>
<% when HandoutCanvas::Rect %>
  <rect x="<%= n.(item.x) %>" y="<%= n.(item.y) %>" width="<%= n.(item.width) %>" height="<%= n.(item.height) %>" fill="<%= item.fill || 'none' %>"<% if item.stroke %> stroke="<%= item.stroke %>" stroke-width="<%= item.stroke_width %>"<% end %>/>
<% when HandoutCanvas::Image %>
  <image x="<%= n.(item.x) %>" y="<%= n.(item.y) %>" width="<%= n.(item.width) %>" height="<%= n.(item.height) %>" preserveAspectRatio="xMidYMid meet" href="<%= item.href %>"/>
<% when HandoutCanvas::Subway %>
  <svg x="<%= n.(item.x) %>" y="<%= n.(item.y) %>" width="<%= n.(item.width) %>" height="<%= n.(item.height) %>" viewBox="<%= item.view_box.map { |v| n.(v) }.join(' ') %>" preserveAspectRatio="xMidYMin meet">
    <%= render 'star_systems/system_map_inner', layout: item.layout, linkable: false %>
  </svg>
<% when HandoutCanvas::Text %>
  <text x="<%= n.(item.x) %>" y="<%= n.(item.y) %>" font-size="<%= n.(item.size) %>" class="f-<%= item.font %>" fill="<%= item.fill %>" xml:space="preserve"<% if item.anchor != 'start' %> text-anchor="<%= item.anchor %>"<% end %><% if item.weight %> font-weight="<%= item.weight %>"<% end %><% if item.italic %> font-style="italic"<% end %><% if item.strike || item.underline %> text-decoration="<%= [('underline' if item.underline), ('line-through' if item.strike)].compact.join(' ') %>"<% end %><% if item.spacing %> letter-spacing="<%= item.spacing %>"<% end %>><%= item.text %></text>
<% end %>
<% end %>
</svg>
