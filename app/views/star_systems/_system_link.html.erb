<% if star_system.name.present? %>
  <%= link_to star_system.name, star_system_path(star_system),
              class: 'block no-underline hover:underline hover:underline-offset-2' %>
  <span class='block text-xs text-fg-muted'>
    <%= link_to star_system.parsec.sector.name, sector_path(star_system.parsec.sector),
                class: 'no-underline hover:underline hover:underline-offset-2' %>
    · <%= star_system.parsec.hex_code %>
  </span>
<% else %>
  <span class='block'>
    <%= link_to star_system.parsec.sector.name, sector_path(star_system.parsec.sector),
                class: 'no-underline hover:underline hover:underline-offset-2' %>
    · <%= star_system.parsec.hex_code %>
  </span>
<% end %>