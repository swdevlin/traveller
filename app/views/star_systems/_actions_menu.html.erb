<% item_class = actions_menu_item_class %>
<% has_mappable_bodies = star_system.mappable_bodies_without_map.exists? %>
<%= render layout: 'application/actions_dropdown', locals: { menu_id: 'star-system-actions' } do %>
  <%= link_to replace_star_system_path(star_system),
              class: "#{item_class} #{star_system.locked? ? 'opacity-40 pointer-events-none' : ''}",
              title: star_system.locked? ? 'Unlock this star system to replace it' : nil do %>
    <i class='fa-regular fa-rotate mt-1' aria-hidden='true'></i> Replace
  <% end %>

  <%= button_to generate_maps_star_system_path(star_system),
                method: :post,
                class: item_class,
                disabled: !has_mappable_bodies,
                title: has_mappable_bodies ? nil : 'All eligible planets, planetoids and moons already have maps.',
                form: { class: 'w-full' } do %>
    <i class='fa-regular fa-map mt-1' aria-hidden='true'></i> Generate maps
  <% end %>

  <%= link_to commerce_path(from_id: star_system.id), class: item_class do %>
    <i class='fa-regular fa-cart-shopping mt-1' aria-hidden='true'></i> Commerce
  <% end %>

  <% unless star_system.has_populated_world? %>
    <%= link_to assign_social_characteristics_star_system_path(star_system),
                class: item_class,
                data: { turbo_frame: 'modal', action: 'dropdown#close' } do %>
      <i class='fa-regular fa-users mt-1' aria-hidden='true'></i> Social Characteristics
    <% end %>
  <% end %>

  <%= render 'application/copy_markdown_item', url: star_system_path(star_system, format: :md) %>

  <div class='border-t border-outline mt-1 pt-1'>
    <%= button_to star_system,
                  method: :delete,
                  class: actions_menu_item_class(danger: true),
                  form: { class: 'w-full' },
                  data: { turbo_confirm: 'Are you sure?' } do %>
      <i class='fa-regular fa-trash mt-1' aria-hidden='true'></i> Delete
    <% end %>
  </div>
<% end %>
