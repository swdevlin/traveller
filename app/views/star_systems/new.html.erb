<% content_for :title, 'New star system' %>
<% content_for :page_kicker, @context_label %>
<% content_for :page_title, 'Register Star System' %>
<% content_for :help_path, help_page_path('star_system_registration') %>

<% create_mode = params.dig(:star_system, :create_mode).presence || 'empty' %>

<%= render 'application/page' do %>
  <%= form_with model: @star_system, url: @form_url, class: 'space-y-8',
                data: { controller: 'star-system-form' } do |f| %>

    <div>
      <%= f.label :name, class: 'block text-sm font-semibold mb-1' do %>Name<%= required_icon(@star_system, :name) %><% end %>
      <%= f.text_field :name,
                       class: 'w-160 edit-base' %>
      <%= render 'application/field_error', form: f, attribute: :name %>
    </div>

    <% unless @parsec %>
      <% parsec_class = [
        'w-40 edit-base',
        (@star_system.errors[:parsec_id].any? ? 'border-highlight/90 focus:border-highlight/90 focus:ring-highlight/30' : nil)
      ].compact.join(' ')
      %>
      <div>
        <%= f.label :parsec_id, class: 'block text-sm font-semibold mb-1' do %>Hex<%= required_icon(@star_system, :parsec_id) %><% end %>
        <%= f.select :parsec_id,
                     options_for_select(@parsec_options, @star_system.parsec_id),
                     { prompt: 'Select a hex' },
                     class: parsec_class %>
        <%= render 'application/field_error', form: f, attribute: :parsec_id %>
      </div>
    <% end %>

    <div class='space-y-4'>
      <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Initialization Mode</div>

      <div class='rounded-2xl border border-outline/70 bg-panel p-4 space-y-3'>
        <%# ── Empty ── %>
        <label class='flex items-start gap-3 cursor-pointer'>
          <%= f.radio_button :create_mode, 'empty',
                             checked: create_mode == 'empty',
                             class: 'mt-1 h-4 w-4',
                             data: { action: 'star-system-form#sync' } %>
          <div>
            <div class='text-sm font-semibold text-fg-bright'>Empty</div>
            <div class='text-xs text-fg-muted'>Register with optional star configuration.</div>
          </div>
        </label>

        <div class="ml-7 space-y-6 <%= 'hidden' unless create_mode == 'empty' %>"
             data-star-system-form-target='starConfig'>
          <h3 class='text-sm font-semibold text-highlight-fg mb-3'>Primary Star</h3>
          <%= render 'star_fields', prefix: 'primary', disabled: create_mode != 'empty' %>
        </div>

        <div class='border-t border-outline'></div>

        <%# ── Random ── %>
        <label class='flex items-start gap-3 cursor-pointer'>
          <%= f.radio_button :create_mode, 'random',
                             checked: create_mode == 'random',
                             class: 'mt-1 h-4 w-4',
                             data: { action: 'star-system-form#sync' } %>
          <div>
            <div class='text-sm font-semibold text-fg-bright'>Random</div>
            <div class='text-xs text-fg-muted'>Generate automatically.</div>
          </div>
        </label>

        <div class='border-t border-outline'></div>

        <%# ── Build configuration ── %>
        <label class='flex items-start gap-3 cursor-pointer'>
          <%= f.radio_button :create_mode, 'build_configuration',
                             checked: create_mode == 'build_configuration',
                             class: 'mt-1 h-4 w-4',
                             data: { action: 'star-system-form#sync' } %>
          <div>
            <div class='text-sm font-semibold text-fg-bright'>Build configuration</div>
            <div class='text-xs text-fg-muted'>Directive packet (YAML).</div>
          </div>
        </label>

        <div class="ml-7 space-y-2 <%= 'hidden' unless create_mode == 'build_configuration' %>"
             data-star-system-form-target='buildConfigSection'>
          <%= f.label :build, class: 'block text-xs uppercase tracking-[0.22em] text-fg-muted' do %>
            Build configuration (<%= link_to 'YAML', help_page_path('star_system_build_specification'), class: 't-link' %>)
          <% end %>

          <% if @build_errors.present? %>
            <%= render 'application/build_errors', errors: @build_errors %>
          <% end %>

          <%= f.text_area :build,
                          rows: 12,
                          class: 'w-full edit-base font-mono',
                          disabled: create_mode != 'build_configuration',
                          data: { star_system_form_target: 'buildConfig' } %>
        </div>
      </div>
    </div>

    <div class='pt-4'>
      <%= f.submit 'Commit Core', class: 'btn btn-primary w-full sm:w-auto' %>
    </div>
  <% end %>
<% end %>
