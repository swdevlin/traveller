<div class='flex flex-col gap-6'>
  <h1 class='text-3xl font-bold mb-6'>
    <i class='fa-solid fa-meteor mr-2 text-slate-300'></i>
    Add a star system to <span class='text-slate-200'><%= @context_label %></span>
  </h1>

  <%= render 'form' do |f| %>
    <% random_checked = params.dig(:star_system, :random_star) != '0' %>

    <% unless @parsec %>
      <div>
        <%= f.label :parsec_id, 'Hex', class: 'block text-sm font-semibold mb-1' %>
        <%= f.select :parsec_id,
                     options_for_select(@parsec_options, @star_system.parsec_id),
                     { prompt: 'Select a hex' },
                     class: 'w-full edit-base' %>
      </div>
    <% end %>

    <div class='space-y-6'>
      <div class='flex items-center gap-3'>
        <%= f.check_box :random_star,
                        { class: 'h-4 w-4 rounded border-slate-700 bg-slate-950',
                          data: { action: 'star-system-form#toggleRandom', star_system_form_target: 'randomToggle' } },
                        '1',
                        '0' %>
        <%= f.label :random_star, 'Random stars (generate all stars randomly)', class: 'text-sm font-semibold' %>
      </div>

      <div class="<%= 'hidden' if random_checked %> space-y-6" data-star-system-form-target="starConfig">
        <div>
          <h3 class='text-sm font-semibold text-deepnight-orange mb-3'>Primary Star</h3>
          <%= render 'star_fields', prefix: 'primary', disabled: random_checked %>
          <div class='mt-4'>
            <%= render 'star_section', prefix: 'primary_companion', label: 'Companion', indent: true %>
          </div>
        </div>

        <%= render 'star_section', prefix: 'close', label: 'Close Star' %>
        <%= render 'star_section', prefix: 'close_companion', label: 'Companion', indent: true %>

        <%= render 'star_section', prefix: 'near', label: 'Near Star' %>
        <%= render 'star_section', prefix: 'near_companion', label: 'Companion', indent: true %>

        <%= render 'star_section', prefix: 'far', label: 'Far Star' %>
        <%= render 'star_section', prefix: 'far_companion', label: 'Companion', indent: true %>
      </div>
    </div>
  <% end %>
</div>
