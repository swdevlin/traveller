<div id="<%= dom_id star_system, :main_world %>">
  <%= render 'application/data_block',
             label: 'Main world UWP',
             value: (star_system.main_world_uwp.presence || '???????-?'),
             value_style: :mono,
             value_wrap_class: 'flex items-center gap-2',
             suffix: link_to(select_main_world_star_system_path(star_system),
                             data: { turbo_frame: 'modal' },
                             class: 'btn-header') {
               tag.i(class: 'fa-regular fa-pen-to-square')
             } %>
</div>
