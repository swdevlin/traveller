<%= modal(title: 'Add Jump Route Link', padding: true, advance: false, overlay: false) do %>
  <%# Jump route selector %>
  <div class='mb-4'>
    <label class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Jump Route</label>
    <div class='mt-1'>
      <%= form_with url: link_modal_star_system_path(@star_system), method: :get, data: { turbo_frame: 'modal' } do |f| %>
        <%= f.select :jump_route_id,
                     @jump_routes.map { |r| [r.name, r.id] },
                     { selected: @selected_jump_route&.id, include_blank: 'Select jump route...' },
                     { onchange: 'this.form.requestSubmit()', class: 'edit-base w-full' } %>
      <% end %>
    </div>
  </div>

  <% if @selected_jump_route %>
    <%# Hex map %>
    <div id='link-modal-map' class='mb-4 overflow-auto' data-controller='hex-stream'>
      <div style='zoom: 0.75; line-height: 0;'>
        <%= @map_svg.html_safe %>
      </div>
    </div>

    <%# Systems table %>
    <div id='link-modal-systems'>
      <%= render 'star_systems/link_modal_systems' %>
    </div>
  <% else %>
    <p class='text-fg-muted text-sm'>Select a jump route to view nearby systems.</p>
  <% end %>
<% end %>
