<%= form_with url: star_system_path(star_system), method: :patch do %>
  <%= hidden_field_tag 'star_system[known]', !star_system.known? %>
  <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Known</div>
  <div class='mt-2 flex items-center gap-3'>
    <button type='submit'
            role='switch'
            aria-checked='<%= star_system.known? %>'
            class='relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none <%= star_system.known? ? "bg-toggle-on" : "bg-toggle-off" %>'>
      <span class='pointer-events-none inline-block h-5 w-5 transform rounded-full shadow ring-0 transition duration-200 ease-in-out <%= star_system.known? ? "translate-x-5 bg-toggle-knob-on" : "translate-x-0 bg-toggle-knob-off" %>'></span>
    </button>
    <span class='text-xs text-fg-muted italic'>System is visible on player maps.</span>
  </div>
<% end %>