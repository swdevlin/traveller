<% content_for :title, @allegiance.name %>
<% content_for :page_kicker, "Allegiance Classification" %>
<% content_for :page_title, @allegiance.name %>

<%= render 'application/page' do %>
  <%= render @allegiance %>

  <%= render 'application/world_statistics',
             stats: @allegiance,
             governments_by_code: @governments_by_code,
             law_levels_by_code: @law_levels_by_code,
             tech_levels_by_code: @tech_levels_by_code,
             travel_zones_by_id: @travel_zones_by_id,
             facilities_by_id: @facilities_by_id,
             trade_codes_by_id: @trade_codes_by_id %>

  <%= link_to "Edit", edit_allegiance_path(@allegiance), class: "w-full sm:w-auto btn btn-primary" %>
  <%= render 'application/back_button',
             path: allegiances_path(page: @page),
             label: 'Allegiances',
             class: 'w-full sm:w-auto' %>
  <%= button_to "Delete",
                @allegiance,
                method: :delete,
                form_class: "w-full sm:w-auto inline-flex m-0",
                class: "w-full sm:w-auto btn btn-danger cursor-pointer",
                data: { turbo_confirm: "Are you sure?" } %>
<% end %>
