<div class="table-card">

<div class='table-scroll'>
  <table>
    <thead>
    <tr>
      <th scope='col'>Code</th>
      <th scope='col'>Name</th>
      <th scope='col'>Legacy</th>
      <th scope='col' class='text-right'>Actions</th>
    </tr>
    </thead>

    <tbody>
    <% allegiances.each do |allegiance| %>
      <tr>
        <td class='whitespace-nowrap'>
          <span class='pill'><%= allegiance.code %></span>
        </td>

        <td>
          <%= link_to allegiance_path(allegiance), class: 't-link', data: { turbo_frame: '_top' } do %>
            <%= allegiance.name %>
          <% end %>
        </td>

        <td class='whitespace-nowrap'>
          <% if allegiance.legacy_code.present? %>
            <span class='pill'><%= allegiance.legacy_code %></span>
          <% end %>
        </td>

        <td class='actions-cell'>
          <div class='action-group'>
            <%= link_to edit_allegiance_path(allegiance), class: 'action', data: { turbo_frame: '_top' } do %>
              <i class='fa-regular fa-pen-to-square'></i>
            <% end %>

            <%= button_to allegiance,
                          method: :delete,
                          class: 'action danger',
                          data: { turbo_confirm: "Delete #{allegiance.code}?" } do %>
              <i class='fa-regular fa-trash'></i>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>

  <div class='w-full pb-4'>
    <%== pagy.series_nav %>
  </div>
</div>
</div>
