<div id="<%= dom_id allegiance %>" class='flex flex-col md:flex-row md:items-start gap-6 mb-4'>
  <div class='flex-1 min-w-0 space-y-6'>
    <div class='grid grid-cols-1 gap-4 sm:grid-cols-3'>
      <%= render 'application/data_block',
                 label: 'Code',
                 value_wrap_class: 'mt-2 flex flex-wrap items-center gap-2 text-slate-100',
                 value: tag.span(allegiance.code, class: 'identifier')

      %>

      <%= render 'application/data_block',
                 label: 'Name',
                 value: allegiance.name
      %>

      <%= render 'application/data_block',
                 label: 'Legacy Code',
                 value_wrap_class: 'mt-2 flex flex-wrap items-center gap-2 text-slate-100',
                 value: tag.span(allegiance.legacy_code, class: 'identifier')

      %>

    </div>
  </div>
</div>
