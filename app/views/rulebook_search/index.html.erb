<% content_for :title, 'Information Retrieval System' %>
<% content_for :page_kicker, 'Reference Manual' %>
<% content_for :page_title, 'Information Retrieval System' %>

<%= render 'application/page' do %>
  <div class='space-y-4 rulebook-search-page'>
    <%= form_with url: rulebook_search_path,
                  method: :get,
                  data: { turbo_frame: 'rulebook-search-results', controller: 'autosubmit', autosubmit_delay_value: 250 },
                  class: 'flex flex-col gap-3' do %>
      <div class='flex flex-col gap-3 sm:flex-row sm:items-center'>
        <div class='relative flex-1'>
          <i class='fa-regular fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-fg-muted'></i>
          <%= text_field_tag :q, @query,
                             placeholder: 'Search every rulebook, e.g. "jump drive"',
                             autocomplete: 'off',
                             data: { controller: 'autofocus', action: 'input->autosubmit#queue' },
                             class: 'input w-full pl-9' %>
        </div>

        <%= submit_tag 'Search', class: 'btn btn-primary' %>
      </div>

      <div class='flex flex-wrap items-center gap-3'>
        <i class='fa-regular fa-filter text-fg-muted text-sm'></i>

        <%= select_tag :rulebook_ids,
                       options_for_select([['All rulebooks', nil]] + Rulebook.searchable.order(:title).pluck(:title, :id),
                                          params[:rulebook_ids]),
                       class: 'input',
                       data: { action: 'change->autosubmit#queue' } %>

        <%= select_tag :categories,
                       options_for_select([['All categories', nil]] + Rulebook.categories.keys.map { |c| [c.humanize, c] },
                                          params[:categories]),
                       class: 'input',
                       data: { action: 'change->autosubmit#queue' } %>
      </div>
    <% end %>

    <div data-controller='boolean-toggle' class='flex items-center gap-3'>
      <%= check_box_tag :include_low_relevance, '1', false,
                         id: 'include_low_relevance',
                         class: 'sr-only',
                         data: { boolean_toggle_target: 'checkbox' } %>
      <button type='button'
              role='switch'
              aria-checked='false'
              data-action='boolean-toggle#toggle'
              data-boolean-toggle-target='button'
              class='relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none bg-toggle-off'>
        <span data-boolean-toggle-target='indicator'
              class='pointer-events-none inline-block h-5 w-5 transform rounded-full shadow ring-0 transition duration-200 ease-in-out translate-x-0 bg-toggle-knob-off'></span>
      </button>
      <span class='text-sm text-fg-muted'>Include low-relevance matches</span>
    </div>

    <turbo-frame id='rulebook-search-results'>
      <%= render 'results', groups: @groups, query: @query %>
    </turbo-frame>
  </div>
<% end %>