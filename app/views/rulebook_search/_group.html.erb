<%# locals: group, query %>
<% title = safe_join([
  content_tag(:i, '', class: 'fa-regular fa-book mr-2'),
  group.rulebook.title,
  (content_tag(:span, group.rulebook.edition, class: 'pill ml-2') if group.rulebook.edition.present?)
].compact) %>
<% hidden_count = group.total_matches - group.relevant_matches %>
<% match_count = safe_join([
  content_tag(:span, class: 'text-xs text-fg-muted', data: { relevance_label: 'default' }) do
    safe_join([pluralize(group.relevant_matches, 'match', plural: 'matches'), ' · ',
               hidden_count, ' hidden'])
  end,
  content_tag(:span, class: 'text-xs text-fg-muted', data: { relevance_label: 'expanded' }) do
    safe_join([pluralize(group.relevant_matches, 'relevant match', plural: 'relevant matches'), ' · ', group.total_matches, ' total'])
  end
]) %>

<%= render 'application/collapsible_table_card', title: title, actions: match_count, collapsed: true do %>
  <div class='divide-y divide-outline'>
    <% group.hits.each do |hit| %>
      <%= render 'hit', hit: hit %>
    <% end %>
    <% group.low_relevance_hits.each do |hit| %>
      <%= render 'hit', hit: hit, low_relevance: true %>
    <% end %>
  </div>

  <% if group.total_matches > group.hits.size + group.low_relevance_hits.size %>
    <turbo-frame id='rulebook-<%= group.rulebook.id %>-more'
                 src='<%= more_rulebook_search_path(rulebook_id: group.rulebook.id, q: query) %>'
                 loading='lazy'>
      <div class='p-3 text-center'>
        <i class='fa-regular fa-ellipsis text-fg-muted'></i>
      </div>
    </turbo-frame>
  <% end %>
<% end %>
