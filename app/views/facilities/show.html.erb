<% content_for :title, @facility.name %>

<div class="md:w-2/3 w-full">
  <div class="page-shell">
    <div class="page-header">
      <div>
        <div class="page-kicker">
          Base Classification
        </div>
        <div class="page-title font-header">
          <%= @facility.name %>
        </div>
      </div>
      <div class="page-actions">
      </div>
    </div>

    <div class="page-body">
      <div class="page-main">
        <%= render @facility %>

        <%= link_to "Edit", edit_facility_path(@facility), class: "w-full sm:w-auto btn" %>
        <%= render 'application/back_button',
                   path: facilities_path,
                   label: 'Bases',
                   class: 'w-full sm:w-auto' %>
        <%= button_to "Delete", @facility, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full sm:w-auto btn btn-danger", data: { turbo_confirm: "Are you sure?" } %>
      </div>
      <div class="page-side">
      </div>
    </div>
  </div>
</div>
