<% content_for :title, "Bases" %>
<% content_for :page_kicker, "Reference Manual" %>
<% content_for :page_title, "Base Classifications" %>

<%= render 'application/page' do %>
  <div class='t-card'>
    <div class='t-card-header'>
      <div class="flex items-center justify-between gap-3">
        <p class='t-card-title'>Base registry</p>
        <%= link_to new_facility_path, class: "btn-header" do %>
          <i class="fa-solid fa-plus text-[0.7rem]"></i>
          Add
        <% end %>
      </div>
    </div>

    <div class='t-scroll-x'>
      <table class='t-table'>
        <thead class='t-thead'>
        <tr>
          <th scope='col' class='t-th'>Code</th>
          <th scope='col' class='t-th'>Name</th>
          <th scope='col' class='t-th'>TravellerMap Code</th>
          <th scope='col' class='t-th-right'>Actions</th>
        </tr>
        </thead>

        <tbody class='t-tbody'>
        <% @facilities.each do |facility| %>
          <tr class='t-tr'>
            <td class='t-td-nowrap'>
              <span class='t-pill'><%= facility.code %></span>
            </td>

            <td class='t-td'>
              <%= link_to facility_path(facility), class: 't-link' do %>
                <%= facility.name %>
              <% end %>
            </td>

            <td class='t-td-nowrap'>
              <% if facility.traveller_map_code.present? %>
                <span class='t-pill'><%= facility.traveller_map_code %></span>
              <% end %>
            </td>

            <td class='t-td-right'>
              <div class='t-actions'>
                <%= link_to edit_facility_path(facility), class: 't-action' do %>
                  <i class='fa-regular fa-pen-to-square'></i>
                <% end %>

                <%= button_to facility,
                              method: :delete,
                              class: 't-action-danger',
                              data: { turbo_confirm: "Delete #{facility.code}?" } do %>
                  <i class='fa-regular fa-trash'></i>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
