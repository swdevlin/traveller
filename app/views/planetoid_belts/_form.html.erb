<% star = stellar_object.orbiting_star %>

<%= form_with(model: stellar_object, scope: :stellar_object, url: stellar_object_path(stellar_object), class: 'contents') do |form| %>
  <div class='space-y-2 pb-10'>
    <%= render 'application/form_errors', errors: stellar_object.errors.where(:base) %>

    <%= render 'application/edit_field', form: form, attribute: :name do %>
      <%= form.text_field :name, class: 'edit-base w-100' %>
    <% end %>

    <% if star %>
      <div class='flex items-center gap-2 pt-2'>
        <div class='text-xs uppercase tracking-[0.22em] text-deepnight-orange'>Orbital Data</div>
        <div class='h-px flex-1 bg-slate-700/70'></div>
      </div>

      <%= render 'application/edit_field', form: form, attribute: :orbit, required: true do %>
        <%= form.number_field :orbit,
                              value: format_precision(stellar_object.orbit, precision: 5),
                              class: 'edit-base sm:w-28 w-24',
                              step: 'any',
                              min: star.minimum_orbit,
                              required: true %>
      <% end %>

      <%= form.fields_for :data, (stellar_object.data || {}) do |df| %>
        <%= render 'application/edit_field', form: form, attribute: :period do %>
          <%= df.number_field :period,
                              value: format_precision(stellar_object.period, precision: 5),
                              class: 'edit-base sm:w-28 w-24',
                              step: 'any' %>
        <% end %>

        <%= render 'application/edit_field', form: form, attribute: :retrograde do %>
          <%= df.check_box :retrograde,
                           { checked: stellar_object.retrograde, class: 'rounded bg-slate-950 border-slate-700' },
                           'true', 'false' %>
        <% end %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :inclination do %>
        <%= form.number_field :inclination,
                              value: format_precision(stellar_object.inclination, precision: 5),
                              class: 'edit-base sm:w-28 w-24',
                              step: 'any' %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :eccentricity do %>
        <%= form.number_field :eccentricity,
                              value: format_precision(stellar_object.eccentricity, precision: 5),
                              class: 'edit-base sm:w-28 w-24',
                              step: 'any' %>
      <% end %>
    <% end %>

    <div class='flex items-center gap-2 pt-2'>
      <div class='text-xs uppercase tracking-[0.22em] text-deepnight-orange'>Composition</div>
      <div class='h-px flex-1 bg-slate-700/70'></div>
    </div>

    <%= form.fields_for :data, (stellar_object.data || {}) do |df| %>
      <%= render 'application/edit_field', form: form, attribute: :m_type, field_label: 'Metallic %' do %>
        <%= df.number_field :m_type,
                            value: stellar_object.m_type,
                            class: 'edit-base sm:w-28 w-24',
                            step: 1,
                            min: 0,
                            max: 100 %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :s_type, field_label: 'Stony %' do %>
        <%= df.number_field :s_type,
                            value: stellar_object.s_type,
                            class: 'edit-base sm:w-28 w-24',
                            step: 1,
                            min: 0,
                            max: 100 %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :c_type, field_label: 'Carbonaceous %' do %>
        <%= df.number_field :c_type,
                            value: stellar_object.c_type,
                            class: 'edit-base sm:w-28 w-24',
                            step: 1,
                            min: 0,
                            max: 100 %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :o_type, field_label: 'Other %' do %>
        <%= df.number_field :o_type,
                            value: stellar_object.o_type,
                            class: 'edit-base sm:w-28 w-24',
                            step: 1,
                            min: 0,
                            max: 100 %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :resource_rating, field_label: 'Resource Rating' do %>
        <%= df.number_field :resource_rating,
                            value: stellar_object.resource_rating,
                            class: 'edit-base sm:w-28 w-24',
                            step: 1,
                            min: 2,
                            max: 12 %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :bulk do %>
        <%= df.number_field :bulk,
                            value: stellar_object.bulk,
                            class: 'edit-base sm:w-28 w-24',
                            step: 1,
                            min: 1 %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :span do %>
        <%= df.number_field :span,
                            value: format_precision(stellar_object.span, precision: 5),
                            class: 'edit-base sm:w-28 w-24',
                            step: 'any',
                            min: -1,
                            max: 1 %>
      <% end %>
    <% end %>

    <!-- Notes stays stacked -->
    <div class='edit-row-notes'>
      <%= form.label :notes, 'Observations', class: 'edit-label' %>
      <%= form.text_area :notes, rows: 6, class: 'edit-base mt-2 w-full resize-y' %>
    </div>

    <div class='pt-2 flex flex-col sm:flex-row gap-2'>
      <%= form.submit 'Update core', class: 'w-full sm:w-auto btn btn-primary' %>
      <%= link_to 'Cancel', stellar_object_path(stellar_object), class: 'w-full sm:w-auto btn' %>
    </div>
  </div>
<% end %>