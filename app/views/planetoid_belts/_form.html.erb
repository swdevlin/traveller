<%# One tab per section of the belt's UWP, as for a planetary body. Orbital and physical are belt-specific
    (planetoid_belts/edit_sections); the rest are shared with other worlds. %>
<%= render 'stellar_objects/tabbed_form', moon: stellar_object,
                                          url: local_assigns[:url] || stellar_object_path(stellar_object),
                                          cancel_url: local_assigns[:cancel_url] || stellar_object_path(stellar_object),
                                          submit_label: local_assigns.fetch(:submit_label, 'Update core'),
                                          section: local_assigns.fetch(:section, @section || 'general') %>
