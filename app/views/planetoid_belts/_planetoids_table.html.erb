<% preload_tags(planetoids) %>
<turbo-frame id="planetoids-table">
  <% significant_form = capture do %>
    <form class="text-sm text-fg">
      <label class="flex items-center gap-1.5 cursor-pointer select-none">
        <input type="checkbox"
               name="significant_only"
               value="1"
               <%= params[:significant_only].present? ? 'checked' : '' %>
               onchange="this.form.requestSubmit()">
        Significant only
      </label>
    </form>
  <% end %>

  <% add_planetoid_button = link_to new_stellar_object_planetoid_path(@stellar_object), class: 'btn-header', title: 'Add planetoid', aria: { label: 'Add planetoid' }, data: { turbo_frame: '_top' } do %>
    <i class="fa-regular fa-plus"></i> Planetoid
  <% end %>

  <%= render 'application/collapsible_table_card',
             title: safe_join(['Planetoids ', tag.span(@planetoid_count, class: 'identifier')]),
             actions: safe_join([significant_form, add_planetoid_button]) do %>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Size</th>
            <th scope="col">Orbit Sequence</th>
            <% if show_orbit_number? %>
              <th scope="col">Orbit</th>
            <% end %>
            <% if show_au? %>
              <th scope="col">AU</th>
            <% end %>
            <th scope="col"></th>
            <th scope="col">UWP</th>
            <th scope="col">Tags</th>
            <th scope="col" class="text-right actions-cell">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if planetoids.empty? %>
            <tr><td colspan="<%= 6 + (show_orbit_number? ? 1 : 0) + (show_au? ? 1 : 0) %>" class="text-fg-muted">No planetoids recorded.</td></tr>
          <% end %>
          <% planetoids.each do |planetoid| %>
            <tr class="cursor-pointer"
                data-controller="row-link"
                data-row-link-url-value="<%= stellar_object_path(planetoid) %>"
                data-action="click->row-link#navigate">
              <td class="whitespace-nowrap">
                <span class="pill"><%= planetoid.size_code %></span>
              </td>
              <td class="whitespace-nowrap">
                <span class="identifier"><%= planetoid.orbit_sequence %></span>
              </td>
              <% if show_orbit_number? %>
                <td class="whitespace-nowrap">
                  <%= number_with_precision(planetoid.orbit, precision: 2, strip_insignificant_zeros: true) %>
                </td>
              <% end %>
              <% if show_au? %>
                <td class="whitespace-nowrap">
                  <%= number_with_precision(planetoid.au, precision: 2, strip_insignificant_zeros: true) %>
                </td>
              <% end %>
              <td class="whitespace-nowrap">
                <% if planetoid.data['native_sophont'] %>
                  <i class='fa-regular fa-user-alien' title='Native sophont'></i>
                <% end %>
                <% if planetoid.data['extinct_sophont'] %>
                  <i class='fa-kit fa-light-user-alien-slash' title='Extinct sophont'></i>
                <% end %>
              </td>
              <td class="whitespace-nowrap">
                <%= planetoid.uwp %>
              </td>
              <td><%= render 'application/tags', record: planetoid %></td>
              <td class="actions-cell">
                <div class="action-group">
                  <%= render 'application/tag_action', record: planetoid, label: planetoid.display_name %>
                  <%= link_to edit_stellar_object_path(planetoid), class: 'action', title: 'Edit planetoid', data: { turbo_frame: '_top' } do %>
                    <i class="fa-regular fa-pen-to-square"></i>
                  <% end %>
                  <%= button_to stellar_object_path(planetoid), method: :delete, class: 'action danger', title: 'Delete planetoid',
                                data: { turbo_confirm: "Delete #{planetoid.display_name}?" } do %>
                    <i class="fa-regular fa-trash"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="w-full pb-4">
        <%== pagy.series_nav %>
      </div>
    </div>
  <% end %>
</turbo-frame>
