<% allegiance = planetoid_belt.allegiance %>
<% star = planetoid_belt.orbiting_star %>
<% star_system = star&.star_system %>
<% parsec = planetoid_belt.parsec || star_system&.parsec %>
<% subsector = parsec&.subsector %>
<% sector = parsec&.sector %>

<% allegiance_value =
     if allegiance
       safe_join([
                   allegiance.name,
                   content_tag(:span, allegiance.code, class: "identifier")
                 ])
     else
       "None"
     end
%>

<div id="<%= dom_id planetoid_belt %>" class="space-y-6">
  <div class="mt-5 grid grid-cols-1 gap-2 sm:grid-cols-5">
    <% if star %>
      <%= render 'application/data_block',
                 label: 'Orbiting',
                 value: link_to(star.display_name,
                                star_path(star),
                                class: 'hover:underline underline-offset-4') %>
    <% end %>
    <% if star_system %>
      <%= render 'application/data_block',
                 label: 'Star System',
                 value: link_to(star_system.display_name,
                                star_system_path(star_system),
                                class: 'hover:underline underline-offset-4') %>
    <% end %>

    <% if subsector %>
      <%= render 'application/data_block',
                 label: 'Subsector',
                 value: link_to(subsector.name,
                                subsector_path(subsector),
                                class: 'hover:underline underline-offset-4') %>
    <% end %>

    <% if sector %>
      <%= render 'application/data_block',
                 label: 'Sector',
                 value: link_to(
                   sector.name,
                   sector_path(sector),
                   class: 'hover:underline underline-offset-4'
                 ),
                 value_wrap_class: 'flex flex-wrap items-center gap-2',
                 suffix: tag.span(parsec.hex_code, class: 'identifier') %>
    <% end %>

    <%= render 'application/data_block',
               label: 'Allegiance',
               value: allegiance_value %>
  </div>

  <% if star %>
    <div class="flex items-center gap-2 pt-2">
      <div class="text-xs uppercase tracking-[0.22em] text-deepnight-orange">
        Orbital Data
      </div>
      <div class="h-px flex-1 bg-slate-700/70"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2">
      <%= render 'application/data_block', label: 'Orbit', value: number_with_precision(planetoid_belt.orbit, precision: 2, strip_insignificant_zeros: true) %>
      <%= render 'application/data_block', label: 'AU', value: number_with_precision(planetoid_belt.au, precision: 2, strip_insignificant_zeros: true) %>
      <%= render 'application/data_block', label: 'Period', value: number_with_precision(planetoid_belt.period, precision: 2, strip_insignificant_zeros: true), suffix: 'days' %>
      <%= render 'application/data_block', label: 'Effective HZCO Deviation', value: number_with_precision(planetoid_belt.effective_hzco_deviation, precision: 2, strip_insignificant_zeros: true) %>
      <%= render 'application/data_block', label: 'Retrograde', value: planetoid_belt.retrograde ? 'Yes' : 'No' %>
      <%= render 'application/data_block', label: 'Inclination', value: number_with_precision(planetoid_belt.inclination, precision: 2, strip_insignificant_zeros: true), suffix: '°' %>
      <%= render 'application/data_block', label: 'Eccentricity', value: number_with_precision(planetoid_belt.eccentricity, precision: 2, strip_insignificant_zeros: true) %>
    </div>

    <%= render 'stellar_objects/jump_shadow_times', stellar_object: planetoid_belt %>
  <% end %>

  <div class="flex items-center gap-2">
    <div class="text-xs uppercase tracking-[0.22em] text-deepnight-orange">
      Belt Composition
    </div>
    <div class="h-px flex-1 bg-slate-700/70"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2">
    <%= render 'application/data_block', label: 'M-Type', value: planetoid_belt.m_type %>
    <%= render 'application/data_block', label: 'S-Type', value: planetoid_belt.s_type %>
    <%= render 'application/data_block', label: 'C-Type', value: planetoid_belt.c_type %>
    <%= render 'application/data_block', label: 'O-Type', value: planetoid_belt.o_type %>
  </div>

  <div class="flex items-center gap-2">
    <div class="text-xs uppercase tracking-[0.22em] text-deepnight-orange">
      Belt Data
    </div>
    <div class="h-px flex-1 bg-slate-700/70"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2">
    <%= render 'application/data_block', label: 'Resource Rating', value: planetoid_belt.resource_rating %>
    <%= render 'application/data_block', label: 'Bulk', value: planetoid_belt.bulk %>
    <%= render 'application/data_block', label: 'Span', value: number_with_precision(planetoid_belt.span, precision: 2, strip_insignificant_zeros: true) %>
    <%= render 'application/data_block', label: 'Temperature', value: format_temperature_celsius(planetoid_belt.temperature), suffix: '°C' %>
    <%= render 'application/data_block', label: 'Period', value: number_with_precision(planetoid_belt.period, precision: 2, strip_insignificant_zeros: true), suffix: 'days' %>
    <%= render 'application/data_block', label: 'Significant Bodies', value: planetoid_belt.significant_bodies.length %>
  </div>

  <%= render 'application/observation_block',
             notes: planetoid_belt.notes %>
</div>
