<div class="space-y-4">
  <%= render 'application/subsection', title: 'Belt Data' %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-2">
    <%= render 'application/data_block',
               label: 'Resource Rating',
               value: safe_join([tag.span(HexDigit.hex_digit(stellar_object.resource_rating), class: 'identifier-sm'), resource_rating_description(stellar_object.resource_rating)], ' '),
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    <%= render 'application/data_block', label: 'Bulk', value: stellar_object.bulk %>
    <%= render 'application/data_block', label: 'Span', value: number_with_precision(stellar_object.span, precision: 2, strip_insignificant_zeros: true) %>
    <%= render 'application/data_block', label: 'Significant Bodies', value: stellar_object.significant_bodies.count %>
  </div>

  <%= render 'application/subsection', title: 'Belt Composition' %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-2">
    <%= render 'application/data_block', label: 'Metallic', value: stellar_object.m_type, suffix: ' %' %>
    <%= render 'application/data_block', label: 'Stony', value: stellar_object.s_type, suffix: ' %' %>
    <%= render 'application/data_block', label: 'Carbonaceous', value: stellar_object.c_type, suffix: ' %' %>
    <%= render 'application/data_block', label: 'Other', value: stellar_object.o_type, suffix: ' %' %>
  </div>
</div>
