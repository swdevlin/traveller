<%= form_with(model: ship, class: 'contents') do |form| %>
  <div class='space-y-6 pb-10'>
    <% if ship.errors.any? %>
      <div class='rounded-2xl border border-traveller-red/40 bg-slate-950/60 p-4'>
        <div class='text-xs uppercase tracking-[0.22em] text-slate-400'>
          Validation
        </div>
        <div class='mt-1 text-sm font-semibold text-slate-200'>
          <%= pluralize(ship.errors.count, 'error') %> prevented this ship from being saved
        </div>

        <ul class='mt-3 list-disc ml-6 text-sm text-slate-300 space-y-1'>
          <% ship.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class='mt-4'>
      <%= form.label :name, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.text_field :name,
                          class: [
                            'w-full edit-base mt-2 sm:w-1/2',
                            {
                              'border-gray-400 focus:outline-blue-600': ship.errors[:name].none?,
                              'border-red-400 focus:outline-red-600': ship.errors[:name].any?
                            }
                          ] %>
    </div>

    <div>
      <%= form.label :jump_drive, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.number_field :jump_drive,
                          class: [
                            'w-full edit-base mt-2 sm:w-1/2',
                            {
                              'border-gray-400 focus:outline-blue-600': ship.errors[:jump_drive].none?,
                              'border-red-400 focus:outline-red-600': ship.errors[:jump_drive].any?
                            }
                          ] %>
    </div>

    <div class='pt-2 flex flex-col sm:flex-row gap-2'>
      <%= form.submit 'Update core', class: 'w-full sm:w-auto btn btn-primary' %>
      <%= link_to 'Cancel', ship.persisted? ? ship : ships_path, class: 'w-full sm:w-auto btn' %>
    </div>
  </div>
<% end %>
