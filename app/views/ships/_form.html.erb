<%= form_with(model: ship, class: 'contents') do |form| %>
  <div class='space-y-6 pb-10'>
    <% if ship.errors.any? %>
      <div class='card accent'>
        <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>
          Validation
        </div>
        <div class='mt-1 text-sm font-semibold text-fg-bright'>
          <%= pluralize(ship.errors.count, 'error') %> prevented this ship from being saved
        </div>

        <ul class='mt-3 list-disc ml-6 text-sm text-fg space-y-1'>
          <% ship.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class='mt-4'>
      <%= form.label :name, class: 'text-xs uppercase tracking-[0.22em] text-fg-muted' %>
      <%= form.text_field :name,
                          class: 'w-full edit-base mt-2 sm:w-1/2', aria: { invalid: ship.errors[:name].any? } %>
    </div>

    <div>
      <%= form.label :jump_drive, class: 'text-xs uppercase tracking-[0.22em] text-fg-muted' %>
      <%= form.number_field :jump_drive,
                          class: 'w-full edit-base mt-2 sm:w-1/2', aria: { invalid: ship.errors[:jump_drive].any? } %>
    </div>

    <div>
      <%= form.label :m_drive, class: 'text-xs uppercase tracking-[0.22em] text-fg-muted' %>
      <%= form.number_field :m_drive, in: 0..10,
                            class: 'w-full edit-base mt-2 sm:w-1/2', aria: { invalid: ship.errors[:m_drive].any? } %>
    </div>

    <div class='form-actions pt-2'>
      <%= form.submit 'Update core', class: 'btn btn-primary' %>
      <%= link_to 'Cancel', ship.persisted? ? ship : ships_path, class: 'btn' %>
    </div>
  </div>
<% end %>
