<% government = stellar_object.respond_to?(:government) && stellar_object.government ? Government.find_by(code: stellar_object.government.code) : nil %>
<% law_level = stellar_object.respond_to?(:law_level) && stellar_object.law_level ? LawLevel.find_by(code: stellar_object.law_level.code) : nil %>
<% tech_level_record = stellar_object.respond_to?(:tech_level_code) && stellar_object.tech_level_code.present? ? TechLevel.find_by(code: stellar_object.tech_level_code) : nil %>

<%= render 'application/subsection', title: 'Station Profile' %>

<div class="grid grid-cols-2 gap-3">
  <%= render 'application/data_block', label: 'Allegiance', value: stellar_object.allegiance&.name || 'None' %>

  <% if government %>
    <%= render 'application/data_block',
               label: 'Government',
               value: safe_join([tag.span(HexDigit.hex_digit(government.code), class: 'identifier-sm'), government.government_type], ' '),
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
  <% end %>

  <% if law_level %>
    <%= render 'application/data_block',
               label: 'Law Level',
               value: safe_join([tag.span(HexDigit.hex_digit(law_level.code), class: 'identifier-sm'), law_level.weapons], ' '),
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
  <% end %>

  <% if tech_level_record %>
    <%= render 'application/data_block',
               label: 'Tech Level',
               value: tag.span(HexDigit.hex_digit(tech_level_record.code), class: 'identifier-sm') %>
    <%= render 'application/data_block',
               label: 'Descriptor',
               value: tech_level_record.descriptor %>
  <% end %>
</div>

<%= render 'stellar_objects/jump_shadow_times', stellar_object: stellar_object, times_only: true %>
