<%= content_for :title, 'Jump logs' %>
<%= content_for :page_kicker, 'Ship Records' %>
<%= content_for :page_title, 'Jump Logs' %>

<%= render 'application/page' do %>
  <div class='table-card'>
    <div class='table-banner'>
      <p>Jump log registry</p>

      <div class='actions'>
        <%= link_to new_jump_log_path, class: 'btn-header' do %>
          <i class='fa-regular fa-plus'></i>
          Add
        <% end %>
      </div>
    </div>

    <div class='table-scroll'>
      <table>

        <thead>
          <tr>
            <th scope='col'>Ship</th>
            <th scope='col'>Depart</th>
            <th scope='col'>From</th>
            <th scope='col'>Arrive</th>
            <th scope='col'>In</th>
            <th scope='col' class='text-right actions-cell'>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @jump_logs.each do |jump_log| %>
            <tr class='cursor-pointer'
                data-controller='row-link'
                data-row-link-url-value='<%= jump_log_path(jump_log) %>'
                data-action='click->row-link#navigate'>
              <td><%= link_to jump_log.ship.name, ship_path(jump_log.ship), class: 'no-underline hover:underline' %></td>
              <td class='whitespace-nowrap'>
                <% if jump_log.depart_year %>
                  <%= jump_log.depart_year %>-<%= format('%03d', jump_log.depart_day || 0) %>
                <% end %>
              </td>
              <td class='whitespace-nowrap'>
                <%= link_to jump_log.from_parsec.sector.name, sector_path(jump_log.from_parsec.sector), class: 'no-underline hover:underline' %>
                (<%= link_to jump_log.from_parsec.hex_code, parsec_path(jump_log.from_parsec), class: 'no-underline hover:underline' %>)
              </td>
              <td class='whitespace-nowrap'>
                <% if jump_log.arrive_year %>
                  <%= jump_log.arrive_year %>-<%= format('%03d', jump_log.arrive_day || 0) %>
                <% end %>
              </td>
              <td class='whitespace-nowrap'>
                <%= link_to jump_log.to_parsec.sector.name, sector_path(jump_log.to_parsec.sector), class: 'no-underline hover:underline' %>
                (<%= link_to jump_log.to_parsec.hex_code, parsec_path(jump_log.to_parsec), class: 'no-underline hover:underline' %>)
                <% if jump_log.misjump? %>
                  <i class='fa-regular fa-triangle-exclamation text-amber-400 ml-1' title='Misjump'></i>
                <% end %>
              </td>
              <td class='actions-cell'>
                <div class='action-group'>
                  <%= link_to edit_jump_log_path(jump_log), class: 'action' do %>
                    <i class='fa-regular fa-pen-to-square'></i>
                  <% end %>

                  <%= button_to jump_log,
                                method: :delete,
                                class: 'action danger',
                                data: { turbo_confirm: 'Delete this jump log?' } do %>
                    <i class='fa-regular fa-trash'></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <div class='w-full pb-4'>
        <%== @pagy.series_nav %>
      </div>
    </div>
  </div>
<% end %>
