<% content_for :title, "Stellar objects" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 border border-notice-outline bg-notice-bg mb-5 text-notice-fg font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Stellar objects</h1>
    <%= link_to "New stellar object", new_stellar_object_path, class: "btn btn-primary" %>
  </div>

  <div id="stellar_objects" class="min-w-full divide-y divide-outline space-y-5">
    <% if @stellar_objects.any? %>
      <% @stellar_objects.each do |stellar_object| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render stellar_object %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Show", stellar_object, class: "btn" %>
            <%= link_to "Edit", edit_stellar_object_path(stellar_object), class: "btn" %>
            <%= button_to "Destroy", stellar_object, method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No stellar objects found.</p>
    <% end %>
  </div>
</div>
