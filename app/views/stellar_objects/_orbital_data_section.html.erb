<% show_allegiance = local_assigns.fetch(:show_allegiance, true) %>
<% show_known_toggle = local_assigns.fetch(:show_known_toggle, true) %>

<% allegiance = stellar_object.allegiance if show_allegiance %>
<% star = stellar_object.orbiting %>
<% star_system = stellar_object.orbiting_star_system %>
<% parsec = stellar_object.location_parsec %>
<% subsector = stellar_object.location_subsector %>
<% sector = stellar_object.location_sector %>

<% allegiance_value = allegiance_badge(allegiance) if show_allegiance %>

<div id="<%= dom_id stellar_object %>" class="space-y-4">
  <% if star %>
    <div class="space-y-2">
      <%= render 'application/subsection', title: 'Orbital Data' %>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2">
        <% if show_orbit_number? %>
          <%= render 'application/data_block', label: 'Orbit', value: number_with_precision(stellar_object.orbit, precision: 2, strip_insignificant_zeros: true) %>
        <% end %>
        <% if show_au? %>
          <%= render 'application/data_block', label: 'AU', value: number_with_precision(stellar_object.au, precision: 2, strip_insignificant_zeros: true) %>
        <% end %>
        <%= render 'application/data_block', label: 'Effective HZCO Deviation', value: number_with_precision(stellar_object.effective_hzco_deviation, precision: 2, strip_insignificant_zeros: true) %>
        <%= render 'application/data_block', label: 'Inclination', value: number_with_precision(stellar_object.inclination, precision: 2, strip_insignificant_zeros: true), suffix: '°' %>
        <%= render 'application/data_block', label: 'Eccentricity', value: number_with_precision(stellar_object.eccentricity, precision: 2, strip_insignificant_zeros: true) %>
        <%= render 'application/data_block',
                   label: 'Orbiting',
                   value: link_to(star.display_name, star_path(star), class: 'no-underline hover:underline') %>
        <% if star_system %>
          <%= render 'application/data_block',
                     label: 'Star System',
                     value: link_to(star_system.display_name, star_system_path(star_system), class: 'no-underline hover:underline') %>
        <% end %>
        <% if subsector %>
          <%= render 'application/data_block',
                     label: 'Subsector',
                     value: link_to(subsector.name, subsector_path(subsector), class: 'no-underline hover:underline') %>
        <% end %>
        <% if sector %>
          <%= render 'application/data_block',
                     label: 'Sector',
                     value: link_to(sector.name, sector_path(sector), class: 'no-underline hover:underline'),
                     value_wrap_class: 'flex flex-wrap items-center gap-2',
                     suffix: tag.span(parsec.hex_code, class: 'identifier') %>
        <% end %>
        <% if show_allegiance %>
          <%= render 'application/data_block', label: 'Allegiance', value: allegiance_value %>
        <% end %>
      </div>

      <% shadow_km = stellar_object.effective_jump_shadow_km %>
      <% if shadow_km&.positive? %>
        <% shadow_source = stellar_object.effective_jump_shadow_source %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2">
          <%= render 'application/data_block',
                     label: 'Jump Shadow',
                     value: number_with_delimiter(number_with_precision(shadow_km, precision: 0)),
                     suffix: 'km' %>
          <% if shadow_source %>
            <% source_path = shadow_source.is_a?(Star) ? star_path(shadow_source) : stellar_object_path(shadow_source) %>
            <%= render 'application/data_block',
                       label: 'Shadow Source',
                       value: link_to(shadow_source.display_name, source_path, class: 'no-underline hover:underline') %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-5">
      <% if subsector %>
        <%= render 'application/data_block',
                   label: 'Subsector',
                   value: link_to(subsector.name, subsector_path(subsector), class: 'no-underline hover:underline') %>
      <% end %>
      <% if sector %>
        <%= render 'application/data_block',
                   label: 'Sector',
                   value: link_to(sector.name, sector_path(sector), class: 'no-underline hover:underline'),
                   value_wrap_class: 'flex flex-wrap items-center gap-2',
                   suffix: tag.span(parsec.hex_code, class: 'identifier') %>
      <% end %>
      <% if show_allegiance %>
        <%= render 'application/data_block', label: 'Allegiance', value: allegiance_value %>
      <% end %>
    </div>
  <% end %>

  <%= yield %>

  <% if show_known_toggle %>
    <%= render 'stellar_objects/known_toggle', stellar_object: stellar_object %>
  <% end %>
  <%= render 'application/observation_block', notes: stellar_object.notes %>
</div>
