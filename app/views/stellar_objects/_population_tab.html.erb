<%
  population_code = stellar_object.population&.dig('code')
  census_population = stellar_object.population&.dig('censusPopulation')
  concentration_rating = stellar_object.population&.dig('concentrationRating')
  urbanization_percentage = stellar_object.population&.dig('urbanizationPercentage')
  major_city_population = stellar_object.population_major_city_population
  show_sophont = stellar_object.respond_to?(:native_sophont)
%>
<div class="space-y-4">
  <%= render 'application/subsection', title: 'Population' %>

  <% if population_code.present? || show_sophont %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <% if population_code.present? %>
        <%= render 'application/data_block',
                   label: 'Population',
                   value: safe_join([tag.span(HexDigit.hex_digit(population_code), class: 'identifier-sm'), population_display(population_code, census_population)].compact, ' ') %>
        <% if concentration_rating.present? %>
          <%= render 'application/data_block',
                     label: 'Concentration',
                     value: safe_join([tag.span(concentration_rating, class: 'identifier-sm'), concentration_rating_description(concentration_rating)].compact, ' ') %>
        <% end %>
      <% end %>
      <% if show_sophont %>
        <%= render 'application/data_block', label: 'Native Sophont', value: stellar_object.native_sophont ? 'Yes' : 'No' %>
        <%= render 'application/data_block', label: 'Extinct Sophont', value: stellar_object.extinct_sophont ? 'Yes' : 'No' %>
      <% end %>
    </div>
  <% end %>

  <% if urbanization_percentage.present? || major_city_population.present? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <% if urbanization_percentage.present? %>
        <%= render 'application/data_block', label: 'Urbanisation', value: "#{urbanization_percentage}%" %>
      <% end %>
      <% if major_city_population.present? %>
        <%= render 'application/data_block', label: 'Major City Population', value: number_with_delimiter(major_city_population) %>
      <% end %>
    </div>
  <% end %>

  <% if stellar_object.respond_to?(:population_diversity) && StellarObjectsHelper::CULTURE_TRAIT_DATA.any? { |t| stellar_object.send(t[:getter]).present? } %>
    <%= render 'application/subsection', title: 'Culture' %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <% StellarObjectsHelper::CULTURE_TRAIT_DATA.each do |trait| %>
        <% val = stellar_object.send(trait[:getter]) %>
        <% next unless val.present? %>
        <%= render 'application/data_block',
                   label: trait[:label],
                   value: render(
                     'application/trait_gauge',
                     value: val,
                     min: trait[:min],
                     max: trait[:max],
                     low_label: trait[:low_label],
                     high_label: trait[:high_label],
                     description: trait[:description]
                   ),
                   value_wrap_class: 'flex flex-wrap items-center gap-2' %>
      <% end %>
    </div>
  <% end %>

  <% if stellar_object.respond_to?(:habitability_rating) %>
    <%= render 'application/subsection', title: 'Biological Data' %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <% if stellar_object.habitability_rating.present? %>
        <%= render 'application/data_block',
                   label: 'Habitability Rating',
                   value: safe_join([tag.span(stellar_object.habitability_rating, class: 'identifier-sm'), habitability_rating_description(stellar_object.habitability_rating)], ' '),
                   value_wrap_class: 'flex flex-wrap items-center gap-2' %>
      <% end %>
      <%= render 'application/data_block', label: 'Biomass Rating', value: stellar_object.biomass_rating %>
      <% if stellar_object.biodiversity_rating.present? %>
        <%= render 'application/data_block',
                   label: 'Biodiversity Rating',
                   value: safe_join([tag.span(HexDigit.hex_digit(stellar_object.biodiversity_rating), class: 'identifier-sm'), biodiversity_description(stellar_object.biodiversity_rating)], ' '),
                   value_wrap_class: 'flex flex-wrap items-center gap-2' %>
      <% end %>
      <% if stellar_object.biocomplexity_rating.present? %>
        <%= render 'application/data_block',
                   label: 'Biocomplexity Rating',
                   value: safe_join([tag.span(stellar_object.biocomplexity_rating, class: 'identifier-sm'), biocomplexity_description(stellar_object.biocomplexity_rating)], ' '),
                   value_wrap_class: 'flex flex-wrap items-center gap-2' %>
      <% end %>
      <% if stellar_object.resource_rating.present? %>
        <%= render 'application/data_block',
                   label: 'Resource Rating',
                   value: safe_join([tag.span(HexDigit.hex_digit(stellar_object.resource_rating), class: 'identifier-sm'), resource_rating_description(stellar_object.resource_rating)], ' '),
                   value_wrap_class: 'flex flex-wrap items-center gap-2' %>
      <% end %>
    </div>
  <% end %>
</div>
