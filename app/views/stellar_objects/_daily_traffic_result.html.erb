<div class='space-y-4'>
  <% if traffic %>
    <div class='text-center py-3'>
      <div class='text-5xl font-bold <%= traffic.result == 0 ? "text-fg-muted" : "text-highlight-fg" %>'>
        <%= traffic.result %>
      </div>
      <div class='text-xs uppercase tracking-[0.22em] text-fg-muted mt-1'>Ships</div>
    </div>

    <% if traffic.result > 0 %>
      <div class='grid grid-cols-1 sm:grid-cols-2 gap-4'>
        <%= render 'application/data_block', label: 'Effective Importance', value: format_importance(traffic.effective_importance) %>
        <%= render 'application/data_block', label: 'Classification',       value: traffic.tier_label %>
      </div>
    <% end %>

    <% if traffic.modifiers.any? %>
      <p class='text-xs text-fg-muted'>Modifiers applied: <%= traffic.modifiers.join(', ') %></p>
    <% end %>
  <% end %>

  <%= form_with url: generate_daily_traffic_stellar_object_path(stellar_object), method: :post,
               data: { controller: 'stop-propagation', action: 'turbo:submit-end->stop-propagation#stop' } do |f| %>
    <div class='flex items-center gap-4'>
      <div data-controller='boolean-toggle' class='flex items-center gap-3'>
        <%= check_box_tag :frontier, '1', frontier,
                          class: 'sr-only',
                          data: { boolean_toggle_target: 'checkbox' } %>
        <button type='button'
                role='switch'
                aria-checked='<%= frontier %>'
                data-action='boolean-toggle#toggle boolean-toggle#submitForm'
                data-boolean-toggle-target='button'
                class='toggle'>
          <span data-boolean-toggle-target='indicator'></span>
        </button>
        <span class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Frontier world</span>
      </div>
      <%= f.submit 'Roll Again', class: 'btn btn-secondary btn-sm' %>
    </div>
  <% end %>
</div>