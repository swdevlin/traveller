<% effective_shadow = local_assigns[:stellar_object]&.effective_jump_shadow_km || 0 %>
<% shadow_source = local_assigns[:stellar_object]&.effective_jump_shadow_source %>

<% if effective_shadow > 0 %>
  <div class="flex items-center gap-4">
    <div class="text-xs uppercase tracking-[0.22em] text-deepnight-orange">
      Jump Shadow
    </div>
    <div class="h-px flex-1 bg-slate-700/70"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    <%= render 'application/data_block',
               label: 'Distance to Clear',
               value: number_with_delimiter(number_with_precision(effective_shadow, precision: 0)),
               suffix: 'km' %>
    <% if shadow_source %>
      <% source_path = shadow_source.is_a?(Star) ? star_path(shadow_source) : stellar_object_path(shadow_source) %>
      <%= render 'application/data_block',
                 label: 'Shadow Source',
                 value: link_to(shadow_source.display_name, source_path,
                                class: 'no-underline hover:underline hover:underline-offset-2') %>
    <% end %>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mt-4">
    <% jump_shadow_travel_times(effective_shadow).each do |g, time| %>
      <%= render 'application/data_block', label: "#{g}G", value: time %>
    <% end %>
  </div>
<% end %>
