<%# locals: stellar_object, section %>
<% sections = [['general', 'General'], ['orbital', 'Orbital'], ['starport', 'Starport'], ['physical', 'Physical'], ['atmosphere', 'Atmo'],
               ['hydrographics', 'Hydro'], ['population', 'Pop'], ['government', 'Gov'], ['law_level', 'Law'], ['tech_level', 'Tech']] %>
<% sections = sections.select { |id, _| stellar_object.edit_sections.include?(id) } %>
<% sections = sections.reject { |id, _| id == 'orbital' } unless stellar_object.orbiting %>
<div class='uwp-tab-bar mb-4'>
  <% sections.each do |id, label| %>
    <%= link_to label, edit_stellar_object_path(stellar_object, section: id),
          class: "uwp-tab-btn no-underline hover:underline #{id == section ? 'uwp-tab-active' : 'uwp-tab-inactive'}" %>
  <% end %>
</div>
