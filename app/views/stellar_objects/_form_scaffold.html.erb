<%= form_with(model: stellar_object, scope: :stellar_object, url: local_assigns[:url] || stellar_object_path(stellar_object), class: "contents") do |form| %>
  <div class="<%= local_assigns.fetch(:wrapper_class, 'space-y-2') %>">
    <%= render 'application/form_errors', errors: stellar_object.errors.where(:base) %>

    <%= hidden_field_tag :section, local_assigns[:section] if local_assigns[:section] %>

    <% show_core = local_assigns.fetch(:show_core_fields, true) %>
    <%= render 'application/name_generator_field', form: form if show_core %>

    <%= yield form %>

    <% if show_core && local_assigns.fetch(:show_known_field, true) %>
      <%= render 'stellar_objects/known_field', form: form, stellar_object: stellar_object %>
    <% end %>

    <% if show_core %>
    <%= render 'application/records_fields', form: form, record: stellar_object, wrapper_class: local_assigns[:notes_wrapper_class] %>
    <div>
      <%= render 'application/edit_field', form: form, attribute: :reference_url, field_label: 'Reference link' do %>
        <%= form.text_field :reference_url, class: 'w-full edit-base',
                                                  placeholder: form.object.derived_reference_url(current_campaign) %>
      <% end %>
    </div>
    <% end %>

    <div class="pt-2 flex flex-col sm:flex-row gap-2">
      <%= form.submit local_assigns[:submit_label] || 'Update core', class: 'w-full sm:w-auto btn btn-primary' %>
      <%= link_to 'Cancel', local_assigns[:cancel_url] || stellar_object_path(stellar_object), class: 'w-full sm:w-auto btn' %>
    </div>
  </div>
<% end %>
