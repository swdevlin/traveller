<% code = stellar_object.starport_code.presence || 'X' %>
<% starport = StellarObjectsHelper::STARPORT_DATA[code] || StellarObjectsHelper::STARPORT_DATA['X'] %>

<div class="space-y-4">
  <%= render 'application/subsection', title: 'Starport' %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    <%= render 'application/data_block',
               label: 'Starport',
               value: safe_join([tag.span(code, class: 'identifier-sm'), starport[:quality]], ' '),
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    <%= render 'application/data_block', label: 'Fuel', value: starport[:fuel] %>
    <%= render 'application/data_block', label: 'Facilities', value: starport[:facilities] %>
  </div>

  <% if stellar_object.world_trade_number.present? || stellar_object.total_gwp.present? %>
    <%= render 'application/subsection', title: 'Economics' %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <% if stellar_object.world_trade_number.present? %>
        <%= render 'application/data_block', label: 'World Trade Number', value: stellar_object.world_trade_number %>
      <% end %>
      <% if stellar_object.importance.present? %>
        <%= render 'application/data_block', label: 'Importance', value: format_importance(stellar_object.importance) %>
      <% end %>
      <% if stellar_object.development_score.present? %>
        <%= render 'application/data_block', label: 'Development Score', value: number_with_precision(stellar_object.development_score, precision: 1) %>
      <% end %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <% if stellar_object.per_capita_gwp.present? %>
        <%= render 'application/data_block', label: 'Per Capita GWP', value: format_gwp(stellar_object.per_capita_gwp) %>
      <% end %>
      <% if stellar_object.total_gwp.present? %>
        <%= render 'application/data_block', label: 'Total GWP', value: format_gwp(stellar_object.total_gwp) %>
      <% end %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <% if stellar_object.infrastructure.present? %>
        <%= render 'application/data_block', label: 'Infrastructure', value: stellar_object.infrastructure %>
      <% end %>
      <% if stellar_object.resource_units.present? %>
        <%= render 'application/data_block', label: 'Resource Units', value: stellar_object.resource_units %>
      <% end %>
      <% if stellar_object.resource_factor.present? %>
        <%= render 'application/data_block', label: 'Resource Factor', value: stellar_object.resource_factor %>
      <% end %>
      <% if stellar_object.labour_factor.present? %>
        <%= render 'application/data_block', label: 'Labour Factor', value: stellar_object.labour_factor %>
      <% end %>
      <% if stellar_object.efficiency.present? %>
        <%= render 'application/data_block', label: 'Efficiency', value: stellar_object.efficiency %>
      <% end %>
      <% if stellar_object.inequality_rating.present? %>
        <%= render 'application/data_block', label: 'Inequality Rating', value: stellar_object.inequality_rating %>
      <% end %>
    </div>

    <% if stellar_object.tariff_rate.present? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <% if stellar_object.tariff_regime.present? %>
          <%= render 'application/data_block', label: 'Tariff Regime', value: stellar_object.tariff_regime.humanize %>
        <% end %>
        <%= render 'application/data_block', label: 'Tariff Rate', value: number_to_percentage(stellar_object.tariff_rate, precision: 0) %>
      </div>
    <% end %>
  <% end %>
</div>
