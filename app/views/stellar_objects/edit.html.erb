<%
  type_help = "#{@stellar_object.type.underscore}_edit"
  help_template = lookup_context.template_exists?("help/#{type_help}", [], false) ? type_help : 'stellar_objects_edit'
%>
<% content_for :help_path, help_page_path(help_template) %>
<%= content_for :title, "Editing #{@stellar_object.display_name}" %>
<%= content_for :page_kicker, "#{@stellar_object.type_title} Data Core" %>
<%= content_for :page_title, @stellar_object.display_name %>

<%= render 'application/page' do %>
  <%= render "#{@stellar_object.class.model_name.collection}/form", stellar_object: @stellar_object %>
<% end %>
