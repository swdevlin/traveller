<% hydrographics = stellar_object.hydrographics %>
<% hydro_code = hydrographics.present? ? hydrographics['code'] : nil %>
<% distribution = hydrographics&.dig('distribution') %>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
  <% if hydro_code %>
    <%= render 'application/data_block',
               label: 'Hydrographics',
               value: safe_join([tag.span(HexDigit.hex_digit(hydro_code), class: 'identifier-sm'), hydrographics_description(hydro_code)], ' '),
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    <%= render 'application/data_block',
               label: 'Liquid',
               value: hydrographics['liquid'],
               value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    <% if distribution.present? %>
      <%= render 'application/data_block',
                 label: 'Distribution',
                 value: safe_join([tag.span(HexDigit.hex_digit(distribution), class: 'identifier-sm'), hydrographics_distribution_description(distribution)], ' '),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    <% end %>
  <% else %>
    <div class="text-slate-500 text-sm col-span-full">No hydrographic data recorded.</div>
  <% end %>
</div>
