<% tech = stellar_object.tech_level_code.present? ? TechLevel.find_by(code: stellar_object.tech_level_code) : nil %>

<% if tech %>
  <div class="space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <%= render 'application/data_block',
                 label: 'Tech Level',
                 value: safe_join([tag.span(HexDigit.hex_digit(tech.code), class: 'identifier-sm'), tech.descriptor], ' '),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
      <%= render 'application/data_block', label: 'Era', value: tech.short_description %>
    </div>

    <%= render 'application/subsection', title: 'Capabilities' %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <% if tech.electronics.present? %>
        <%= render 'application/data_block', label: 'Electronics', value: tech.electronics %>
      <% end %>
      <% if tech.energy.present? %>
        <%= render 'application/data_block', label: 'Energy', value: tech.energy %>
      <% end %>
      <% if tech.land.present? %>
        <%= render 'application/data_block', label: 'Land', value: tech.land %>
      <% end %>
      <% if tech.sea.present? %>
        <%= render 'application/data_block', label: 'Sea', value: tech.sea %>
      <% end %>
      <% if tech.air.present? %>
        <%= render 'application/data_block', label: 'Air', value: tech.air %>
      <% end %>
      <% if tech.space.present? %>
        <%= render 'application/data_block', label: 'Space', value: tech.space %>
      <% end %>
      <% if tech.personal_military.present? %>
        <%= render 'application/data_block', label: 'Personal Military', value: tech.personal_military %>
      <% end %>
      <% if tech.heavy_military.present? %>
        <%= render 'application/data_block', label: 'Heavy Military', value: tech.heavy_military %>
      <% end %>
      <% if tech.manufacturing.present? %>
        <%= render 'application/data_block', label: 'Manufacturing', value: tech.manufacturing %>
      <% end %>
      <% if tech.medical.present? %>
        <%= render 'application/data_block', label: 'Medical', value: tech.medical %>
      <% end %>
      <% if tech.environmental.present? %>
        <%= render 'application/data_block', label: 'Environmental', value: tech.environmental %>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="text-slate-500 text-sm">No tech level data recorded.</div>
<% end %>
