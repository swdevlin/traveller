<div id="<%= dom_id stellar_object %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Orbit x:</strong>
    <%= stellar_object.orbit_x %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Orbit y:</strong>
    <%= stellar_object.orbit_y %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Parsec:</strong>
    <%= stellar_object.Parsec_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Solarsystem:</strong>
    <%= stellar_object.SolarSystem_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Inclination:</strong>
    <%= stellar_object.inclination %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Eccentricity:</strong>
    <%= stellar_object.eccentricity %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Orbit:</strong>
    <%= stellar_object.orbit %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Effective hzco deviation:</strong>
    <%= stellar_object.effective_hzco_deviation %>
  </div>
</div>
