<%# locals: moon, url, cancel_url, submit_label: 'Commit core', section: 'general' (moon is any planetary body) %>
<%# Every section of a planetary body's edit form, one tab each, in a single form so a new moon can be filled in
    completely before it is saved. %>
<%
  section_labels = { 'general' => 'General', 'orbital' => 'Orbital', 'starport' => 'Starport', 'physical' => 'Physical',
                     'atmosphere' => 'Atmo', 'hydrographics' => 'Hydro', 'population' => 'Pop', 'government' => 'Gov',
                     'law_level' => 'Law', 'tech_level' => 'Tech' }
  sections = moon.edit_sections
  sections -= ['orbital'] unless moon.orbiting
  # A body type can override a section with its own partial under <collection>/edit_sections.
  section_partial = lambda do |section|
    own = "#{moon.class.model_name.collection}/edit_sections/#{section}"
    lookup_context.exists?(own, [], true) ? own : "stellar_objects/edit_sections/#{section}"
  end
%>
<%= form_with(model: moon, scope: :stellar_object, url: url, class: 'contents') do |form| %>
  <div class='space-y-2 pb-10' data-controller='tabs' data-tabs-default-value='<%= local_assigns.fetch(:section, 'general') %>'>
    <%= render 'application/form_errors', errors: moon.errors %>

    <div class='uwp-tab-bar mb-4'>
      <% sections.each do |section| %>
        <button type='button'
                class='uwp-tab-btn uwp-tab-inactive'
                data-tabs-target='tab'
                data-tab='<%= section %>'
                data-action='click->tabs#switch'>
          <%= section_labels.fetch(section) %>
        </button>
      <% end %>
    </div>

    <% sections.each do |section| %>
      <div data-tabs-target='panel' data-tab='<%= section %>' class='hidden space-y-2'>
        <% if section == 'general' %>
          <%= render 'application/name_generator_field', form: form %>

          <%= render 'stellar_objects/known_field', form: form, stellar_object: moon %>

          <%= render 'application/records_fields', form: form, record: moon, wrapper_class: 'edit-row-notes' %>

          <div>
            <%= render 'application/edit_field', form: form, attribute: :reference_url, field_label: 'Reference link' do %>
              <%= form.text_field :reference_url, class: 'w-full edit-base',
                                                  placeholder: form.object.derived_reference_url(current_campaign) %>
            <% end %>
          </div>
        <% else %>
          <%= render section_partial.call(section), form: form, stellar_object: moon %>
        <% end %>
      </div>
    <% end %>

    <div class='pt-2 flex flex-col sm:flex-row gap-2'>
      <%= form.submit local_assigns.fetch(:submit_label, 'Commit core'), class: 'w-full sm:w-auto btn btn-primary' %>
      <%= link_to 'Cancel', cancel_url, class: 'w-full sm:w-auto btn' %>
    </div>
  </div>
<% end %>
