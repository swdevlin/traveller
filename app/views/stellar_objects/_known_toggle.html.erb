<% if stellar_object.parsec_id? && stellar_object.orbiting_id.nil? %>
  <%= form_with url: stellar_object_path(stellar_object), method: :patch do %>
    <%= hidden_field_tag 'stellar_object[known]', !stellar_object.known? %>
    <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Known</div>
    <div class='mt-2 flex items-center gap-3'>
      <button type='submit'
              role='switch'
              aria-checked='<%= stellar_object.known? %>'
              class='toggle'>
        <span></span>
      </button>
      <span class='text-xs text-fg-muted italic'>Known objects are visible on player maps.</span>
    </div>
  <% end %>
<% end %>
