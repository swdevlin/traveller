<%
  star = @stellar_object.orbiting
  star_system = StarSystem.find_by(id: @stellar_object.star_system_id)
  parsec = @stellar_object.parsec || star_system&.parsec
  subsector = parsec&.subsector
%>

<%= content_for :title, @stellar_object.class.model_name.human %>
<%= content_for :page_kicker, "IISS Class IV Survey" %>
<%= content_for :page_title, @stellar_object.display_name %>
<%= content_for :iiss_form, '0407F-IV PART P' %>
<%= content_for :page_buttons do %>
  <div class='flex items-center justify-between'>
    <div>
      <%= link_to 'Edit', edit_stellar_object_path(@stellar_object), class: 'w-full sm:w-auto btn btn-primary' %>
    </div>
    <button type='button'
            title='Copy as markdown'
            class='text-fg-muted hover:text-fg-bright'
            data-controller='clipboard'
            data-clipboard-markdown-url-value='<%= stellar_object_path(@stellar_object, format: :md) %>'
            data-action='click->clipboard#copyMarkdown'>
      <i class='fa-brands fa-markdown'></i>
    </button>
  </div>
<% end %>

<%= content_for :page_side do %>
  <div class="space-y-4">
    <% summary_partial = "#{@stellar_object.class.name.underscore.pluralize}/sidebar_summary" %>
    <% if lookup_context.template_exists?('sidebar_summary', [@stellar_object.class.name.underscore.pluralize], true) %>
      <%= render summary_partial, stellar_object: @stellar_object %>
    <% end %>
    <% if subsector %>
      <%= render 'subsectors/map_embed', subsector: subsector, highlight: parsec.id %>
    <% end %>
    <% if star_system %>
      <%= render 'star_systems/jump_survey', star_system: star_system %>
    <% end %>
  </div>
<% end %>

<%= render 'application/two_column_page' do %>
  <%= render @stellar_object %>
<% end %>
