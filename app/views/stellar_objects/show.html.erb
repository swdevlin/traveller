<%
  star = @stellar_object.orbiting
  star_system = star&.star_system
  parsec = @stellar_object.parsec || star_system&.parsec
  subsector = parsec&.subsector
%>

<%= content_for :title, @stellar_object.class.model_name.human %>
<%= content_for :page_kicker, "IISS Class IV Survey" %>
<%= content_for :page_title, @stellar_object.display_name %>
<%= content_for :iiss_form, '0407F-IV PART P' %>
<%= content_for :page_buttons do %>
  <%= link_to 'Edit', edit_stellar_object_path(@stellar_object), class: 'w-full sm:w-auto btn btn-primary' %>
<% end %>

<%= content_for :page_side do %>
  <% if subsector %>
    <div class='mt-2'>
      <div class='aspect-[415/586] w-full overflow-hidden rounded-2xl bg-slate-950/60'>
        <object type="image/svg+xml"
                data="<%= map_subsector_path(subsector, highlight: parsec.id) %>"
                class="block h-full w-full">
          Subsector map
        </object>
      </div>
    </div>
  <% end %>
<% end %>

<%= render 'application/two_column_page' do %>
  <%= render @stellar_object %>
<% end %>
