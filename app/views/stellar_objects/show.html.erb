<%
  star = @stellar_object.orbiting
  star_system = StarSystem.find_by(id: @stellar_object.star_system_id)
  parsec = @stellar_object.parsec || star_system&.parsec
  subsector = parsec&.subsector
%>

<%
  type_help = "#{@stellar_object.type.underscore}_show"
  help_template = lookup_context.template_exists?("help/#{type_help}", [], false) ? type_help : 'stellar_objects_show'
%>
<% content_for :help_path, help_page_path(help_template) %>
<%= content_for :title, @stellar_object.class.model_name.human %>
<%= content_for :page_kicker, "IISS Class IV Survey" %>
<%= content_for :page_title, @stellar_object.display_name %>
<%= content_for :iiss_form, '0407F-IV PART P' %>
<%= content_for :page_actions do %>
  <%= link_to edit_stellar_object_path(@stellar_object), class: 'btn-header',
              data: { controller: 'edit-section', edit_section_storage_key_value: "uwp_tabs_#{dom_id(@stellar_object)}", action: 'click->edit-section#go' } do %>
    <i class='fa-regular fa-pen-to-square' aria-hidden='true'></i> Edit
  <% end %>
  <%= render layout: 'application/actions_dropdown', locals: { menu_id: 'stellar-object-actions' } do %>
    <% if (@stellar_object.is_a?(TerrestrialPlanet) || @stellar_object.is_a?(PlanetoidBelt)) && @stellar_object.orbiting.is_a?(Star) %>
      <%= button_to regenerate_characteristics_stellar_object_path(@stellar_object),
                    method: :post,
                    class: actions_menu_item_class,
                    form: { class: 'w-full' },
                    data: { turbo_confirm: 'Replace all characteristics from the current UWP? Existing moons will be replaced.' } do %>
        <i class='fa-regular fa-rotate mt-1' aria-hidden='true'></i> Regenerate
      <% end %>
    <% end %>
    <%= render 'application/copy_markdown_item', url: stellar_object_path(@stellar_object, format: :md) %>
  <% end %>
<% end %>

<%= content_for :page_side do %>
  <div class="space-y-4">
    <% summary_partial = "#{@stellar_object.class.name.underscore.pluralize}/sidebar_summary" %>
    <% if lookup_context.template_exists?('sidebar_summary', [@stellar_object.class.name.underscore.pluralize], true) %>
      <%= render summary_partial, stellar_object: @stellar_object %>
    <% end %>
    <%= render 'application/tags_sidebar', record: @stellar_object %>
    <% if subsector %>
      <%= render 'subsectors/map_embed', subsector: subsector, highlight: parsec.id %>
    <% end %>
    <% if star_system %>
      <%= render 'star_systems/jump_survey', star_system: star_system %>
    <% end %>
  </div>
<% end %>

<% nodes = orbit_strip_nodes(@stellar_object) %>
<% index = nodes.index(@stellar_object) %>
<%= render 'stellar_objects/orbit_strip_nav', nodes: nodes, index: index do %>
  <%= render 'application/two_column_page', header_in_main: true do %>
    <%= render @stellar_object %>
  <% end %>
<% end %>
