<%= content_for :title, "Tech Level #{traveller_hex(@tech_level.code)}" %>
<%= content_for :page_kicker, "Tech level" %>
<%= content_for :page_title, "Tech Level #{traveller_hex(@tech_level.code)}" %>

<%= render 'application/page' do %>
  <%= render @tech_level %>

  <%= link_to "Edit", edit_tech_level_path(@tech_level), class: "w-full sm:w-auto btn btn-primary" %>
  <%= render 'application/back_button',
             path: tech_levels_path,
             label: 'Tech levels',
             class: 'w-full sm:w-auto' %>
  <%= button_to "Delete",
                @tech_level,
                method: :delete,
                form_class: "w-full sm:w-auto inline-flex m-0",
                class: "w-full sm:w-auto btn btn-danger cursor-pointer",
                data: { turbo_confirm: "Are you sure?" } %>
<% end %>



<% content_for :title, "Showing stellar object" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing stellar object</h1>

  <%= render @stellar_object %>

  <%= link_to "Edit this stellar object", edit_stellar_object_path(@stellar_object), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Back to stellar objects", stellar_objects_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= button_to "Destroy this stellar object", @stellar_object, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
</div>
