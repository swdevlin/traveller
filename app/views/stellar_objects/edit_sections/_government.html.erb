<%# locals: form, stellar_object %>
<%= render 'application/edit_field', form: form, attribute: :government_code, field_label: 'Government', required: true do %>
  <%= form.select :government_code,
                  options_for_select(
                    Government.order(:code).map { |g| ["#{HexDigit.hex_digit(g.code)} – #{g.government_type}", g.code] },
                    stellar_object.government_code
                  ),
                  { include_blank: 'Select government' },
                  class: 'edit-base' %>
<% end %>

<div class='pt-1 text-xs uppercase tracking-[0.18em] text-fg-muted'>Structure</div>

<%= render 'application/edit_field', form: form, attribute: :government_judicial, field_label: 'Judicial' do %>
  <%= form.select :government_judicial,
                  options_for_select(
                    StellarObjectsHelper::GOVERNMENT_STRUCTURE_DESCRIPTIONS.map { |k, v| ["#{k} – #{v}", k] },
                    stellar_object.government_judicial
                  ),
                  { include_blank: 'Select' },
                  class: 'edit-base' %>
<% end %>

