<%# locals: form, stellar_object %>
<% orbit_min = stellar_object.orbiting.respond_to?(:minimum_allowable_orbit) ? stellar_object.orbiting.minimum_allowable_orbit : nil %>
<%= render 'application/edit_field', form: form, attribute: :orbit, required: true, unit: ('planetary diameters' if stellar_object.is_a?(Moon)) do %>
  <%= form.number_field :orbit,
                        value: format_precision(stellar_object.orbit, precision: 5),
                        class: 'edit-base sm:w-28 w-24',
                        step: 'any',
                        min: orbit_min %>
<% end %>

<%= render 'application/edit_field', form: form, attribute: :period, unit: 'days' do %>
  <%= form.number_field :period,
                        value: format_precision(stellar_object.period, precision: 5),
                        class: 'edit-base sm:w-28 w-24',
                        step: 'any' %>
<% end %>

<%= render 'application/edit_field', form: form, attribute: :retrograde do %>
  <%= render 'application/boolean_toggle', form: form, attribute: :retrograde,
        checked: stellar_object.retrograde, checked_value: 'true', unchecked_value: 'false' %>
<% end %>

<%= render 'application/edit_field', form: form, attribute: :rotation, unit: 'hours' do %>
  <%= form.number_field :rotation,
                        value: format_precision(stellar_object.rotation, precision: 5),
                        class: 'edit-base sm:w-28 w-24',
                        step: 'any' %>
<% end %>

<%= render 'application/edit_field', form: form, attribute: :inclination, required: true, unit: '°' do %>
  <%= form.number_field :inclination,
                        value: format_precision(stellar_object.inclination, precision: 5),
                        class: 'edit-base sm:w-28 w-24',
                        step: 'any' %>
<% end %>

<%= render 'application/edit_field', form: form, attribute: :eccentricity, required: true do %>
  <%= form.number_field :eccentricity,
                        value: format_precision(stellar_object.eccentricity, precision: 5),
                        class: 'edit-base sm:w-28 w-24',
                        step: 'any' %>
<% end %>
