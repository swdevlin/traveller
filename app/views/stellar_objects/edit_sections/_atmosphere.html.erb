                  ),
                  { include_blank: 'Select severity' },
                  class: 'edit-base' %>
<% end %>

<%= render 'application/edit_field', form: form, attribute: :atmosphere_taint_persistence, field_label: 'Taint Persistence' do %>
  <%= form.select :atmosphere_taint_persistence,
                  options_for_select(
                    StellarObjectsHelper::TAINT_PERSISTENCE_DESCRIPTIONS.map { |k, v| ["#{k} – #{v}", k] },
                    stellar_object.atmosphere_taint_persistence
                  ),
                  { include_blank: 'Select persistence' },
                  class: 'edit-base' %>
<% end %>

<%= render 'application/edit_field', form: form, attribute: :atmosphere_hazard_code, field_label: 'Hazard' do %>
  <%= form.select :atmosphere_hazard_code,
                  options_for_select(
                    StellarObjectsHelper::INSIDIOUS_HAZARD_DESCRIPTIONS.map { |k, v| ["#{k} – #{v}", k] },
                    stellar_object.atmosphere_hazard_code
                  ),
                  { include_blank: 'None' },
                  class: 'edit-base' %>
<% end %>
