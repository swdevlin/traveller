<%= form_with(model: stellar_object, url: stellar_object.persisted? ? stellar_object_path(stellar_object) : stellar_objects_path, class: "contents") do |form| %>
  <% if stellar_object.errors.any? %>
    <div id="error_explanation" class="card danger">
      <p><%= pluralize(stellar_object.errors.count, "error") %> prohibited this stellar_object from being saved:</p>

      <ul class="error-list mt-3">
        <% stellar_object.errors.each do |error| %>
          <li><span><%= error.full_message %></span></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :orbit_x, class: 'edit-label' %>
    <%= form.number_field :orbit_x, class: "edit-base mt-2 w-full", aria: { invalid: stellar_object.errors[:orbit_x].any? } %>
  </div>

  <div class="my-5">
    <%= form.label :orbit_y, class: 'edit-label' %>
    <%= form.number_field :orbit_y, class: "edit-base mt-2 w-full", aria: { invalid: stellar_object.errors[:orbit_y].any? } %>
  </div>

  <div class="my-5">
    <%= form.label :parsec_id, class: 'edit-label' %>
    <%= form.text_field :parsec_id, class: "edit-base mt-2 w-full", aria: { invalid: stellar_object.errors[:parsec_id].any? } %>
  </div>

  <div class="my-5">
    <%= form.label :orbiting_id, class: 'edit-label' %>
    <%= form.text_field :orbiting_id, class: "edit-base mt-2 w-full", aria: { invalid: stellar_object.errors[:orbiting_id].any? } %>
  </div>

  <div class="my-5">
    <%= form.label :inclination, class: 'edit-label' %>
    <%= form.text_field :inclination, class: "edit-base mt-2 w-full", aria: { invalid: stellar_object.errors[:inclination].any? } %>
  </div>

  <div class="my-5">
    <%= form.label :eccentricity, class: 'edit-label' %>
    <%= form.text_field :eccentricity, class: "edit-base mt-2 w-full", aria: { invalid: stellar_object.errors[:eccentricity].any? } %>
  </div>

  <div class="my-5">
    <%= form.label :orbit, class: 'edit-label' %>
    <%= form.text_field :orbit, class: "edit-base mt-2 w-full", aria: { invalid: stellar_object.errors[:orbit].any? } %>
  </div>

  <div class="my-5">
    <%= form.label :effective_hzco_deviation, class: 'edit-label' %>
    <%= form.text_field :effective_hzco_deviation, class: "edit-base mt-2 w-full", aria: { invalid: stellar_object.errors[:effective_hzco_deviation].any? } %>
  </div>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
