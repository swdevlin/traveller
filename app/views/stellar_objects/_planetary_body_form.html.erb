<%# One form with a tab per section, so a selection survives switching tabs and a validation error on any
    section can be fixed on the same page. %>
<%= render 'stellar_objects/tabbed_form', moon: stellar_object, url: stellar_object_path(stellar_object),
                                          cancel_url: stellar_object_path(stellar_object), submit_label: 'Update core',
                                          section: local_assigns.fetch(:section, @section || 'general') %>
