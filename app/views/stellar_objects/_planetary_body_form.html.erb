    <%= render 'application/edit_field', form: form, attribute: :population_code, field_label: 'Population' do %>
      <%= form.number_field :population_code,
                            value: stellar_object.population_code,
                            class: 'edit-base sm:w-28 w-24',
                            step: 1,
