<% section = local_assigns.fetch(:section, @section || 'general') %>

<%= render 'stellar_objects/form_scaffold', stellar_object: stellar_object, section: section, show_core_fields: section == 'general', wrapper_class: 'space-y-2 pb-10', notes_wrapper_class: 'edit-row-notes', show_notes_required_icon: true, show_notes_field_error: true do |form| %>
  <%= render "stellar_objects/edit_sections/#{section}", form: form, stellar_object: stellar_object %>
<% end %>
