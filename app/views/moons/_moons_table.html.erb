<% preload_tags(moons) %>
<turbo-frame id="moons-table">
  <% add_moon_button = link_to new_stellar_object_moon_path(@stellar_object), class: 'btn-header', title: 'Add moon', aria: { label: 'Add moon' }, data: { turbo_frame: '_top' } do %>
    <i class="fa-regular fa-plus"></i> Moon
  <% end %>
  <% add_ring_button = link_to new_stellar_object_ring_path(@stellar_object), class: 'btn-header', title: 'Add ring', aria: { label: 'Add ring' }, data: { turbo_frame: 'modal' } do %>
    <i class="fa-regular fa-plus"></i> Ring
  <% end %>

  <% significant_only = params[:significant_only].present? %>
  <% significant_toggle = form_with(url: stellar_object_path(@stellar_object), method: :get, class: 'flex items-center gap-2 text-sm text-fg') do %>
    <% unless significant_only %>
      <%= hidden_field_tag :significant_only, '1' %>
    <% end %>
    <button type='submit'
            role='switch'
            aria-checked='<%= significant_only %>'
            aria-label='Significant moons only'
            class='relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none <%= significant_only ? "bg-toggle-on" : "bg-toggle-off" %>'>
      <span class='pointer-events-none inline-block h-5 w-5 transform rounded-full shadow ring-0 transition duration-200 ease-in-out <%= significant_only ? "translate-x-5 bg-toggle-knob-on" : "translate-x-0 bg-toggle-knob-off" %>'></span>
    </button>
    Significant only
  <% end if @moon_count.to_i > 0 %>

  <% orbit_map_button = link_to moon_orbit_map_modal_stellar_object_path(@stellar_object, significant_only: params[:significant_only].presence), class: 'btn-header', title: 'Moon orbit map', aria: { label: 'Moon orbit map' }, data: { turbo_frame: 'modal' } do %>
    <i class="fa-regular fa-solar-system"></i> Orbit map
  <% end if moons.any? %>


  <%= render 'application/collapsible_table_card',
             title: safe_join(['Moons ', tag.span(@moon_count, class: 'identifier')]),
             actions: safe_join([significant_toggle, orbit_map_button, add_moon_button, add_ring_button].compact) do %>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col" class="w-px">Name</th>
            <th scope="col" class="w-px cursor-help" title="Orbit sequence">Seq</th>
            <th scope="col" class="w-px text-right cursor-help" title="Distance from the parent planet's centre, in kilometres">Distance</th>
            <th scope="col" class="w-px text-right cursor-help" title="Ring span, in planetary diameters">Span</th>
            <th scope="col">UWP</th>
            <th scope="col">Tags</th>
            <th scope="col" class="text-right actions-cell">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if moons.empty? %>
            <tr><td colspan="7" class="text-fg-muted">No moons recorded.</td></tr>
          <% end %>
          <% moons.each do |moon| %>
            <tr class="cursor-pointer"
                data-controller="row-link"
                data-row-link-url-value="<%= stellar_object_path(moon) %>"
                data-action="click->row-link#navigate">
              <td class="whitespace-nowrap">
                <% if local_assigns[:star_system]&.main_world_id == moon.id %>
                  <i class='fa-regular fa-globe mr-2' title='Main world'></i>
                <% end %>
                <%= moon.name %>
              </td>
              <td class="whitespace-nowrap"><%= moon.orbit_sequence %></td>
              <td class="whitespace-nowrap text-right">
                <% distance_km = moon.distance_km %>
                <%= "#{number_with_precision(distance_km, precision: 3, significant: true, delimiter: ',')} km" if distance_km %>
              </td>
              <td class="whitespace-nowrap text-right">
                <%= number_with_precision(moon.span, precision: 3, strip_insignificant_zeros: true) if moon.is_a?(Ring) %>
              </td>
              <td>
                <%= moon.is_a?(Ring) ? 'Ring' : moon.uwp %>
              </td>
              <td><%= render 'application/tags', record: moon %></td>
              <td class="actions-cell">
                <div class="action-group">
                  <%= render 'application/tag_action', record: moon, label: moon.display_name %>
                  <% if moon.is_a?(Ring) %>
                    <%= link_to edit_ring_path(moon), class: 'action', title: 'Edit ring', data: { turbo_frame: 'modal' } do %>
                      <i class="fa-regular fa-pen-to-square"></i>
                    <% end %>
                    <%= button_to ring_path(moon), method: :delete, class: 'action danger', title: 'Delete ring',
                                  data: { turbo_confirm: 'Delete this ring?' } do %>
                      <i class="fa-regular fa-trash"></i>
                    <% end %>
                  <% else %>
                    <%= link_to edit_stellar_object_path(moon), class: 'action', title: 'Edit moon', data: { turbo_frame: '_top' } do %>
                      <i class="fa-regular fa-pen-to-square"></i>
                    <% end %>
                    <%= button_to stellar_object_path(moon), method: :delete, class: 'action danger', title: 'Delete moon',
                                  data: { turbo_confirm: "Delete #{moon.name}?" } do %>
                      <i class="fa-regular fa-trash"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="w-full pb-4">
        <%== pagy.series_nav %>
      </div>
    </div>
  <% end %>
</turbo-frame>
