<% allegiance = moon.allegiance %>
<% parent = moon.orbiting %>
<% star_system = StarSystem.find_by(id: moon.star_system_id) %>
<% parsec = moon.parsec || star_system&.parsec %>
<% subsector = parsec&.subsector %>
<% sector = parsec&.sector %>

<% allegiance_value =
     if allegiance
       safe_join([
                   allegiance.name,
                   content_tag(:span, allegiance.code, class: "identifier")
                 ])
     else
       "None"
     end
%>

<div id="<%= dom_id moon %>" class="space-y-6">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-5">
    <% if moon.starport_code.present? %>
      <%= render 'application/data_block',
                 label: 'Starport',
                 value: tag.span(moon.starport_code, class: 'identifier-sm') %>
    <% end %>
    <%= render 'application/data_block', label: 'UWP', value: moon.uwp, value_style: :mono %>
    <%= render 'application/data_block',
               label: 'Allegiance',
               value: allegiance_value %>
  </div>

  <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-5">
    <% if parent %>
      <%= render 'application/data_block',
                 label: 'Orbiting',
                 value: link_to(parent.display_name,
                                stellar_object_path(parent),
                                class: 'hover:underline underline-offset-4') %>
    <% end %>
    <% if star_system %>
      <%= render 'application/data_block',
                 label: 'Star System',
                 value: link_to(star_system.display_name,
                                star_system_path(star_system),
                                class: 'hover:underline underline-offset-4') %>
    <% end %>

    <% if subsector %>
      <%= render 'application/data_block',
                 label: 'Subsector',
                 value: link_to(subsector.name,
                                subsector_path(subsector),
                                class: 'hover:underline underline-offset-4') %>
    <% end %>

    <% if sector %>
      <%= render 'application/data_block',
                 label: 'Sector',
                 value: link_to(
                   sector.name,
                   sector_path(sector),
                   class: 'hover:underline underline-offset-4'
                 ),
                 value_wrap_class: 'flex flex-wrap items-center gap-2',
                 suffix: tag.span(parsec.hex_code, class: 'identifier') %>
    <% end %>

  </div>

  <% if parent %>
    <%= render 'application/subsection', title: 'Orbital Data' %>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
      <%= render 'application/data_block', label: 'Orbit', value: number_with_precision(moon.orbit, precision: moon.orbit.to_f < 10 ? 1 : 0, strip_insignificant_zeros: true), suffix: 'diameters' %>
      <%= render 'application/data_block', label: 'Period', value: format_period(moon.period) %>
      <%= render 'application/data_block', label: 'Retrograde', value: moon.retrograde ? 'Yes' : 'No' %>
      <%= render 'application/data_block', label: 'Inclination', value: number_with_precision(moon.inclination, precision: 2, strip_insignificant_zeros: true), suffix: '°' %>
      <%= render 'application/data_block', label: 'Eccentricity', value: number_with_precision(moon.eccentricity, precision: 2, strip_insignificant_zeros: true) %>
      <% if moon.tidal_lock_target %>
        <% target = moon.tidal_lock_target %>
        <% target_path = target.is_a?(Star) ? star_path(target) : stellar_object_path(target) %>
        <%= render 'application/data_block',
                   label: 'Tidally Locked',
                   value: link_to(target.display_name, target_path, class: 'no-underline hover:underline hover:underline-offset-2') %>
      <% end %>
      <% if moon.sidereal_day.present? %>
        <%= render 'application/data_block', label: 'Sidereal Day', value: number_with_precision(moon.sidereal_day, precision: 2, strip_insignificant_zeros: true), suffix: 'hours' %>
      <% end %>
      <% if moon.twilight_zone %>
        <%= render 'application/data_block', label: 'Twilight Zone', value: 'Yes' %>
      <% end %>
    </div>

    <%= render 'stellar_objects/jump_shadow_times', stellar_object: moon %>
  <% end %>

  <%= render 'application/subsection', title: 'Physical Data' %>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
    <%= render 'application/data_block',
               label: 'Diameter',
               value: safe_join([tag.span(moon.size_code, class: 'identifier-sm'), number_with_precision(moon.diameter, precision: 0)]),
               value_wrap_class: 'flex flex-wrap items-center gap-2',
               suffix: 'km'
    %>
    <%= render 'application/data_block', label: 'Mass', value: number_with_precision(moon.mass, precision: 2, strip_insignificant_zeros: true), suffix: '☉' %>
    <%= render 'application/data_block', label: 'Gravity', value: number_with_precision(moon.gravity, precision: 2, strip_insignificant_zeros: true), suffix: 'g' %>
    <%= render 'application/data_block', label: 'Density', value: number_with_precision(moon.density, precision: 2, strip_insignificant_zeros: true), suffix: '☉' %>
  </div>

  <%= render 'application/subsection', title: 'Environmental Data' %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
    <%= render 'application/data_block', label: 'Temperature', value: format_temperature_celsius(moon.temperature), suffix: '°C' %>
    <%= render 'application/data_block', label: 'Rotation', value: number_with_precision(moon.rotation, precision: 2, strip_insignificant_zeros: true), suffix: 'hours' %>
    <%= render 'application/data_block', label: 'Axial Tilt', value: number_with_precision(moon.axial_tilt, precision: 2, strip_insignificant_zeros: true), suffix: '°' %>
    <%= render 'application/data_block', label: 'Albedo', value: number_with_precision(moon.albedo, precision: 2, strip_insignificant_zeros: true) %>
    <%= render 'application/data_block', label: 'Greenhouse', value: number_with_precision(moon.greenhouse, precision: 2, strip_insignificant_zeros: true) %>
  </div>

  <% atmosphere = moon.atmosphere %>
  <% if atmosphere.present? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
      <% code = atmosphere['code'] %>
      <% taint = atmosphere['taint'] %>
      <% taint_code = taint&.dig('code') %>
      <%= render 'application/data_block',
                 label: 'Atmosphere',
                 value: safe_join([tag.span(HexDigit.hex_digit(code), class: 'identifier-sm'), atmosphere_description(code)], ' '),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
      <% if taint_code.present? %>
        <% severity = taint['severity'] %>
        <% persistence = taint['persistence'] %>
        <%= render 'application/data_block', label: 'Irritant', value: safe_join([tag.span(taint_code, class: 'identifier-sm'), taint_description(taint_code)], ' ') %>
        <%= render 'application/data_block', label: 'Severity', value: safe_join([tag.span(severity, class: 'identifier-sm'), taint_severity_description(severity)], ' ') %>
        <%= render 'application/data_block', label: 'Persistence', value: safe_join([tag.span(persistence, class: 'identifier-sm'), taint_persistence_description(persistence)], ' ') %>
      <% end %>
      <% if atmosphere['composition'] %>
        <%= render 'application/data_block', label: 'Composition', value: atmosphere['composition'] %>
      <% end %>
    </div>
  <% end %>

  <% hydrographics = moon.hydrographics %>
  <% if hydrographics.present? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
      <% code = hydrographics['code'] %>
      <% distribution = hydrographics['distribution'] %>
      <%= render 'application/data_block',
                 label: 'Hydrographics',
                 value: safe_join([tag.span(HexDigit.hex_digit(code), class: 'identifier-sm'), hydrographics_description(code)], ' '),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
      <%= render 'application/data_block',
                 label: 'Liquid',
                 value: hydrographics['liquid'],
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
      <%= render 'application/data_block',
                 label: 'Distribution',
                 value: safe_join([tag.span(HexDigit.hex_digit(distribution), class: 'identifier-sm'), hydrographics_distribution_description(distribution)], ' '),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    </div>
  <% end %>

  <%= render 'application/subsection', title: 'Biological Data' %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
    <%= render 'application/data_block', label: 'Biomass Rating', value: moon.biomass_rating %>
    <% if moon.biodiversity_rating.present? %>
      <%= render 'application/data_block',
                 label: 'Biodiversity Rating',
                 value: safe_join([tag.span(HexDigit.hex_digit(moon.biodiversity_rating), class: 'identifier-sm'), biodiversity_description(moon.biodiversity_rating)], ' '),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    <% end %>
    <% if moon.biocomplexity_rating.present? %>
      <%= render 'application/data_block',
                 label: 'Biocomplexity Rating',
                 value: safe_join([tag.span(moon.biocomplexity_rating, class: 'identifier-sm'), biocomplexity_description(moon.biocomplexity_rating)], ' '),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    <% end %>
    <% if moon.resource_rating.present? %>
      <%= render 'application/data_block',
                 label: 'Resource Rating',
                 value: safe_join([tag.span(HexDigit.hex_digit(moon.resource_rating), class: 'identifier-sm'), resource_rating_description(moon.resource_rating)], ' '),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    <% end %>
  </div>

  <%= render 'application/subsection', title: 'Social Data' %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
    <%= render 'application/population_block', population_code: moon.population_code %>
    <%= render 'application/data_block', label: 'Native Sophont', value: moon.native_sophont ? 'Yes' : 'No' %>
    <%= render 'application/data_block', label: 'Extinct Sophont', value: moon.extinct_sophont ? 'Yes' : 'No' %>
  </div>
  <div class="grid grid-cols-1 gap-4">
    <% gov = moon.government_code.present? ? Government.find_by(code: moon.government_code) : nil %>
    <% if gov %>
      <%= render 'application/data_block',
                 label: 'Government',
                 value: safe_join([tag.span(HexDigit.hex_digit(gov.code), class: 'identifier-sm'), gov.government_type], ' '),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    <% end %>
  </div>
  <div class="grid grid-cols-1 gap-4">
    <% law = moon.law_level_code.present? ? LawLevel.find_by(code: moon.law_level_code) : nil %>
    <% if law %>
      <%= render 'application/data_block',
                 label: 'Law Level',
                 value: safe_join([tag.span(HexDigit.hex_digit(law.code), class: 'identifier-sm'), law.weapons], ' '),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 gap-4">
    <% tech_level = moon.tech_level_code.present? ? moon.tech_level_code : nil %>
    <% if tech_level %>
      <%= render 'application/data_block',
                 label: 'Tech Level',
                 value: tag.span(HexDigit.hex_digit(tech_level), class: 'identifier-sm'),
                 value_wrap_class: 'flex flex-wrap items-center gap-2' %>
    <% end %>
  </div>

  <%= render 'application/observation_block',
             notes: moon.notes %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 border-t border-slate-700 pt-6">
  </div>
</div>
