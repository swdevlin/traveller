<% allegiance = moon.allegiance %>
<% parent = moon.orbiting %>
<% star_system = StarSystem.find_by(id: moon.star_system_id) %>
<% parsec = moon.parsec || star_system&.parsec %>
<% subsector = parsec&.subsector %>
<% sector = parsec&.sector %>
<% shadow_km = moon.effective_jump_shadow_km %>
<% shadow_source = shadow_km&.positive? ? moon.effective_jump_shadow_source : nil %>

<%
  hierarchy = []
  hierarchy << [parsec.display_name, sector_path(sector)] if sector
  hierarchy << [parsec.subsector_display_name, subsector_path(subsector)] if subsector
  hierarchy << [star_system.display_name, star_system_path(star_system)] if star_system
  hierarchy << [parent.display_name, stellar_object_path(parent)] if parent

  extra_tabs = []
  if moon.respond_to?(:cities)
    extra_tabs << { id: 'cities', code: moon.cities.count.to_s, label: 'Cities',
                    partial: 'stellar_objects/cities_tab', locals: { stellar_object: moon } }
  end
%>

<div id="<%= dom_id moon %>" class="space-y-4">
  <%= render 'stellar_objects/object_context', hierarchy: hierarchy %>

  <%= render 'stellar_objects/uwp_tabs',
             stellar_object: moon,
             parent: parent,
             parsec: parsec,
             allegiance: allegiance,
             shadow_km: shadow_km,
             shadow_source: shadow_source,
             extra_tabs: extra_tabs %>

  <%= render 'application/observation_block', notes: moon.notes %>
</div>
