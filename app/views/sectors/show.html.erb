<% content_for :title, "Showing sector" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl mb-4"><%= @sector.name %></h1>

  <%= render "subsector_grid", sector: @sector %>

  <div class="mt-4 flex flex-col sm:flex-row gap-2">
    <%= link_to "Edit this sector",
                edit_sector_path(@sector),
                class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium text-gray-900" %>

    <%= link_to "Back to sectors",
                sectors_path,
                class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium text-gray-900" %>

    <%= button_to "Delete",
                  @sector,
                  method: :delete,
                  form_class: "w-full sm:w-auto",
                  class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 text-white bg-traveller-red hover:bg-traveller-red/90 font-medium cursor-pointer",
                  data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
