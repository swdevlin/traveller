<% content_for :title, "Sector #{@sector.name}" %>
<% content_for :page_kicker, 'IISS Class 0 Sector Survey' %>
<% content_for :page_title do %>
  <%= @sector.name %><% if @sector.abbreviation.present? %><span class='text-fg-muted'>, <%= @sector.abbreviation %></span><% end %>
<% end %>
<% content_for :iiss_form, '0398D-0' %>
<%= turbo_tour "sectors" unless Current.user&.tour_completed?('sectors') %>

<% content_for :page_buttons do %>
  <% confirm_msg = "There are #{pluralize(@star_system_count, 'star system')} and #{pluralize(@rogue_count, 'rogue stellar object')} in the sector. Are you sure you wish to clear the sector?" %>
  <div class='mt-6 flex flex-col sm:flex-row gap-2'>
    <%= link_to 'Edit',
                edit_sector_path(@sector),
                class: 'w-full sm:w-auto btn btn-primary' %>

    <% confirm_msg = "There are #{pluralize(@star_system_count, 'star system')} and #{pluralize(@rogue_count, 'rogue stellar object')} in the sector. Are you sure you wish to replace them?" %>
    <%= form_with(url: generate_sector_path(@sector), method: :post, class: 'contents') do |form| %>
      <%= form.submit 'Populate',
                      class: 'w-full sm:w-auto btn cursor-pointer',
                      data: { turbo_confirm: confirm_msg, tour_step: 'sector-populate' } %>
    <% end %>

    <%= button_to 'Clear',
                  clear_sector_path(@sector),
                  method: 'post',
                  class: 'w-full sm:w-auto btn',
                  data: { turbo_confirm: confirm_msg, tour_step: 'sector-clear' } %>

    <%= link_to 'Load Build Default',
                defaults_source_sector_path(@sector),
                class: 'w-full sm:w-auto btn' %>

    <% if @sector.source == 'traveller_map' %>
      <%= button_to 'Refresh Jump Routes',
                    import_jump_routes_sector_path(@sector),
                    method: 'post',
                    class: 'w-full sm:w-auto btn',
                    data: { tour_step: 'sector-import-jump-routes' } %>
    <% end %>

    <%= render 'application/back_button',
               path: sectors_path(page: @page),
               label: 'Sectors',
               class: 'w-full sm:w-auto' %>

    <%= button_to 'Delete',
                  @sector,
                  method: :delete,
                  form_class: 'w-full sm:w-auto',
                  class: 'w-full sm:w-auto btn btn-danger cursor-pointer',
                  data: { turbo_confirm: 'Are you sure?', tour_step: 'sector-delete' } %>
  </div>
<% end %>

<% content_for :page_side do %>
  <div class='flex items-center justify-between mb-2'>
    <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Subsectors</div>
    <div class='flex items-center gap-3'>
      <button type='button'
              title='Copy public map link'
              class='text-fg-muted hover:text-fg-bright'
              data-tour-step='public-map-link'
              data-controller='clipboard'
              data-clipboard-url-value='<%= signed_map_url(map_sector_path(@sector)) %>'
              data-action='click->clipboard#copy'>
        <i class='fa-regular fa-link'></i>
      </button>
      <%= link_to map_sector_path(@sector),
                  target: '_blank',
                  rel: 'noopener',
                  title: 'Star Map',
                  data: {'tour_step': 'sector-map'},
                  class: 'text-fg-muted hover:text-highlight transition-colors' do %>
        <i class="fa-regular fa-map"></i>
      <% end %>
      <%= link_to poster_sector_path(@sector),
                  title: 'Download poster PDF',
                  data: {'tour_step': 'sector-poster'},
                  class: 'text-fg-muted hover:text-highlight transition-colors' do %>
        <i class="fa-regular fa-rectangle-vertical"></i>
      <% end %>
    </div>
  </div>
  <turbo-frame id='sector-subsector-grid'
               data-controller='ui-updates'
               data-ui-updates-sector-id-value='<%= @sector.id %>'
               data-ui-updates-src-value='<%= sector_path(@sector) %>'>
    <%= render 'subsector_grid', sector: @sector %>
  </turbo-frame>

  <div class='mt-6'>
    <div class='text-xs uppercase tracking-[0.22em] text-fg-muted mb-2'>
      Neighbouring sectors
    </div>
    <%= render 'sector_grid', sector: @sector %>
  </div>
<% end %>

<%= render 'application/two_column_page' do %>
  <div class='space-y-6'>
    <div class='grid grid-cols-1 gap-4 sm:grid-cols-4'>
      <%= render 'application/data_block',
                 label: 'Sector Coordinates',
                 tour_step: 'sector-coordinates',
                 value: tag.span("#{@sector.x}/#{@sector.y}", class: 'identifier') %>

      <%= render 'application/data_block',
                 label: 'Star chart',
                 value: (
                   if (u = safe_external_url(@sector.traveller_map_url))
                     link_to('Traveller Map', u, target: '_blank', rel: 'noopener',
                             class: 'hover:underline underline-offset-4')
                   else
                     tag.span('Undocumented', class: 'text-fg-muted')
                   end
                 ) %>

      <% if (reference_url = safe_external_url(@sector.effective_reference_url(current_campaign))) %>
        <%= render 'application/data_block',
                   label: 'Library data',
                   value: link_to('Reference', reference_url, target: '_blank', rel: 'noopener',
                                  class: 'hover:underline underline-offset-4') %>
      <% end %>
    </div>

    <%= render 'application/observation_block', notes: @sector.notes %>

    <div>
      <%= render 'application/subsection', title: 'Sector Statistics' %>

      <div data-controller='collapsible' data-collapsible-collapse-class-value='hidden'>
        <div class='flex w-full items-center justify-between gap-3 cursor-pointer select-none text-sm text-fg-muted hover:text-fg-bright transition-colors'
             data-action='click->collapsible#toggle'>
          <span>
            <%= safe_join([
              pluralize(@star_system_count, 'system'),
              "#{@populated_world_count} populated",
              population_summary_fragment(@sector, @sector_highest_population_world),
              safe_join(['Highest tech level ', (@sector_highest_tech_level_code ? HexDigit.hex_digit(@sector_highest_tech_level_code) : '—')]),
              pluralize(@allegiance_count, 'allegiance'),
              pluralize(@rogue_count, 'rogue')
            ], ' · ') %>
          </span>
          <i class='fa-regular fa-square-chevron-down' data-collapsible-target='icon'></i>
        </div>

        <div data-collapsible-target='content' class='hidden mt-4'>
          <turbo-frame id='<%= dom_id(@sector, :statistics) %>'
                       src='<%= statistics_sector_path(@sector) %>'>
            <%= render 'application/statistics_loading' %>
          </turbo-frame>
        </div>
      </div>
    </div>

    <turbo-frame id='sector-subsectors-table'
                 data-controller='ui-updates'
                 data-ui-updates-sector-id-value='<%= @sector.id %>'
                 data-ui-updates-src-value='<%= sector_path(@sector) %>'>
      <%= render 'subsectors/table', subsectors: @sector.subsectors.order(:name) %>
    </turbo-frame>
  </div>
<% end %>
