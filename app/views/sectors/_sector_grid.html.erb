<%# locals: (sector:) %>

<% neighbours = sector.neighbours %>

<div class="rounded-xl border border-outline/60 bg-panel p-3">
  <div class="grid grid-cols-3 gap-1 text-xs">
    <% (sector.y + 1).downto(sector.y - 1) do |y| %>
      <% (sector.x - 1).upto(sector.x + 1) do |x| %>
        <% neighbour = neighbours[[x, y]] %>

        <% if neighbour %>
          <% if neighbour == sector %>
            <div class="relative aspect-[4/5] flex flex-col items-center justify-center overflow-hidden rounded-md border-2 border-highlight bg-highlight/10 px-1 py-1 text-center">
              <img src="<%= sector_map_backdrop_url(neighbour) %>" alt="" loading="lazy" aria-hidden="true"
                   class="pointer-events-none absolute inset-0 h-full w-full object-contain opacity-50">
              <div class="relative w-full [-webkit-text-stroke:4px_var(--color-panel)] [paint-order:stroke_fill]">
                <div class="relative font-semibold text-[0.7rem] text-highlight-fg truncate w-full text-center">
                  <%= neighbour.name %>
                </div>
                <div class="relative text-[0.6rem] text-fg italic">
                  <%= x %>/<%= y %>
                </div>
              </div>
            </div>
          <% else %>
            <%= link_to sector_path(neighbour),
                        class: "relative aspect-[4/5] flex flex-col no-underline items-center justify-center overflow-hidden rounded-md border border-outline/70 bg-panel px-1 py-1 text-center hover:border-highlight hover:bg-panel transition" do %>
              <img src="<%= sector_map_backdrop_url(neighbour) %>" alt="" loading="lazy" aria-hidden="true"
                   class="pointer-events-none absolute inset-0 h-full w-full object-contain opacity-50">
              <div class="relative w-full [-webkit-text-stroke:4px_var(--color-panel)] [paint-order:stroke_fill]">
                <div class="relative font-semibold text-[0.7rem] text-fg-bright truncate w-full text-center">
                  <%= neighbour.name %>
                </div>
                <div class="relative text-[0.6rem] text-fg italic">
                  <%= x %>/<%= y %>
                </div>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <!-- Empty space in this 3x3 window -->
          <div class="aspect-[4/5] flex flex-col items-center justify-center rounded-md border border-outline bg-panel px-1 py-1 text-[0.6rem] text-fg-muted text-center">
            Unknown
            <div class="text-[0.55rem] text-fg-muted italic">
              <%= x %>/<%= y %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
