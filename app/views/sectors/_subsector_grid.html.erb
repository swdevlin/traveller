<%# locals: (sector:, active_subsector: nil) %>

<% subsectors_by_coord = sector.subsectors.index_by { |s| [s.x, s.y] } %>
<div class="rounded-xl border border-outline/60 bg-panel p-3">
  <div class="grid grid-cols-4 gap-1">
    <% (1..4).each do |row| %>
      <% (1..4).each do |col| %>
        <% subsector = subsectors_by_coord[[col, row]] %>

        <% if subsector %>
          <% if subsector == active_subsector %>
            <div class="aspect-[4/5] flex flex-col items-center justify-center rounded-md border-2 border-highlight bg-highlight/10 text-xs">
              <div class="font-semibold text-highlight-foreground text-center px-1">
                <%= subsector.name.presence || "?" %>
              </div>
            </div>
          <% else %>
            <%= link_to subsector_path(subsector),
                        class: "aspect-[4/5] group flex flex-col items-center no-underline justify-center rounded-md border border-outline/70 bg-panel text-xs hover:border-highlight hover:bg-panel transition" do %>
              <div class="font-semibold text-fg-bright group-hover:text-highlight-foreground text-center px-1">
                <%= subsector.name.presence || "?" %>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="aspect-[4/5] flex flex-col items-center justify-center rounded-md border border-outline bg-panel text-xs">
            <div class="font-medium text-fg-muted">
              Empty
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
