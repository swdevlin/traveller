<%= modal(title: 'Generate Build Plans', padding: true, advance: false, overlay: false) do %>
  <div class='space-y-4'>
    <p class='text-sm text-fg leading-relaxed'>
      Select the source for subsector build configurations.
    </p>

    <div class='rounded-2xl border border-outline/60 bg-panel p-4 space-y-3'>
      <div class='flex items-start gap-3'>
        <i class='fa-regular fa-map text-fg mt-0.5'></i>
        <div class='min-w-0'>
          <div class='font-semibold text-fg-bright'>TravellerMap</div>
          <div class='text-sm text-fg'>
            Pulls subsector data from TravellerMap, including system positions, UWPs, and star data.
          </div>
        </div>
        <div class='ml-auto shrink-0'>
          <%= button_to load_defaults_sector_path(@sector, source: 'traveller_map'),
                        method: :post,
                        class: 'btn btn-primary',
                        data: { controller: 'busy', action: 'submit->busy#start' } do %>
            Load
          <% end %>
        </div>
      </div>

      <% if @deepnight_defaults_available %>
        <div class='h-px border-outline/70'></div>

        <div class='flex items-start gap-3'>
          <i class='fa-regular fa-satellite text-fg mt-0.5'></i>
          <div class='min-w-0'>
            <div class='font-semibold text-fg-bright'>Deepnight Revelation</div>
            <div class='text-sm text-fg'>
              Campaign-tuned presets with curated density, survey index, and unusual object rates.
            </div>
          </div>
          <div class='ml-auto shrink-0'>
            <%= button_to load_defaults_sector_path(@sector, source: 'deepnight'),
                          method: :post,
                          class: 'btn btn-primary',
                          data: { controller: 'busy', action: 'submit->busy#start' } do %>
              Load
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
