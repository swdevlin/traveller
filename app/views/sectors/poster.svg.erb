<%
  map_w, map_h = hex_map_svg_dimensions(32, 40)
  hex_content = @hex_map_svg.sub(/\A.*?<svg[^>]*>/m, '').sub(/<\/svg>\s*\z/m, '')

  map_x    = 15.0
  map_y    = 15.0
  map_w_mm = 527.5
  map_scale = map_w_mm / map_w
  map_h_mm = (map_h * map_scale).round(1)

  map_right    = map_x + map_w_mm
  map_bottom   = map_y + map_h_mm
  map_center_x = (map_x + map_right / 2.0).round(1)
  map_center_y = (map_y + map_h_mm / 2.0).round(1)

  strip_x  = map_right + 3.0
  strip_rx = 591.0
  strip_cx = ((strip_x + strip_rx) / 2.0).round(1)

  # Center x-position (poster mm) for each subsector column (x=1..4)
  ss_col_centers = (1..4).map do |ss_x|
    col_a = (ss_x - 1) * 8 + 4
    col_b = col_a + 1
    avg_cx = (hex_center(col_a, 1).first + hex_center(col_b, 1).first) / 2.0
    (map_x + avg_cx * map_scale).round(1)
  end

  # Center y-position (poster mm) for each subsector row (y=1..4)
  ss_row_centers = (1..4).map do |ss_y|
    row_a = (ss_y - 1) * 10 + 5
    row_b = row_a + 1
    avg_cy = (hex_center(1, row_a).last + hex_center(1, row_b).last) / 2.0
    (map_y + avg_cy * map_scale).round(1)
  end

  legend_strip_x = map_x
  legend_strip_y = map_bottom + 15
  disclaim_y     = 825.0
-%>
<svg xmlns="http://www.w3.org/2000/svg"
     width="594mm" height="841mm"
     viewBox="0 0 594 841">

  <defs>
    <symbol id="poster-gas-giant-icon" viewBox="0 0 640 640">
      <path d="M512.9 157.2C526.9 133.5 535.8 114.1 540.4 99.7C526.7 104.1 508.5 112.3 486.3 125.2C472.7 113.6 458.2 103.6 443 95.3C448.2 92 453.4 88.8 458.5 85.8C488.5 68.1 515 56.1 536.5 50.9C543.2 49.3 550.4 47.8 557.2 47.8C563.7 47.7 574.3 48.9 582.8 57.4C591.3 65.9 592.4 76.4 592.4 83C592.3 89.7 590.9 96.9 589.3 103.7C584.1 125.1 572.1 151.7 554.4 181.7C543 200.9 529.3 221.5 513.6 243C523.1 266.8 528.3 292.8 528.3 320.1C528.3 435 435.2 528.1 320.3 528.1C293.1 528.1 267.1 522.9 243.2 513.4C221.7 529.2 201.1 542.9 181.9 554.2C151.9 571.9 125.4 583.9 103.9 589.1C97.2 590.7 90 592.2 83.2 592.2C76.7 592.3 66.1 591.1 57.6 582.6C49.1 574.1 48 563.5 48 557C48.1 550.3 49.5 543.1 51.1 536.3C56.3 514.9 68.3 488.3 86 458.3C89 453.2 92.1 448.1 95.5 442.8C103.8 458 113.8 472.5 125.4 486.1C112.5 508.3 104.3 526.5 99.9 540.2C114.3 535.6 133.6 526.7 157.4 512.7C169.8 505.3 183 496.9 196.7 487.3C145.4 449.4 112.2 388.5 112.2 319.9C112.2 205 205.3 111.9 320.2 111.9C388.8 111.9 449.7 145.2 487.6 196.4C497.1 182.7 505.6 169.5 513 157.1zM457.3 237.6C429.3 191.1 378.4 160.1 320.2 160.1C231.8 160.1 160.2 231.7 160.2 320.1C160.2 378.3 191.3 429.2 237.7 457.2C274.6 428.4 314.2 393.5 353.9 353.8C393.6 314.1 428.5 274.5 457.3 237.6zM289.6 477.1C299.5 479 309.7 480 320.2 480C408.6 480 480.2 408.4 480.2 320C480.2 309.5 479.2 299.3 477.3 289.4C451 321.4 420.9 354.6 387.9 387.6C354.9 420.6 321.7 450.7 289.7 477z"/>
    </symbol>
    <symbol id="poster-comet-icon" viewBox="0 0 640 640">
      <path d="M363.4 139.6L557.7 64.9C559.2 64.3 560.9 64 562.5 64C570 64 576 70 576 77.5C576 79.2 575.7 80.8 575.1 82.3L500.4 276.5L529.7 274.2C542.5 273.2 551.2 287 544.8 298.2L442.6 474.7C406.3 537.4 339.4 576 267 576C154.9 576 64 485.1 64 373C64 300.6 102.6 233.7 165.3 197.4L341.7 95.2C352.8 88.7 366.7 97.4 365.7 110.3L363.4 139.6zM256 264C249.9 264 244.3 267.5 241.7 272.9L212.5 332.1L147.2 341.6C141.2 342.5 136.2 346.7 134.3 352.5C132.4 358.3 134 364.7 138.3 368.9L185.5 414.9L174.3 479.9C173.3 485.9 175.7 492 180.7 495.6C185.7 499.2 192.2 499.7 197.5 496.8L255.9 466.1L314.3 496.8C319.7 499.6 326.2 499.2 331.1 495.6C336 492 338.5 486 337.5 479.9L326.3 414.9L373.5 368.9C377.9 364.6 379.4 358.3 377.5 352.5C375.6 346.7 370.6 342.5 364.6 341.6L299.3 332.1L270.1 272.9C267.4 267.4 261.8 264 255.8 264z"/>
    </symbol>
  </defs>

  <style>
    .p-bg      { fill: #ffffff; }
    .p-border  { fill: none; stroke: #999999; stroke-width: 0.5; }
    .p-divider { stroke: #999999; stroke-width: 0.3; fill: none; }
    .p-dir     { font-family: Orbitron, monospace; font-size: 0.8mm; fill: #cc0000; font-weight: bold; letter-spacing: 0.2mm; }
    .p-edge    { font-family: 'Share Tech Mono', monospace; font-size: 1.5mm; fill: #333333; }
    .p-name    { font-family: Orbitron, monospace; font-size: 7mm; fill: #222222; font-weight: bold; letter-spacing: 0.5mm; }
    .p-legend-title { font-family: monospace; font-size: 1.4mm; fill: #333333; font-weight: bold; letter-spacing: 0.3mm; }
    .p-legend  { font-family: monospace; font-size: 1.25mm; fill: #444444; }
    .p-disclaim { font-family: 'Share Tech Mono', monospace; font-size: 1mm; fill: #888888; }
  </style>

  <!-- White background -->
  <rect class="p-bg" width="594" height="841"/>

  <!-- Outer border -->
  <rect class="p-border" x="3" y="3" width="588" height="835"/>

  <!-- ── Nested hex map ── -->
  <svg x="<%= map_x.round(1) %>" y="<%= map_y.round(1) %>"
       width="<%= map_w_mm.round(1) %>" height="<%= map_h_mm %>"
       viewBox="0 0 <%= map_w %> <%= map_h %>">
    <%= hex_content.html_safe %>
  </svg>

  <!-- Right strip separator -->
<!--  <line class="p-divider" x1="<%#= map_right.round(1) %>" y1="5" x2="<%#= map_right.round(1) %>" y2="836"/>-->

  <!-- ── COREWARD direction labels (left and right ends, just above map) ── -->
  <text class="p-dir" x="<%= (map_x + 3).round(1) %>" y="<%= (map_y - 0.1).round(1) %>" text-anchor="start">COREWARD</text>
  <text class="p-dir" x="<%= (map_right - 3).round(1) %>" y="<%= (map_y - 0.1).round(1) %>" text-anchor="end">COREWARD</text>

  <!-- Coreward adjacent subsector labels -->
  <% @coreward_subsectors.each do |ss| %>
    <% cx = ss_col_centers[ss.x - 1] %>
    <text class="p-edge" x="<%= cx %>" y="<%= (map_y - 3).round(1) %>" text-anchor="middle">To <%= h(ss.name) %></text>
  <% end %>

  <!-- ── RIMWARD direction labels (left and right ends, just below map) ── -->
  <text class="p-dir" x="<%= (map_x + 3).round(1) %>" y="<%= (map_bottom + 0.1).round(1) %>" text-anchor="start">RIMWARD</text>
  <text class="p-dir" x="<%= (map_right - 3).round(1) %>" y="<%= (map_bottom + 0.1).round(1) %>" text-anchor="end">RIMWARD</text>

  <!-- Rimward adjacent subsector labels -->
  <% @rimward_subsectors.each do |ss| %>
    <% cx = ss_col_centers[ss.x - 1] %>
    <text class="p-edge" x="<%= cx %>" y="<%= (map_bottom + 1.5).round(1) %>" text-anchor="middle">To <%= h(ss.name) %></text>
  <% end %>

  <!-- ── SPINWARD direction labels (rotated −90°, top and bottom of left edge) ── -->
  <%# rotate(-90): screen_x = y_r, screen_y = -x_r. %>
  <text class="p-dir" transform="rotate(-90)"
        x="<%= -(map_y + 25).round(1) %>" y="<%= (map_x + 0.5).round(1) %>"
        text-anchor="start">SPINWARD</text>
  <text class="p-dir" transform="rotate(-90)"
        x="<%= -(map_bottom - 30).round(1) %>" y="<%= (map_x + 0.5).round(1) %>"
        text-anchor="end">SPINWARD</text>

  <!-- Spinward adjacent subsector labels -->
  <% @spinward_subsectors.each do |ss| %>
    <% cy = ss_row_centers[ss.y - 1] %>
    <text class="p-edge" transform="rotate(-90)"
          x="<%= -cy %>" y="<%= (map_x - 2).round(1) %>"
          text-anchor="middle">To <%= h(ss.name) %></text>
  <% end %>

  <!-- ── TRAILING direction labels (rotated +90°, top and bottom of right map edge, reads down) ── -->
  <%# rotate(90): screen_x = -y_r, screen_y = x_r. %>
  <text class="p-dir" transform="rotate(90)"
        x="<%= (map_y + 3).round(1) %>" y="<%= -(strip_x - 2).round(1) %>"
        text-anchor="start">TRAILING</text>
  <text class="p-dir" transform="rotate(90)"
        x="<%= (map_bottom - 3).round(1) %>" y="<%= -(strip_x - 2).round(1) %>"
        text-anchor="end">TRAILING</text>

  <!-- Trailing adjacent subsector labels (rotated +90°, reads down) -->
  <% @trailing_subsectors.each do |ss| %>
    <% cy = ss_row_centers[ss.y - 1] %>
    <text class="p-edge" transform="rotate(90)"
          x="<%= cy %>" y="<%= -(strip_x - 1).round(1) %>"
          text-anchor="middle">To <%= h(ss.name) %></text>
  <% end %>

  <!-- ── Sector name (rotated +90°, right strip, reading downward) ── -->
  <%# rotate(90): screen_x = -y_r, screen_y = x_r. y_r = -strip_cx, x_r = map_center_y. %>
  <text class="p-name" transform="rotate(90)"
        x="<%= map_center_y %>" y="<%= -strip_cx %>"
        text-anchor="middle"><%= h(@sector.name.upcase) %> SECTOR</text>

  <!-- ── Legend (right strip, below map) ── -->
  <text class="p-legend-title" x="<%= (legend_strip_x + 0.5).round(1) %>" y="<%= legend_strip_y %>">LEGEND</text>

  <!-- Amber travel zone -->
  <path d="M <%= (legend_strip_x + 5).round(1) %>,<%= (legend_strip_y + 7).round(1) %> A 3.5,3.5 0 1 1 <%= (legend_strip_x + 12).round(1) %>,<%= (legend_strip_y + 7).round(1) %>"
        fill="none" stroke="#f59e0b" stroke-width="1" stroke-linecap="round"/>
  <text class="p-legend" x="<%= (legend_strip_x + 16).round(1) %>" y="<%= (legend_strip_y + 8).round(1) %>">Amber zone</text>

  <!-- Red travel zone -->
  <path d="M <%= (legend_strip_x + 5).round(1) %>,<%= (legend_strip_y + 16).round(1) %> A 3.5,3.5 0 1 1 <%= (legend_strip_x + 12).round(1) %>,<%= (legend_strip_y + 16).round(1) %>"
        fill="none" stroke="#ef4444" stroke-width="1" stroke-linecap="round"/>
  <text class="p-legend" x="<%= (legend_strip_x + 16).round(1) %>" y="<%= (legend_strip_y + 17).round(1) %>">Red zone</text>

  <!-- Gas giant -->
  <use href="#poster-gas-giant-icon" x="<%= (legend_strip_x + 55).round(1) %>" y="<%= (legend_strip_y + 2).round(1) %>" width="7" height="7" style="fill:#222222"/>
  <text class="p-legend" x="<%= (legend_strip_x + 63).round(1) %>" y="<%= (legend_strip_y + 7).round(1) %>">Gas giant</text>

  <!-- Comet -->
  <use href="#poster-comet-icon" x="<%= (legend_strip_x + 55).round(1) %>" y="<%= (legend_strip_y + 12).round(1) %>" width="7" height="7" style="fill:#222222"/>
  <text class="p-legend" x="<%= (legend_strip_x + 63).round(1) %>" y="<%= (legend_strip_y + 17).round(1) %>">Comet</text>

  <!-- Native sophont -->
  <polygon points="<%= hex_polygon_points(legend_strip_x + 114, legend_strip_y + 5.5, 4) %>" fill="<%= @native_sophont_colour %>" stroke="#999999" stroke-width="0.3"/>
  <text class="p-legend" x="<%= (legend_strip_x + 123).round(1) %>" y="<%= (legend_strip_y + 7).round(1) %>">Native sophont</text>

  <!-- Extinct sophont -->
  <polygon points="<%= hex_polygon_points(legend_strip_x + 114, legend_strip_y + 14.5, 4) %>" fill="<%= @extinct_sophont_colour %>" stroke="#999999" stroke-width="0.3"/>
  <text class="p-legend" x="<%= (legend_strip_x + 123).round(1) %>" y="<%= (legend_strip_y + 16).round(1) %>">Extinct sophont</text>

  <!-- Region border -->
<!--  <line x1="<%#= (strip_x + 13).round(1) %>" y1="<%#= (legend_strip_y + 46).round(1) %>"-->
<!--        x2="<%#= (strip_x + 22).round(1) %>" y2="<%#= (legend_strip_y + 46).round(1) %>"-->
<!--        stroke="#666666" stroke-width="1.5" stroke-linecap="round"/>-->
<!--  <text class="p-legend" x="<%#= (strip_x + 23).round(1) %>" y="<%#= (legend_strip_y + 49).round(1) %>">Region border</text>-->

  <!-- Networks -->
  <% if @networks_on_poster&.any? %>
    <%
      net_legend_y = legend_strip_y + 2
      hex_r        = 4.0
      entry_h      = 10.0
      entry_w      = 55.0
      network_x    = legend_strip_x + 180
      max_rows     = 3
      @networks_on_poster.each_with_index do |net, idx|
        col_idx = idx / max_rows
        row_idx = idx % max_rows
        hx = network_x + hex_r + col_idx * entry_w
        hy = net_legend_y + hex_r + row_idx * entry_h
        colour = net.colour.presence || '#888888'
    %>
      <polygon points="<%= hex_polygon_points(hx, hy, hex_r) %>"
               fill="#ffffff" stroke="#999999" stroke-width="0.4"/>
      <line x1="<%= (hx - hex_r).round(2) %>" y1="<%= hy.round(2) %>"
            x2="<%= hx.round(2) %>" y2="<%= hy.round(2) %>"
            stroke="<%= colour %>" stroke-width="1.5" stroke-opacity="0.85" stroke-linecap="round"/>
      <text class="p-legend" x="<%= (hx + hex_r + 2).round(1) %>" y="<%= (hy + 1).round(1) %>"><%= h(net.name) %></text>
    <% end %>
  <% end %>

  <!-- ── Disclaimer (full width, bottom of poster) ── -->
  <text class="p-disclaim" x="<%= map_x %>" y="<%= disclaim_y %>">Mongoose Publishing permits websites and fanzines for this game, provided it contains this notice, that Mongoose Publishing is notified, and subject to a withdrawal of permission on 90-day notice.</text>
  <text class="p-disclaim" x="<%= map_x %>" y="<%= disclaim_y + 5 %>">The contents are for personal, non-commercial use only. Any use of Mongoose Publishing's copyrighted material or trademarks should not be viewed as a challenge to those copyrights or trademarks. The Traveller game in all forms is owned by Mongoose Publishing.</text>
  <text class="p-disclaim" x="<%= map_x %>" y="<%= disclaim_y + 10 %>">Copyright 1977&#8211;2026 Mongoose Publishing. Traveller is a registered trademark of Mongoose Publishing.</text>

</svg>
