<% preload_tags(@sectors) %>
<div id="sectors" class="w-full pb-4">
  <% if @predefined_sector_count %>
    <% remaining_predefined_sector_count = @predefined_sector_count - @created_predefined_sector_count %>
    <% if remaining_predefined_sector_count > 0 %>
      <aside aria-labelledby="additional-deepnight-sectors" class="flex flex-col sm:flex-row sm:items-center gap-4 mb-4 rounded-xl border border-notice-outline bg-notice-bg text-notice-fg px-4 py-3 text-sm">
        <div class="flex items-center gap-3 flex-1">
          <i class="fa-regular fa-solar-system text-lg text-notice-fg" aria-hidden="true"></i>
          <div>
            <h2 id="additional-deepnight-sectors" class="text-base font-normal text-notice-fg">
              <%= pluralize(remaining_predefined_sector_count, 'additional Deepnight sector') %> available
            </h2>
            <p class="mt-1 text-notice-fg">
              Incognita Citerior, the starting sector, is ready.
              <%= @created_predefined_sector_count %> of <%= @predefined_sector_count %> sectors are created &mdash;
              create the remaining <%= remaining_predefined_sector_count %> to extend the expedition registry.
            </p>
          </div>
        </div>
        <%= render 'create_predefined', label: 'Create Campaign Sectors', hide_icon: true, button_class: 'inline-flex items-center gap-2 whitespace-nowrap rounded-lg border border-notice-outline bg-notice/10 px-3 py-2 text-sm text-notice-fg hover:bg-notice/20' %>
      </aside>
    <% end %>
  <% end %>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-3">
    <%= form_with url: sectors_path,
                  method: :get,
                  data: { turbo_frame: "sectors", controller: "autosubmit", autosubmit_delay_value: 250 },
                  class: "flex items-center gap-2" do %>

      <%= text_field_tag :q, params[:q],
                         placeholder: "Filter sectors…",
                         autocomplete: "off",
                         data: { controller: params[:q].present? ? "autofocus" : nil, action: "input->autosubmit#queue" },
                         class: "w-56 rounded-lg bg-panel border border-outline px-3 py-2" %>

      <% if params[:q].present? %>
        <%= link_to "Clear",
                    sectors_path,
                    data: { turbo_frame: "sectors" },
                    class: "btn" %>
      <% end %>
    <% end %>

  </div>

  <div class='table-card overflow-visible!'>
    <div class='table-banner flex-wrap'>
      <p>Sector registry</p>

      <div class='actions flex-wrap justify-end'>
        <%= render 'operations', show_deepnight_creation: false %>
      </div>
    </div>

    <div class='table-scroll'>
      <table>
        <thead>
        <tr>
          <th scope='col'>Sector</th>
          <th scope='col' class='text-right'>Systems</th>
          <th scope='col'>Allegiances</th>
          <th scope='col' class='text-center'>Charts</th>
          <th scope='col' class='text-center'>Reference</th>
          <th scope='col'>Tags</th>
          <th scope='col' class='text-right whitespace-nowrap w-16 actions-cell'>Actions</th>
        </tr>
        </thead>

        <tbody>
        <% if @sectors.any? %>
          <% @sectors.each do |sector| %>
            <tr class='cursor-pointer'
                data-controller='row-link'
                data-row-link-url-value='<%= sector_path(sector) %>'
                data-action='click->row-link#navigate'>
              <td>
                <%= link_to sector_path(sector),
                            data: { turbo_frame: '_top' },
                            class: 't-link' do %>
                  <span><%= sector.name %></span>
                <% end %>

                <span class='pill ml-4'><%= sector.x %>/<%= sector.y %></span>
              </td>

              <td class='text-right'><%= sector.star_system_count %></td>

              <td><%= render 'allegiances/inline_list', allegiances: (@allegiances_by_sector_id[sector.id] || []) %></td>

              <td class='text-center'>
                <div class='flex items-center justify-center gap-3'>
                  <%= sector_chart_link(sector) %>
                  <%= traveller_map_link(sector) %>
                </div>
              </td>

              <td class='text-center'>
                <%= traveller_wiki_link(sector, current_campaign) %>
              </td>

              <td><%= render 'application/tags', record: sector %></td>

              <td class='actions-cell'>
                <div class='action-group'>
                  <%= render 'application/tag_action', record: sector, label: sector.name %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan='7'>No sectors recorded in this quadrant yet.</td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
    <% if @pagy.pages > 1 %>
      <div class="w-full pb-4">
        <%== @pagy.series_nav %>
      </div>
    <% end %>
  </div>

</div>
