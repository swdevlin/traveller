<div id="sectors" class="w-full pb-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between pb-2">
    <%= form_with url: sectors_path,
                  method: :get,
                  data: { turbo_frame: "sectors", controller: "autosubmit", autosubmit_delay_value: 250 },
                  class: "flex items-center gap-2" do %>

      <%= text_field_tag :q, params[:q],
                         placeholder: "Filter sectors…",
                         autocomplete: "off",
                         data: { controller: params[:q].present? ? "autofocus" : nil, action: "input->autosubmit#queue" },
                         class: "w-56 rounded-lg bg-slate-900/50 border border-slate-700 px-3 py-2" %>

      <% if params[:q].present? %>
        <%= link_to "Clear",
                    sectors_path,
                    data: { turbo_frame: "sectors" },
                    class: "btn" %>
      <% end %>
    <% end %>

    <div class="flex gap-2">
    </div>
  </div>

  <div class='table-card'>
    <div class='table-banner'>
      <p>Sector registry</p>

      <div class='actions'>
        <%= link_to new_sector_path, data: { turbo_frame: '_top' }, class: 'btn-header' do %>
          <i class='fa-regular fa-plus'></i>
          <span>Blank</span>
        <% end %>

        <%= link_to new_from_traveller_map_sectors_path, data: { turbo_frame: '_top' }, class: 'btn-header' do %>
          <i class='fa-regular fa-cloud-arrow-down'></i>
          <span>Import</span>
        <% end %>
      </div>
    </div>

    <div class='table-scroll'>
      <table>
        <thead>
        <tr>
          <th scope='col'>Sector</th>
          <th scope='col'>Star chart</th>
          <th scope='col'>Library</th>
        </tr>
        </thead>

        <tbody>
        <% if @sectors.any? %>
          <% @sectors.each do |sector| %>
            <tr>
              <td>
                <%= link_to sector_path(sector),
                            data: { turbo_frame: '_top' },
                            class: 't-link' do %>
                  <span><%= sector.name %></span>
                <% end %>

                <span class='pill ml-4'><%= sector.x %>/<%= sector.y %></span>
              </td>

              <td>
                <%= link_to sector.traveller_map_url, target: '_blank', rel: 'noopener', class: 't-link' do %>
                  Traveller Map
                <% end %>
              </td>

              <td>
                <% if sector.wiki_link.present? %>
                  <%= link_to sector.wiki_link, target: '_blank', rel: 'noopener', class: 't-link' do %>
                    <span>Traveller Wiki</span>
                  <% end %>
                <% else %>
                  <span class='text-xs text-slate-500'>No registry link</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan='3'>No sectors recorded in this quadrant yet.</td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
    <div class="w-full pb-4">
      <%== @pagy.series_nav %>
    </div>
  </div>

</div>
