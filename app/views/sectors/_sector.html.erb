<div id="<%= dom_id sector %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Imperial Coordinates</strong>
    <%= sector.x %>/<%= sector.y %>
  </div>

  <% if (reference_url = safe_external_url(sector.effective_reference_url(current_campaign))) %>
    <div>
      <p>
        <strong>Library data:</strong>
        <%= link_to "Reference", reference_url, target: "_blank", rel: "noopener", class: "link-traveller" %>
      </p>
    </div>
  <% end %>

  <div>
    <p>
      <strong>Imperial star chart:</strong>
      <% unless sector.traveller_map_url.nil? %>
        <%= link_to "Traveller Map", sector.traveller_map_url, target: "_blank", rel: "noopener", class: "link-traveller" %>
      <% else %>
        <span>Undocumented</span>
      <% end %>
    </p>
  </div>

  <% render  %>
</div>
