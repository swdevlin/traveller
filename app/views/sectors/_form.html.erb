<%= form_with(model: sector, class: "contents", multipart: true) do |form| %>
  <div class='space-y-6 pb-10'>
    <% base_errors = sector.errors.where(:base) %>
    <% if base_errors.any? %>
      <div class="rounded-2xl border border-red-900/50 bg-red-950/30 p-4">
        <ul class="space-y-1 text-sm text-red-100">
          <% base_errors.each do |error| %>
            <li class="flex gap-2">
              <span class="select-none text-red-300">&bull;</span>
              <span class="font-mono break-words"><%= error.full_message.html_safe %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div data-tour-step='sector-name'>
      <%= render 'application/name_generator_field', form: form %>
    </div>

    <div data-tour-step='sector-abbreviation'>
      <%= render 'application/edit_field', form: form, attribute: :abbreviation do %>
        <%= form.text_field :abbreviation, class: 'edit-base w-24' %>
      <% end %>
    </div>

    <div data-tour-step='sector-coordinates'>
      <span class='edit-label'>Imperial Coordinates</span>

      <%= render 'application/edit_field', form: form, attribute: :x, field_label: 'X', required: true do %>
        <%= form.number_field :x, class: 'coord-input edit-base' %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :y, field_label: 'Y', required: true do %>
        <%= form.number_field :y, class: 'coord-input edit-base' %>
      <% end %>
    </div>

    <% if sector.new_record? %>
      <% settled = sector.default_build_spec.to_s.include?('populated') %>
      <div data-controller='settled-build'
           data-settled-build-settled-yaml-value="<%= SectorsController::SETTLED_BUILD_SPEC %>"
           data-settled-build-basic-yaml-value="<%= SectorsController::BASIC_BUILD_SPEC %>"
           >
        <div data-tour-step='sector-settled'>
          <%= render 'application/boolean_toggle',
                     form: form,
                     attribute: :settled,
                     checked: settled,
                     label: 'Settled space',
                     checkbox_data: { 'settled-build-target': 'checkbox', action: 'change->settled-build#toggle' } %>
        </div>

        <% if current_campaign.homebrew? %>
          <div class='mt-4'>
            <div class='edit-label'>T5 Tab Delimited File (optional)</div>
            <p class='text-xs text-fg-muted mt-1'>
              Upload a whole-sector
              <%= link_to 'T5 Tab Delimited', 'https://travellermap.com/doc/fileformats#t5tab', target: '_blank', rel: 'noopener', class: 'no-underline hover:underline hover:underline-offset-2' %>
              file to seed each subsector&rsquo;s build configuration individually, overriding the build plan below. Survey index still comes from Settled space above.
            </p>
            <%= render 'application/file_field',
                       name: 't5_file', accept: '.txt,.tab', wrapper_class: 'w-full mt-2',
                       data: { 'settled-build-target': 'fileInput', action: 'change->settled-build#toggleFileLock' } %>
          </div>
        <% end %>

        <div class='mt-4' data-tour-step='sector-build-plan'>
          <p data-settled-build-target='fileLockNotice' class='hidden text-xs text-fg-muted mb-1'>
            Locked &mdash; overridden by the uploaded T5 file above.
          </p>
          <%= render 'application/build_config',
                     form: form,
                     attribute: :default_build_spec,
                     textarea_data: { 'settled-build-target': 'textarea' } %>
        </div>
      </div>
    <% end %>

    <div>
      <%= render 'application/edit_field', form: form, attribute: :reference_url, field_label: 'Reference link' do %>
        <%= form.text_field :reference_url, class: 'edit-base w-full' %>
      <% end %>
    </div>

    <div class='edit-row-notes' data-tour-step='sector-observations'>
      <div class='edit-label'>Observations</div>
      <%= form.text_area :notes, rows: 6, class: 'edit-base mt-2 w-full resize-y' %>
      <%= render 'application/field_error', form: form, attribute: :notes %>
    </div>

    <div class='pt-2 flex flex-row gap-2'>
      <%= form.submit sector.persisted? ? 'Update core' : 'Commit Core', class: 'btn btn-primary' %>
      <%= link_to 'Cancel', sector.persisted? ? sector : sectors_path, class: 'btn' %>
    </div>
  </div>
<% end %>
