<%= form_with(model: sector, class: "contents") do |form| %>
  <div class='space-y-6 pb-10'>
    <div>
      <div class='mt-4'>
        <div class='min-w-0'>
          <div class='edit-label'>
            Name
          </div>

          <%= form.text_field :name,
                              class: 'edit-base mt-2' %>
          <%= render 'application/field_error', form: form, attribute: :name %>
        </div>
      </div>
    </div>

    <div>
      <div class='mt-4'>
        <div class='min-w-0'>
          <div class='edit-label'>
            Abbreviation
          </div>

          <%= form.text_field :abbreviation,
                              class: 'edit-base mt-2 w-24' %>
          <%= render 'application/field_error', form: form, attribute: :abbreviation %>
        </div>
      </div>
    </div>

    <div>
      <div class='mt-4'>
        <span class="edit-label">Imperial Coordinates</span>

        <div class="mt-2 flex flex-wrap gap-6">
          <div>
            <div class='edit-label'>
              X
            </div>
            <%= form.number_field :x,
                                  class: 'coord-input edit-base mt-2' %>
            <%= render 'application/field_error', form: form, attribute: :x %>
          </div>

          <div>
            <div class='edit-label'>
              Y
            </div>
            <%= form.number_field :y,
                                  class: 'coord-input edit-base mt-2' %>
            <%= render 'application/field_error', form: form, attribute: :y %>
          </div>
        </div>
      </div>
    </div>

    <div>
      <div class='edit-label'>
        Observations
      </div>

      <%= form.text_area :notes,
                         rows: 6,
                         class: 'mt-2 w-full edit-base resize-y' %>
      <%= render 'application/field_error', form: form, attribute: :notes %>
    </div>

    <div class='pt-2 flex flex-col sm:flex-row gap-2'>
      <%= form.submit 'Update core', class: 'w-full sm:w-auto btn btn-primary' %>
      <%= link_to 'Cancel', sector, class: 'w-full sm:w-auto btn' %>
    </div>
  </div>
<% end %>
