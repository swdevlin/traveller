<%= form_with(model: sector, class: "contents", multipart: true) do |form| %>
  <div class='space-y-6 pb-10'>
    <% base_errors = sector.errors.where(:base) %>
    <% if base_errors.any? %>
      <div class="rounded-2xl border border-red-900/50 bg-red-950/30 p-4">
        <ul class="space-y-1 text-sm text-red-100">
          <% base_errors.each do |error| %>
            <li class="flex gap-2">
              <span class="select-none text-red-300">&bull;</span>
              <span class="font-mono break-words"><%= error.full_message.html_safe %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div data-tour-step='sector-name'>
      <%= render 'application/name_generator_field', form: form %>
    </div>

    <div data-tour-step='sector-abbreviation'>
      <%= render 'application/edit_field', form: form, attribute: :abbreviation do %>
        <%= form.text_field :abbreviation, class: 'edit-base w-24' %>
      <% end %>
    </div>

    <div data-tour-step='sector-coordinates'>
      <span class='edit-label'>Imperial Coordinates</span>

      <%= render 'application/edit_field', form: form, attribute: :x, field_label: 'X', required: true do %>
        <%= form.number_field :x, class: 'coord-input edit-base' %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :y, field_label: 'Y', required: true do %>
        <%= form.number_field :y, class: 'coord-input edit-base' %>
      <% end %>
    </div>

    <% if sector.new_record? %>
      <% mode = sector.creation_mode.presence || 'options' %>
      <% mode_class = ->(*modes) { 'hidden' unless modes.include?(mode) } %>
      <% mode_choices = [['options', 'Same for every subsector', 'All subsectors in the sector have the same density and population characteristics.'],
                         ['subsectors', 'Set each subsector separately', 'Name each subsector and choose its own density and settings.']] %>
      <% mode_choices << ['t5', 'T5 import', 'Seed the subsectors from a T5 Tab Delimited file.'] if current_campaign.homebrew? %>

      <div data-controller='subsector-settings' class='space-y-6'>
        <div data-tour-step='sector-creation-mode'>
          <div class='edit-label'>Creation method</div>
          <div class='mt-2 space-y-2'>
            <% mode_choices.each do |value, label, hint| %>
              <label class='flex items-start gap-3 cursor-pointer'>
                <%= form.radio_button :creation_mode, value,
                                      checked: mode == value,
                                      class: 'mt-1 accent-highlight',
                                      data: { subsector_settings_target: 'mode', action: 'change->subsector-settings#changeMode' } %>
                <span>
                  <span class='block text-sm text-fg-bright'><%= label %></span>
                  <span class='block text-xs text-fg-muted'><%= hint %></span>
                </span>
              </label>
            <% end %>
          </div>
        </div>

        <div data-subsector-settings-target='section' data-modes='options' class='space-y-6 <%= mode_class.call('options') %>'>
          <div data-tour-step='sector-density'>
            <label for='sector_density' class='edit-label'>Star system density</label>
            <p class='text-xs text-fg-muted mt-1'>Chance that each parsec holds a star system.</p>
            <%= form.select :density, SectorBuildSpec::DENSITY_OPTIONS, {}, class: 'edit-base mt-2', data: { subsector_settings_target: 'density' } %>
          </div>

          <div data-tour-step='sector-max-tech-level'>
            <label for='sector_max_tech_level' class='edit-label'>Maximum tech level</label>
            <p class='text-xs text-fg-muted mt-1'>No generated system will exceed this tech level.</p>
            <%= form.number_field :max_tech_level, min: SectorBuildSpec::MAX_TECH_LEVEL_RANGE.min, max: SectorBuildSpec::MAX_TECH_LEVEL_RANGE.max,
                                  value: sector.max_tech_level || SectorBuildSpec::DEFAULT_MAX_TECH_LEVEL,
                                  class: 'edit-base mt-2 w-24', data: { subsector_settings_target: 'maxTechLevel' } %>
          </div>

          <div data-tour-step='sector-settled'>
            <%= render 'application/boolean_toggle',
                       form: form,
                       attribute: :settled,
                       checked: sector.settled.present?,
                       label: 'Settled space',
                       checkbox_data: { 'subsector-settings-target': 'settled' },
                       hint: 'Generate populated systems.' %>
          </div>
        </div>

        <div data-subsector-settings-target='section' data-modes='options t5' class='<%= mode_class.call('options', 't5') %>' data-tour-step='sector-systems-known'>
          <%= render 'application/boolean_toggle',
                     form: form,
                     attribute: :systems_known,
                     checked: sector.systems_known.present?,
                     label: 'Systems known',
                     checkbox_data: { 'subsector-settings-target': 'known' },
                     hint: 'Players have already surveyed these systems.' %>
        </div>

        <div data-subsector-settings-target='section' data-modes='subsectors' class='<%= mode_class.call('subsectors') %>'>
          <%= render 'sectors/subsector_settings', sector: sector %>
        </div>

        <% if current_campaign.homebrew? %>
          <div data-subsector-settings-target='section' data-modes='t5' class='<%= mode_class.call('t5') %>'>
            <div class='edit-label'>T5 Tab Delimited File</div>
            <p class='text-xs text-fg-muted mt-1'>
              Upload a whole-sector
              <%= link_to 'T5 Tab Delimited', 'https://travellermap.com/doc/fileformats#t5tab', target: '_blank', rel: 'noopener', class: 'no-underline hover:underline hover:underline-offset-2' %>
              file to seed each subsector&rsquo;s build configuration individually. The survey index still comes from Systems known.
            </p>
            <%= render 'application/file_field', name: 't5_file', accept: '.txt,.tab', wrapper_class: 'w-full mt-2' %>
          </div>
        <% end %>

        <div data-tour-step='sector-populate'>
          <%= render 'application/boolean_toggle',
                     form: form,
                     attribute: :populate_subsectors,
                     checked: sector.populate_subsectors.present?,
                     label: 'Populate subsectors',
                     hint: 'Queue generation of each subsector as soon as it has been created.' %>
        </div>
      </div>
    <% end %>

    <div>
      <%= render 'application/edit_field', form: form, attribute: :reference_url, field_label: 'Reference link' do %>
        <%= form.text_field :reference_url, class: 'edit-base w-full' %>
      <% end %>
    </div>

    <div class='edit-row-notes' data-tour-step='sector-observations'>
      <div class='edit-label'>Observations</div>
      <%= form.text_area :notes, rows: 6, class: 'edit-base mt-2 w-full resize-y' %>
      <%= render 'application/field_error', form: form, attribute: :notes %>
    </div>

    <div class='pt-2 flex flex-row gap-2'>
      <%= form.submit sector.persisted? ? 'Update core' : 'Commit Core', class: 'btn btn-primary' %>
      <%= link_to 'Cancel', sector.persisted? ? sector : sectors_path, class: 'btn' %>
    </div>
  </div>
<% end %>
