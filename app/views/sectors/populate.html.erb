<% content_for :title, 'Populating sector' %>

<div class='w-full'>
  <h1 class='font-bold text-4xl mb-4'>
    Populating <%= @sector.name %>
  </h1>

  <div class='flex flex-col md:flex-row md:items-start gap-6'>
    <div class='flex-1 min-w-0'>
      <% if @sector.notes.present? %>
        <div class='mb-4'>
          <strong class='block text-sm font-semibold mb-1'>Notes</strong>
          <p class='text-sm whitespace-pre-line'>
            <%= @sector.notes %>
          </p>
        </div>
      <% end %>

      <% subsectors = @sector.subsectors.order(:y, :x) %>
      <% all_have_build = subsectors.all? { |s| s.build.present? } %>

      <div class="overflow-hidden rounded-xl border border-slate-700/60 bg-slate-900/70 shadow-xl">
        <div class="bg-gradient-to-r from-slate-900 via-sky-900/40 to-slate-900 px-4 py-3 sm:px-6 sm:py-4">
          <div class="flex items-center justify-between gap-3">
            <p class="text-xs font-medium tracking-[0.2em] text-slate-300 uppercase">
              Subsectors
            </p>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="min-w-full table-fixed divide-y divide-slate-700 text-sm">
            <thead class="bg-slate-900/80">
              <tr>
                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-300 w-16">
                  Code
                </th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-300">
                  Name
                </th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-300 w-32">
                  Type
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800 bg-slate-950/60">
              <% subsectors.each do |subsector| %>
                <tr class="transition hover:bg-slate-900/80">
                  <td class="px-4 py-3 whitespace-nowrap align-middle">
                    <%= subsector.abbreviation %>
                  </td>

                  <td class="px-4 py-3 whitespace-nowrap align-middle">
                    <%= link_to subsector.name, subsector, class: 'link-traveller-i' %>
                  </td>

                  <td class="px-4 py-3 whitespace-nowrap align-middle">
                    <% if subsector.build.present? %>
                      <%
                        begin
                          config = YAML.safe_load(subsector.build, permitted_classes: [], permitted_symbols: [], aliases: false)
                          chance_value = config['chance']&.upcase if config.is_a?(Hash)
                        rescue
                          chance_value = nil
                        end
                      %>
                      <% if chance_value.present? %>
                        <span class="font-mono text-slate-200"><%= chance_value %></span>
                      <% else %>
                        <span class="text-green-400">
                          <i class="fa-solid fa-check mr-1"></i>
                          Configured
                        </span>
                      <% end %>
                    <% else %>
                      <%= link_to edit_subsector_path(subsector), class: "text-slate-400 hover:text-traveller-red/90" do %>
                        <i class="fa-solid fa-minus mr-1"></i>
                        Not configured
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div class='mt-4 flex flex-col sm:flex-row gap-2'>
        <% confirm_msg = "There are #{pluralize(@star_system_count, "star system")} and #{pluralize(@rogue_count, "rogue stellar object")} in the sector. Are you sure you wish to replace them?" %>
        <%= form_with(model: @sector, url: generate_sector_path(@sector), method: :post, class: 'contents') do |form| %>
          <%= form.submit 'Generate',
                          class: ['w-full sm:w-auto btn btn-primary', { 'opacity-50 cursor-not-allowed' => !all_have_build }],
                          disabled: !all_have_build,
                          data: { turbo_confirm: confirm_msg },
                          title: all_have_build ? 'Generate all subsectors' : 'All subsectors must have a build configuration' %>
        <% end %>

        <%= link_to 'Cancel',
                    @sector,
                    class: 'w-full sm:w-auto btn' %>
      </div>

      <% unless all_have_build %>
        <p class="mt-2 text-sm text-slate-400">
          <i class="fa-solid fa-circle-info mr-1"></i>
          Configure a build for each subsector before generating the sector.
        </p>
      <% end %>
    </div>

    <div class='w-full md:w-[300px] shrink-0'>
      <%= render 'subsector_grid', sector: @sector %>
      <p class="mt-4">Sectors</p>
      <%= render 'sector_grid', sector: @sector %>
    </div>
  </div>
</div>
