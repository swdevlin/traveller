<% content_for :title, 'New sector' %>

<%= turbo_tour 'sector_new' unless Current.user&.tour_completed?('sector_new') %>

<%= render 'application/page' do %>
  <div class='space-y-6'>
    <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>IISS Registry</div>
    <h1 class='text-2xl font-header text-highlight'>New sector</h1>

    <%= render 'form', sector: @sector %>
  </div>
<% end %>
