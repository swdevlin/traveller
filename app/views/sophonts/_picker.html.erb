<%# locals: form, stellar_object — choose an existing sophont, or name a new one (created with this system as its home). %>
<%= render 'application/edit_field', form: form, attribute: :sophont_id, field_label: 'Sophont' do %>
  <div class='flex flex-col gap-2 sm:flex-row sm:items-center'>
    <%= form.select :sophont_id,
                    Sophont.ordered.pluck(:name, :id),
                    { include_blank: '— None —', selected: stellar_object.sophont_id },
                    { class: 'edit-base' } %>
    <%= form.text_field :new_sophont_name,
                        placeholder: 'or name a new sophont',
                        autocomplete: 'off',
                        class: 'edit-base w-full sm:max-w-xs' %>
  </div>
<% end %>
