<%# locals: stellar_object — the "Native Sophont" data block: the linked sophont name when the world has a native sophont with one recorded, otherwise Extant / None. Extinct sophonts are shown by sophonts/_extinct. %>
<% native = stellar_object.native_sophont %>
<% name = (render('sophonts/name', stellar_object: stellar_object).presence if native) %>
<%= render 'application/data_block', label: 'Native Sophont', value: name || (native ? 'Extant' : 'None') %>
