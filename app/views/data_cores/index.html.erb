          </div>
          <div class='menu-chevron'>
            <i class='fa-regular fa-chevron-right'></i>
          </div>
        <% end %>

        <%= link_to law_levels_path, class: 'menu-row' do %>
          <div class='flex items-center gap-4'>
            <div class='menu-icon'>
              <i class='fa-regular fa-gavel text-fg-bright'></i>
