<%= content_for :title, 'Data Cores' %>
<%= content_for :page_kicker, 'System Configuration' %>
<%= content_for :page_title, 'Data Cores' %>

<%= render 'application/page' do %>
  <div class='lg:w-2/3'>
    <div class='menu-card'>
      <div class='menu-list'>
        <%= link_to allegiances_path, class: 'menu-row group' do %>
          <div class='flex items-center gap-4'>
            <div class='menu-icon'>
              <i class='fa-regular fa-flag text-fg-bright'></i>
            </div>
            <div>
              <h2 class='menu-title'>Allegiances</h2>
              <p class='menu-description'>
                Define political codes and display names used for populated systems.
              </p>
            </div>
          </div>
          <div class='menu-chevron'>
            <i class='fa-regular fa-chevron-right'></i>
          </div>
        <% end %>

        <%= link_to facilities_path, class: 'menu-row' do %>
          <div class='flex items-center gap-4'>
            <div class='menu-icon'>
              <i class='fa-regular fa-space-station-moon text-fg-bright'></i>
            </div>
            <div>
              <h2 class='menu-title'>Bases</h2>
              <p class='menu-description'>Define bases and facilities.</p>
            </div>
          </div>
          <div class='menu-chevron'>
            <i class='fa-regular fa-chevron-right'></i>
          </div>
        <% end %>

        <%= link_to governments_path, class: 'menu-row' do %>
          <div class='flex items-center gap-4'>
            <div class='menu-icon'>
              <i class='fa-regular fa-building-columns text-fg-bright'></i>
            </div>
            <div>
              <h2 class='menu-title'>Governments</h2>
              <p class='menu-description'>Government codes and descriptions.</p>
            </div>
          </div>
          <div class='menu-chevron'>
            <i class='fa-regular fa-chevron-right'></i>
          </div>
        <% end %>

        <%= link_to jump_routes_path, class: 'menu-row' do %>
          <div class='flex items-center gap-4'>
            <div class='menu-icon'>
              <i class='fa-regular fa-route text-fg-bright'></i>
            </div>
            <div>
              <h2 class='menu-title'>Jump Routes</h2>
              <p class='menu-description'>
                Define jump routes and connections between star systems.
              </p>
            </div>
          </div>
          <div class='menu-chevron'>
            <i class='fa-regular fa-chevron-right'></i>
          </div>
        <% end %>

        <%= link_to languages_path, class: 'menu-row' do %>
          <div class='flex items-center gap-4'>
            <div class='menu-icon'>
              <i class='fa-regular fa-language text-fg-bright'></i>
