          </div>
          <div class='menu-chevron'>
            <i class='fa-regular fa-chevron-right'></i>
          </div>
        <% end %>

        <%= link_to trade_codes_path, class: 'menu-row' do %>
          <div class='flex items-center gap-4'>
            <div class='menu-icon'>
              <i class='fa-regular fa-tags text-fg-bright'></i>
            </div>
            <div>
              <h2 class='menu-title'>Trade Codes</h2>
              <p class='menu-description'>Initial trade codes are from T5.</p>
            </div>
          </div>
          <div class='menu-chevron'>
            <i class='fa-regular fa-chevron-right'></i>
          </div>
        <% end %>

        <%= link_to travel_zones_path, class: 'menu-row' do %>
          <div class='flex items-center gap-4'>
            <div class='menu-icon'>
              <i class='fa-regular fa-circle-dot text-fg-bright'></i>
            </div>
            <div>
              <h2 class='menu-title'>Travel Zones</h2>
              <p class='menu-description'>
                Amber, red, and custom hazard classifications for star systems.
              </p>
            </div>
          </div>
          <div class='menu-chevron'>
            <i class='fa-regular fa-chevron-right'></i>
          </div>
        <% end %>
      </div>
    </div>
  </div>
