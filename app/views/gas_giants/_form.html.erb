<% star = stellar_object.orbiting %>

<%= render 'stellar_objects/form_scaffold', stellar_object: stellar_object, wrapper_class: 'space-y-2 pb-10', show_known_field: false, notes_wrapper_class: 'edit-row-notes',
   url: local_assigns[:url], cancel_url: local_assigns[:cancel_url], submit_label: local_assigns[:submit_label] do |form| %>
  <% if star %>
    <div class='flex items-center gap-2 pt-2'>
      <div class='text-xs uppercase tracking-[0.22em] text-highlight-fg'>Orbital Data</div>
      <div class='h-px flex-1 bg-panel'></div>
    </div>

    <%= render 'application/edit_field', form: form, attribute: :orbit, field_label: 'Orbit #', required: true do %>
      <%= form.number_field :orbit,
                            value: stellar_object.orbit,
                            class: 'edit-base sm:w-28 w-24',
                            step: 'any',
                            min: star.minimum_allowable_orbit %>
    <% end %>

    <%= form.fields_for :data, (stellar_object.data || {}) do |df| %>
      <%= render 'application/edit_field', form: form, attribute: :period, required: true, unit: 'days' do %>
        <%= df.number_field :period,
                            value: stellar_object.period,
                            class: 'edit-base sm:w-28 w-24',
                            step: 'any' %>
      <% end %>

      <%= render 'application/edit_field', form: form, attribute: :rotation, unit: 'hours' do %>
        <%= df.number_field :rotation,
                            value: stellar_object.rotation,
                            class: 'edit-base sm:w-28 w-24',
                            step: 'any' %>
      <% end %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :inclination, required: true, unit: '°' do %>
      <%= form.number_field :inclination,
                            value: stellar_object.inclination,
                            class: 'edit-base sm:w-28 w-24',
                            step: 'any' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :eccentricity, required: true do %>
      <%= form.number_field :eccentricity,
                            value: stellar_object.eccentricity,
                            class: 'edit-base sm:w-28 w-24',
                            step: 'any' %>
    <% end %>
  <% end %>

  <div class='flex items-center gap-2 pt-2'>
    <div class='text-xs uppercase tracking-[0.22em] text-highlight-fg'>Physical Data</div>
    <div class='h-px flex-1 bg-panel'></div>
  </div>

  <%= form.fields_for :data, (stellar_object.data || {}) do |df| %>
    <%= render 'application/edit_field', form: form, attribute: :code, required: true do %>
      <%= df.select :code,
                    options_for_select(GasGiant::SIZES.map { |code, size| ["#{code} (#{size})", code] }, stellar_object.code),
                    { include_blank: 'Select code' },
                    class: 'edit-base w-40' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :axial_tilt, field_label: 'Axial tilt', required: true, unit: '°' do %>
      <%= df.number_field :axial_tilt,
                          value: stellar_object.axial_tilt,
                          class: 'edit-base sm:w-28 w-24',
                          step: 'any' %>
    <% end %>
  <% end %>

  <%= render 'application/edit_field', form: form, attribute: :diameter, required: true, unit: 'km' do %>
    <%= form.number_field :diameter,
                          value: stellar_object.diameter,
                          class: 'edit-base sm:w-28 w-24',
                          step: 'any' %>
  <% end %>

  <%= render 'application/edit_field', form: form, attribute: :mass, field_label: 'Mass ☉' do %>
    <%= form.number_field :mass,
                          value: stellar_object.mass,
                          class: 'edit-base sm:w-28 w-24',
                          step: 'any' %>
  <% end %>
<% end %>
