<% star = stellar_object.orbiting_star %>

<%= form_with(model: stellar_object, scope: :stellar_object, url: stellar_object_path(stellar_object), class: "contents") do |form| %>
  <div class="space-y-6 pb-10">
    <% base_errors = stellar_object.errors.where(:base) %>
    <% if base_errors.any? %>
      <div class="rounded-2xl border border-red-900/50 bg-red-950/30 p-4">
        <ul class="space-y-1 text-sm text-red-100">
          <% base_errors.each do |error| %>
            <li class="flex gap-2">
              <span class="select-none text-red-300">&bull;</span>
              <span class="font-mono break-words"><%= error.full_message %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <div class="edit-label">Name<%= required_icon(stellar_object, :name) %></div>
      <%= form.text_field :name, class: 'edit-base mt-2 w-full sm:max-w-xl' %>
      <%= render 'application/field_error', form: form, attribute: :name %>
    </div>

    <% if star %>
      <div class="flex items-center gap-2 pt-2">
        <div class="text-xs uppercase tracking-[0.22em] text-deepnight-orange">Orbital Data</div>
        <div class="h-px flex-1 bg-slate-700/70"></div>
      </div>

      <div>
        <div class="edit-label">Orbit<%= required_icon(stellar_object, :orbit) %></div>
        <%= form.number_field :orbit, value: format_precision(stellar_object.orbit, precision: 5),
                              class: 'edit-base mt-2 sm:w-28 w-24', step: 'any',
                              min: star.minimum_orbit %>
        <%= render 'application/field_error', form: form, attribute: :orbit %>
      </div>

      <%= form.fields_for :data, (stellar_object.data || {}) do |df| %>
        <div>
          <div class="edit-label">Period<%= required_icon(stellar_object, :period) %></div>
          <%= df.number_field :period, value: format_precision(stellar_object.period, precision: 5),
                              class: 'edit-base mt-2 sm:w-28 w-24', step: 'any' %>
          <%= render 'application/field_error', form: form, attribute: :period %>
        </div>

        <div>
          <div class="edit-label">Rotation<%= required_icon(stellar_object, :rotation) %></div>
          <%= df.number_field :rotation, value: format_precision(stellar_object.rotation, precision: 5),
                              class: 'edit-base mt-2 sm:w-28 w-24', step: 'any' %>
          <%= render 'application/field_error', form: form, attribute: :rotation %>
        </div>
      <% end %>

      <div>
        <div class="edit-label">Inclination<%= required_icon(stellar_object, :inclination) %></div>
        <%= form.number_field :inclination, value: format_precision(stellar_object.inclination, precision: 5),
                              class: 'edit-base mt-2 sm:w-28 w-24', step: 'any' %>
        <%= render 'application/field_error', form: form, attribute: :inclination %>
      </div>

      <div>
        <div class="edit-label">Eccentricity<%= required_icon(stellar_object, :eccentricity) %></div>
        <%= form.number_field :eccentricity, value: format_precision(stellar_object.eccentricity, precision: 5),
                              class: 'edit-base mt-2 sm:w-28 w-24', step: 'any' %>
        <%= render 'application/field_error', form: form, attribute: :eccentricity %>
      </div>
    <% end %>

    <div class="flex items-center gap-2 pt-2">
      <div class="text-xs uppercase tracking-[0.22em] text-deepnight-orange">Physical Data</div>
      <div class="h-px flex-1 bg-slate-700/70"></div>
    </div>

    <%= form.fields_for :data, (stellar_object.data || {}) do |df| %>
      <div>
        <div class="edit-label">Code<%= required_icon(stellar_object, :code) %></div>
        <%= df.select :code,
                      options_for_select([['GS', 'GS'], ['GM', 'GM'], ['GL', 'GL']], stellar_object.code),
                      { include_blank: 'Select code' },
                      class: 'edit-base mt-2 w-24' %>
        <%= render 'application/field_error', form: form, attribute: :code %>
      </div>
    <% end %>

    <div>
      <div class="edit-label">Diameter<%= required_icon(stellar_object, :diameter) %></div>
      <%= form.number_field :diameter, value: format_precision(stellar_object.diameter, precision: 5),
                            class: 'edit-base mt-2 sm:w-28 w-24', step: 'any' %>
      <%= render 'application/field_error', form: form, attribute: :diameter %>
    </div>

    <div>
      <div class="edit-label">Mass ☉<%= required_icon(stellar_object, :mass) %></div>
      <%= form.number_field :mass, value: format_precision(stellar_object.mass, precision: 5),
                            class: 'edit-base mt-2 sm:w-28 w-24', step: 'any' %>
      <%= render 'application/field_error', form: form, attribute: :mass %>
    </div>

    <div>
      <div class="edit-label">Observations<%= required_icon(stellar_object, :notes) %></div>
      <%= form.text_area :notes, rows: 6, class: 'edit-base mt-2 w-full resize-y' %>
      <%= render 'application/field_error', form: form, attribute: :notes %>
    </div>

    <div class="pt-2 flex flex-col sm:flex-row gap-2">
      <%= form.submit 'Update core', class: 'w-full sm:w-auto btn btn-primary' %>
      <%= link_to 'Cancel', stellar_object_path(stellar_object), class: 'w-full sm:w-auto btn' %>
    </div>
  </div>
<% end %>
