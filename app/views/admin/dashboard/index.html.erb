<% content_for :title, 'Dashboard' %>
<% content_for :page_kicker, 'Administration' %>
<% content_for :page_title, 'Dashboard' %>

<%= render 'application/page' do %>
  <%= render 'admin/nav' %>

  <div class='space-y-6'>
    <%= render 'application/subsection', title: 'Campaigns' %>

    <div class='grid grid-cols-2 gap-4 sm:grid-cols-5'>
      <%= render 'application/data_block', label: 'Total', value: @campaign_count %>
      <% @campaigns_by_type.sort_by { |_type, count| -count }.each do |type, count| %>
        <%= render 'application/data_block', label: type.humanize, value: count %>
      <% end %>
      <%= render 'application/data_block', label: 'Referees', value: @referee_count %>
    </div>

    <div class='grid grid-cols-2 gap-4 sm:grid-cols-4'>
      <%= render 'application/data_block', label: 'New this week', value: @campaigns_created_this_week %>
      <%= render 'application/data_block', label: 'New this month', value: @campaigns_created_this_month %>
      <%= render 'application/data_block', label: 'Referee page views (7d)', value: @referee_views_7d %>
      <%= render 'application/data_block', label: 'Player page views (7d)', value: @player_views_7d %>
      <%= render 'application/data_block', label: 'Starmap users (7d)', value: @feature_totals_7d[:starmap_users] %>
      <%= render 'application/data_block', label: 'Rule searches (7d)', value: @feature_totals_7d[:rule_searches] %>
      <%= render 'application/data_block', label: 'Handouts (7d)', value: @feature_totals_7d[:handouts] %>
    </div>

    <p class='text-sm text-fg-muted'>Per-campaign feature usage is on the <%= link_to 'Metrics', admin_metrics_path, class: 'no-underline hover:underline text-highlight-fg' %> page.</p>

    <div class='table-card compact'>
      <div class='table-banner'>
        <p>Campaign registry</p>
        <div class='actions'>
          <span class='text-xs uppercase tracking-wide text-fg-muted'>Last 7 days</span>
        </div>
      </div>

      <div class='table-scroll'>
        <table>
          <thead>
          <tr>
            <th scope='col'>Campaign</th>
            <th scope='col'>Type</th>
            <th scope='col' class='text-right'>Sectors</th>
            <th scope='col' class='text-right'>Systems</th>
            <th scope='col' class='text-right'>Referee</th>
            <th scope='col' class='text-right'>Player</th>
            <th scope='col'>Created</th>
            <th scope='col'>Last accessed</th>
          </tr>
          </thead>

          <tbody>
          <% @campaigns.each do |row| %>
            <% campaign = row[:campaign] %>
            <tr>
              <td>
                <span class='font-medium' title='<%= campaign.referee.email_address %>'><%= campaign.slug %></span><br>
                <span class='text-fg-muted'><%= campaign.name %></span>
              </td>
              <td><span class='pill'><%= campaign.campaign_type.humanize %></span></td>
              <td class='text-right'><%= row[:sector_count] || 'n/a' %></td>
              <td class='text-right'><%= row[:star_system_count] || 'n/a' %></td>
              <td class='text-right'><%= row[:referee_views] || 'n/a' %></td>
              <td class='text-right'><%= row[:player_views] || 'n/a' %></td>
              <td><%= campaign.created_at.to_date.iso8601 %></td>
              <td><%= campaign.last_active_at&.to_date&.iso8601 || 'Never' %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
      <div class='w-full pb-4'>
        <%== @pagy.series_nav %>
      </div>
    </div>
  </div>
<% end %>
