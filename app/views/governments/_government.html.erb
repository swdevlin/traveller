<div id="<%= dom_id government %>" class='space-y-6 mb-4'>
  <%= render 'application/data_block',
             label: 'Code',
             value_wrap_class: 'mt-2 flex flex-wrap items-center gap-2 text-slate-100',
             value: traveller_hex(government.code)
  %>

  <%= render 'application/data_block',
             label: 'Type',
             value_wrap_class: 'mt-2 flex flex-wrap items-center gap-2 text-slate-100',
             value: government.government_type
  %>

  <%= render 'application/data_block',
             label: 'Description',
             value_wrap_class: 'mt-2 flex flex-wrap items-center gap-2 text-slate-100',
             value: government.description
  %>

</div>
