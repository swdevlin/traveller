<%= form_with(model: trade_code, class: 'contents') do |form| %>
  <%= hidden_field_tag :return_to, @return_to %>
  <div class='space-y-2 pb-10'>
    <%= render 'application/form_errors', errors: trade_code.errors.where(:base) %>

    <%= render 'application/edit_field', form: form, attribute: :code, required: true do %>
      <%= form.text_field :code, class: 'edit-base w-24' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :definition, required: true do %>
      <%= form.text_field :definition, class: 'edit-base w-full sm:w-1/2' %>
    <% end %>

    <div class='pt-2 flex flex-col sm:flex-row gap-2'>
      <%= form.submit 'Update core', class: 'w-full sm:w-auto btn btn-primary' %>
      <%= link_to 'Cancel', trade_code.persisted? ? trade_code : trade_codes_path, class: 'w-full sm:w-auto btn' %>
    </div>
  </div>
<% end %>
