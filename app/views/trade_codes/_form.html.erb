<%= form_with(model: trade_code, class: "contents") do |form| %>
  <% if trade_code.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(trade_code.errors.count, "error") %> prohibited this trade code from being saved:</h2>

      <ul class="list-disc ml-6">
        <% trade_code.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :code %>
    <%= form.text_field :code,
                        class: [
                          "edit-base mt-2 w-24",
                          {
                            "border-gray-400 focus:outline-blue-600": trade_code.errors[:code].none?,
                            "border-red-400 focus:outline-red-600": trade_code.errors[:code].any?
                          }
                        ] %>
  </div>

  <div class="my-5">
    <%= form.label :definition %>
    <%= form.text_field :definition,
                        class: [
                          "w-full rounded-lg bg-slate-950 border-slate-700 px-3 py-2 mt-2",
                          {
                            "border-gray-400 focus:outline-blue-600": trade_code.errors[:definition].none?,
                            "border-red-400 focus:outline-red-600": trade_code.errors[:definition].any?
                          }
                        ] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto btn btn-primary" %>
  </div>
<% end %>
