<%= form_with(model: trade_code, class: 'contents') do |form| %>
  <%= hidden_field_tag :return_to, @return_to %>
  <div class='space-y-6 pb-10'>
    <% if trade_code.errors.any? %>
      <div class='rounded-2xl border border-traveller-red/40 bg-slate-950/60 p-4'>
        <div class='text-xs uppercase tracking-[0.22em] text-slate-400'>
          Validation
        </div>
        <div class='mt-1 text-sm font-semibold text-slate-200'>
          <%= pluralize(trade_code.errors.count, 'error') %> prevented this trade code from being saved
        </div>

        <ul class='mt-3 list-disc ml-6 text-sm text-slate-300 space-y-1'>
          <% trade_code.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class='mt-4'>
      <%= form.label :code, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.text_field :code,
                          class: [
                            'w-24 edit-base mt-2',
                            {
                              'border-gray-400 focus:outline-blue-600': trade_code.errors[:code].none?,
                              'border-red-400 focus:outline-red-600': trade_code.errors[:code].any?
                            }
                          ] %>
    </div>

    <div>
      <%= form.label :definition, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.text_field :definition,
                          class: [
                            'w-full edit-base mt-2 sm:w-1/2',
                            {
                              'border-gray-400 focus:outline-blue-600': trade_code.errors[:definition].none?,
                              'border-red-400 focus:outline-red-600': trade_code.errors[:definition].any?
                            }
                          ] %>
    </div>

    <div class='pt-2 flex flex-col sm:flex-row gap-2'>
      <%= form.submit 'Update core', class: 'w-full sm:w-auto btn btn-primary' %>
      <%= link_to 'Cancel', trade_code.persisted? ? trade_code : trade_codes_path, class: 'w-full sm:w-auto btn' %>
    </div>
  </div>
<% end %>
