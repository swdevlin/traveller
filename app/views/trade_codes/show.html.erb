<% content_for :title, @trade_code.code %>

<div class="w-full max-w-2xl">
  <h1 class="font-bold text-4xl mb-4">
    <%= @trade_code.definition %>
    <span class="text-base text-slate-400">(<%= @trade_code.code %>)</span>
  </h1>

  <div class="space-y-4 mb-6">
    <div>
      <strong class="block text-sm font-semibold text-slate-400 mb-1">Code</strong>
      <span class="inline-flex items-center rounded-full border border-slate-600/70 bg-slate-900/80 px-3 py-1 font-mono tracking-wide text-slate-200">
        <%= @trade_code.code %>
      </span>
    </div>

    <div>
      <strong class="block text-sm font-semibold text-slate-400 mb-1">Definition</strong>
      <p class="text-slate-100"><%= @trade_code.definition %></p>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row gap-2">
    <%= link_to "Edit", edit_trade_code_path(@trade_code), class: "w-full sm:w-auto btn btn-primary" %>
    <%= link_to "Back to trade codes", trade_codes_path, class: "w-full sm:w-auto btn" %>
    <%= button_to "Delete",
                  @trade_code,
                  method: :delete,
                  form_class: "w-full sm:w-auto",
                  class: "w-full sm:w-auto btn btn-danger cursor-pointer",
                  data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
