<% content_for :title, "#{@trade_code.code} Trade Code" %>
<% content_for :page_kicker, "Trade Code Classification" %>
<% content_for :page_title, @trade_code.definition %>

<%= render 'application/page' do %>
  <%= render @trade_code %>

  <%= link_to "Edit", edit_trade_code_path(@trade_code), class: "w-full sm:w-auto btn btn-primary" %>
  <%= render 'application/back_button',
             path: trade_codes_path,
             label: 'Trade codes',
             class: 'w-full sm:w-auto' %>
  <%= button_to "Delete",
                @trade_code,
                method: :delete,
                form_class: "w-full sm:w-auto inline-flex m-0",
                class: "w-full sm:w-auto btn btn-danger cursor-pointer",
                data: { turbo_confirm: "Are you sure?" } %>
<% end %>
