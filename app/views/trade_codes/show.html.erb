<% content_for :title, @trade_code.code %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="page-shell">
    <div class="page-header">
      <div>
        <div class="page-kicker">
          Trade Code Classification
        </div>
        <div class="page-title">
          <%= @trade_code.definition %>
        </div>
      </div>
      <div class="page-actions">
      </div>
    </div>

    <div class="page-body">
      <div class="page-main">
        <%= render @trade_code %>

        <%= link_to "Edit", edit_trade_code_path(@trade_code), class: "w-full sm:w-auto btn btn-primary" %>
        <%= render 'application/back_button',
                   path: trade_codes_path,
                   label: 'Trade codes',
                   class: 'w-full sm:w-auto' %>
        <%= button_to "Delete",
                      @trade_code,
                      method: :delete,
                      form_class: "w-full sm:w-auto inline-flex m-0",
                      class: "w-full sm:w-auto btn btn-danger cursor-pointer",
                      data: { turbo_confirm: "Are you sure?" } %>
      </div>
      <div class="page-side">
      </div>
    </div>
  </div>
</div>
