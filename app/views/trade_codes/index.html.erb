<% content_for :title, "Trade codes" %>
<% content_for :page_kicker, "Reference Manual" %>
<% content_for :page_title, "Trade Codes" %>

<%= render 'application/page' do %>
  <div class='table-card'>
    <div class='table-banner'>
      <p>Trade code registry</p>

      <div class='actions'>
        <%= link_to new_trade_code_path, class: 'btn-header' do %>
          <i class='fa-regular fa-plus'></i>
          Add
        <% end %>
      </div>
    </div>

    <div class='table-scroll'>
      <table>
        <thead>
        <tr>
          <th scope='col'>Code</th>
          <th scope='col'>Definition</th>
          <th scope='col' class='text-right actions-cell'>Actions</th>
        </tr>
        </thead>

        <tbody>
        <% @trade_codes.each do |trade_code| %>
          <tr>
            <td class='whitespace-nowrap'>
              <span class='pill'><%= trade_code.code %></span>
            </td>

            <td>
              <%= link_to trade_code_path(trade_code), class: 't-link' do %>
                <%= trade_code.definition %>
              <% end %>
            </td>

            <td class='actions-cell'>
              <div class='action-group'>
                <%= link_to edit_trade_code_path(trade_code), class: 'action' do %>
                  <i class='fa-regular fa-pen-to-square'></i>
                <% end %>

                <%= button_to trade_code,
                              method: :delete,
                              class: 'action danger',
                              data: { turbo_confirm: "Delete #{trade_code.code}?" } do %>
                  <i class='fa-regular fa-trash'></i>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
