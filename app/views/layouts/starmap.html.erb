<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || 'Traveller Star Map' %></title>
  <meta name='viewport' content='width=device-width,initial-scale=1'>
  <meta name='apple-mobile-web-app-capable' content='yes'>
  <meta name='application-name' content='Traveller'>
  <meta name='mobile-web-app-capable' content='yes'>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <link rel='preconnect' href='https://fonts.googleapis.com'>
  <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>
  <link
    href='https://fonts.googleapis.com/css2?family=Exo+2:wght@400;500;600;700&family=Orbitron:wght@500;700&family=JetBrains+Mono:wght@400;500;600&display=swap'
    rel='stylesheet'
  >

  <link rel='icon' href='<%= asset_path('favicon-32.png') %>' type='image/png'>
  <link rel='icon' href='<%= asset_path('favicon.svg') %>' type='image/svg+xml'>
  <link rel='apple-touch-icon' href='/icon.png'>

  <script src='https://kit.fontawesome.com/6da76bfdd0.js' crossorigin='anonymous'></script>

  <%= stylesheet_link_tag :app, 'data-turbo-track': 'reload' %>
  <%= javascript_importmap_tags %>
  <script type='module'>
    import 'starmap'
  </script>
</head>

<body class='h-screen overflow-hidden bg-black text-slate-100'>
<%= yield %>
</body>
</html>