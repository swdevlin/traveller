<!DOCTYPE html>
<html data-theme='<%= current_theme %>'>
<head>
  <title><%= content_for(:title) || 'Traveller' %></title>
  <meta name='viewport' content='width=device-width,initial-scale=1'>
  <meta name='apple-mobile-web-app-capable' content='yes'>
  <meta name='application-name' content='Traveller'>
  <meta name='mobile-web-app-capable' content='yes'>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= tag.meta(name: 'robots', content: 'noindex') if @noindex %>

  <%= yield :head %>

  <link rel='preconnect' href='https://fonts.googleapis.com'>
  <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>
  <link
    href='https://fonts.googleapis.com/css2?family=Exo+2:wght@400;500;600;700&family=Orbitron:wght@500;700&family=JetBrains+Mono:wght@400;500;600&display=swap'
    rel='stylesheet'
  >

  <%#= tag.link rel: 'manifest', href: pwa_manifest_path(format: :json) %>

  <link rel='apple-touch-icon' sizes='180x180' href='<%= asset_path('apple-touch-icon.png') %>'>
  <link rel='icon' type='image/png' sizes='32x32' href='<%= asset_path('favicon-32x32.png') %>'>
  <link rel='icon' type='image/png' sizes='16x16' href='<%= asset_path('favicon-16x16.png') %>'>

  <script src='https://kit.fontawesome.com/6da76bfdd0.js' crossorigin='anonymous'></script>

  <%= stylesheet_link_tag :app, 'data-turbo-track': 'reload' %>
  <%= stylesheet_link_tag 'coloris.min', 'data-turbo-track': 'reload' %>
  <script src='<%= asset_path('coloris.min.js') %>'></script>
  <%= javascript_importmap_tags %>
</head>

<body class='min-h-screen bg-bg text-fg-bright pt-10'>
<%= turbo_frame_tag 'modal' %>
<%= render 'application/navbar' %>

<% if content_for?(:breadcrumb) %>
  <div class='w-full px-8 pt-3 pb-2 border-b border-outline/50'>
    <%= yield :breadcrumb %>
  </div>
<% end %>

<% if flash.any? %>
  <div class='fixed right-4 top-[3.75rem] z-50 flex w-full max-w-sm flex-col gap-3 px-2 sm:px-0'>
    <% flash.each do |key, message| %>
      <% next if message.blank? %>

      <% classes =
           case key.to_sym
           when :notice
             'border-notice-outline bg-notice-bg text-notice-fg'
           when :alert, :error
             'border-danger-outline bg-danger-bg text-danger-fg'
           else
             'border-outline bg-panel text-fg-bright'
           end %>

      <div class='rounded-lg border px-4 py-3 text-sm font-medium shadow-lg backdrop-blur <%= classes %>'
           role='status'
           data-controller='notification'>
        <div class='flex items-start justify-between gap-3'>
          <div class='leading-5'>
            <%= message %>
          </div>

          <button type='button'
                  class='-mr-1 rounded px-1 text-lg leading-none opacity-70 transition hover:opacity-100'
                  aria-label='Close notification'
                  data-action='notification#close'>
            &times;
          </button>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
<main class='w-full mt-2 px-8 flex pb-8'>
  <%= yield %>
</main>

<footer class='mt-auto border-t border-outline bg-panel py-6 mb-4'>
  <div class='w-full px-8 flex justify-end gap-2 text-sm text-fg-muted'>
    <%= link_to 'https://bsky.app/profile/mytraveller.bsky.social',
                class: 'no-underline hover:text-highlight transition-colors' do %>
      <i class='fa-brands fa-bluesky'></i>
    <% end %>

    <%= link_to 'https://github.com/swdevlin/traveller',
                target: '_blank',
                rel: 'noopener',
                class: 'no-underline hover:text-highlight transition-colors' do %>
      <i class='fa-brands fa-github mr-1'></i>
    <% end %>

    <%= link_to fairuse_path,
                class: 'no-underline hover:text-highlight transition-colors' do %>
      <i class='fa-regular fa-scale-balanced'></i>
    <% end %>

    <%= link_to 'Δ',
                deltas_path,
                class: 'no-underline hover:text-highlight transition-colors font-bold' %>
  </div>
</footer>
</body>
</html>