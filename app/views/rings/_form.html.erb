<%= render 'stellar_objects/form_scaffold', stellar_object: stellar_object, show_known_field: false, notes_wrapper_class: 'edit-row-notes' do |form| %>
  <%= render 'application/edit_field', form: form, attribute: :orbit, field_label: 'Orbit (diameters)', required: true do %>
    <%= form.number_field :orbit,
                          value: format_precision(stellar_object.orbit, precision: 5),
                          class: 'edit-base sm:w-28 w-24',
                          step: 'any',
                          min: 0 %>
  <% end %>

  <%= form.fields_for :data, (stellar_object.data || {}) do |df| %>
    <%= render 'application/edit_field', form: form, attribute: :span, field_label: 'Span (diameters)', required: true do %>
      <%= df.number_field :span,
                          value: stellar_object.span,
                          class: 'edit-base sm:w-28 w-24',
                          step: 'any',
                          min: 0 %>
    <% end %>
  <% end %>
<% end %>
