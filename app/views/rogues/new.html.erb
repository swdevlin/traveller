<% content_for :title, 'Add rogue object' %>
<% content_for :page_kicker, 'Add Rogue Object' %>
<% content_for :page_title, @context_label %>

<%= render 'application/page' do %>
  <%= form_with model: @rogue, scope: :stellar_object, url: request.path.include?("/parsecs/") ? parsec_rogues_path(@parsec) : polymorphic_path([@subsector || @sector, :rogues]), class: "contents" do |f| %>
    <%= hidden_field_tag :return_to, @return_to %>

    <div class="space-y-6 pb-10">
      <%= render 'application/form_errors', errors: @rogue.errors.where(:base) %>

      <% unless @parsec %>
        <%= render 'application/edit_field', form: f, attribute: :parsec_id, field_label: 'Hex' do %>
          <%= f.select :parsec_id,
                       options_for_select(@parsec_options, @rogue.parsec_id),
                       { prompt: 'Select a hex' },
                       class: 'edit-base w-40' %>
        <% end %>
      <% end %>

      <%= render 'application/edit_field', form: f, attribute: :name do %>
        <%= f.text_field :name, class: 'edit-base w-full sm:max-w-xl' %>
      <% end %>

      <div data-controller="rogue-form">
        <%= render 'application/edit_field', form: f, attribute: :type, field_label: 'Rogue type' do %>
          <%= f.select :type,
                       options_for_select(
                         StellarObject::STI_TYPES.map { |t| [t.underscore.humanize, t] },
                         params.dig(:stellar_object, :type) || @rogue.class.name
                       ),
                       { prompt: 'Select a type' },
                       class: 'edit-base w-60',
                       data: { action: 'change->rogue-form#typeChanged', rogue_form_target: 'typeSelect' } %>
        <% end %>

        <%= f.fields_for :data, (@rogue.data || {}) do |df| %>
          <div data-rogue-form-target="section" data-type="GasGiant" class="hidden mt-4">
            <%= render 'application/edit_field', form: f, attribute: :size, field_label: 'Gas giant size' do %>
              <%= df.select :size,
                            options_for_select([['Random', 'random'], ['Small', 'GS'], ['Medium', 'GM'], ['Large', 'GL']], (@rogue.data || {})['size']),
                            { prompt: 'Select a size' },
                            class: 'edit-base' %>
            <% end %>
          </div>

          <div data-rogue-form-target="section" data-type="Comet" class="hidden mt-4 space-y-4">
            <fieldset class="space-y-2">
              <% current_type = (@rogue.data || {})['comet_type'] %>
              <legend class="edit-label">Comet type</legend>
              <% Comet::DESCRIPTIONS.each do |value, label| %>
                <label class="flex items-start gap-3 rounded-lg border border-slate-800/70 bg-slate-950/40 px-3 py-2 hover:bg-slate-900/40 cursor-pointer">
                  <%= df.radio_button :comet_type, value,
                                      checked: current_type == value,
                                      class: 'mt-1 h-4 w-4 text-red-600 bg-slate-950 border-slate-700 focus:ring-red-600/40' %>
                  <span class="text-sm text-slate-100"><%= label %></span>
                </label>
              <% end %>
            </fieldset>
          </div>
        <% end %>
      </div>

      <div class='edit-row-notes'>
        <div class='edit-label'>Observations</div>
        <%= f.text_area :notes, rows: 6, class: 'edit-base mt-2 w-full resize-y' %>
        <%= render 'application/field_error', form: f, attribute: :notes %>
      </div>

      <div class="pt-2 flex flex-col sm:flex-row gap-2">
        <%= f.submit 'Add rogue', class: 'w-full sm:w-auto btn btn-primary' %>
      </div>
    </div>
  <% end %>
<% end %>
