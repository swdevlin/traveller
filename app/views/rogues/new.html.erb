<%= form_with model: @rogue, url: request.path.include?("/parsecs/") ? parsec_rogues_path(@parsec) : polymorphic_path([@sector || @subsector, :rogues]), class: "space-y-6" do |f| %>
  <%= hidden_field_tag :return_to, @return_to %>
  <h1 class="text-3xl font-bold mb-6">
    <i class="fa-solid fa-meteor mr-2 text-slate-300"></i>
    Add rogue to <span class="text-slate-200"><%= @context_label %></span>
  </h1>

  <% unless @parsec %>
    <div>
      <%= f.label :parsec_id, "Hex", class: "block text-sm font-semibold mb-1" %>
      <%= f.select :parsec_id,
                   options_for_select(@parsec_options, @rogue.parsec_id),
                   { prompt: "Select a hex" },
                   class: "w-full rounded-lg bg-slate-950 border border-slate-700 px-3 py-2" %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-semibold mb-1" %>
    <%= f.text_field :name,
                     class: class_names(
                       "block w-full mt-2 px-3 py-2 rounded-md border shadow-sm",
                       "bg-slate-900 text-slate-100 caret-slate-100 placeholder:text-slate-400",
                       "border-gray-400 focus:border-blue-600" => @rogue.errors[:name].none?,
                       "border-red-400 focus:border-red-600"   => @rogue.errors[:name].any?
                     ) %>
  </div>

  <div data-controller="rogue-form">
    <div>
      <%= f.label :type, "Rogue type", class: "block text-sm font-semibold mb-1" %>
      <%= f.select :type,
                   StellarObject::STI_TYPES.map { |t| [t.underscore.humanize, t] },
                   { prompt: "Select a type" },
                   class: "w-full rounded-lg bg-slate-950 border border-slate-700 px-3 py-2",
                   data: { action: "change->rogue-form#typeChanged", rogue_form_target: "typeSelect" } %>
    </div>

    <%= f.fields_for :data, (@rogue.data || {}) do |df| %>
      <div data-rogue-form-target="section" data-type="GasGiant" class="hidden mt-4">
        <%= df.label :size, "Gas giant size", class: "block text-sm font-semibold mb-1" %>
        <%= df.select :size,
                      options_for_select([["Random", "random"], ["Small", "small"], ["Medium", "medium"], ["Large", "large"]], (@rogue.data || {})["size"]),
                      { prompt: "Select a size" },
                      class: "w-full rounded-lg bg-slate-950 border border-slate-700 px-3 py-2" %>
      </div>

      <div data-rogue-form-target="section" data-type="Comet" class="hidden mt-4 space-y-4">
        <!-- Comet type -->
        <fieldset class="space-y-2">
          <legend class="block text-sm font-semibold mb-1">Comet type</legend>

          <% comet_type = (@rogue.data || {})["comet_type"] %>

          <label class="flex items-start gap-3 rounded-lg border border-slate-800/70 bg-slate-950/40 px-3 py-2 hover:bg-slate-900/40 cursor-pointer">
            <%= df.radio_button :comet_type, "inhabited",
                                checked: comet_type == "inhabited",
                                class: "mt-1 h-4 w-4 text-red-600 bg-slate-950 border-slate-700 focus:ring-red-600/40" %>
            <span class="text-sm text-slate-100">Inhabited</span>
          </label>

          <label class="flex items-start gap-3 rounded-lg border border-slate-800/70 bg-slate-950/40 px-3 py-2 hover:bg-slate-900/40 cursor-pointer">
            <%= df.radio_button :comet_type, "tiny",
                                checked: comet_type == "tiny",
                                class: "mt-1 h-4 w-4 text-red-600 bg-slate-950 border-slate-700 focus:ring-red-600/40" %>
            <span class="text-sm text-slate-100">Tiny, ice-bearing suitable for one refuelling only</span>
          </label>

          <label class="flex items-start gap-3 rounded-lg border border-slate-800/70 bg-slate-950/40 px-3 py-2 hover:bg-slate-900/40 cursor-pointer">
            <%= df.radio_button :comet_type, "medium",
                                checked: comet_type == "medium",
                                class: "mt-1 h-4 w-4 text-red-600 bg-slate-950 border-slate-700 focus:ring-red-600/40" %>
            <span class="text-sm text-slate-100">Ice-bearing suitable for multiple refuellings</span>
          </label>

          <label class="flex items-start gap-3 rounded-lg border border-slate-800/70 bg-slate-950/40 px-3 py-2 hover:bg-slate-900/40 cursor-pointer">
            <%= df.radio_button :comet_type, "large",
                                checked: comet_type == "large",
                                class: "mt-1 h-4 w-4 text-red-600 bg-slate-950 border-slate-700 focus:ring-red-600/40" %>
            <span class="text-sm text-slate-100">Large</span>
          </label>
        </fieldset>
      </div>
    <% end %>
  </div>

  <div>
    <%= f.label :notes, "Deepnight Log" %>
    <%= f.text_area :notes,
                       rows: 6,
                       class: [
                         "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full bg-slate-950 text-slate-100 resize-y",
                         {
                           "border-gray-400 focus:border-blue-600": @rogue.errors[:notes].none?,
                           "border-red-400 focus:border-red-600": @rogue.errors[:notes].any?
                         }
                       ] %>
  </div>

  <%= f.submit "Add rogue", class: "btn btn-primary" %>
<% end %>
