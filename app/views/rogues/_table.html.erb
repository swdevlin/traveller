<div class="t-card">
  <div class="t-card-header">
    <div class="flex items-center justify-between gap-3">
      <p class="t-card-title">Rogue objects</p>
      <% if local_assigns[:new_url].present? %>
        <div class="flex items-center gap-2">
        <%= link_to new_url, class: "btn-header" do %>
          <i class="fa-solid fa-plus text-[0.7rem]"></i>
          Add
        <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="t-scroll-x">
    <table class="t-table">
      <thead class="t-thead">
      <tr>
        <th scope="col" class="t-th w-20">
          Hex
        </th>
        <th scope="col" class="t-th w-40">
          Type
        </th>
        <th scope="col" class="t-th">
          Name
        </th>
        <th scope="col" class="t-th w-16 whitespace-nowrap">
          Actions
        </th>
      </tr>
      </thead>
      <tbody class="t-tbody">
      <% rogues.each do |rogue| %>
        <tr class="t-tr">
          <td class="t-td whitespace-nowrap align-middle">
            <%= rogue.parsec.subsector_hex_code %>
          </td>

          <td class="t-td whitespace-nowrap align-middle">
            <%= rogue.type.underscore.humanize %>
          </td>

          <td class="t-td align-middle">
            <%= link_to rogue.name, stellar_object_path(rogue), class: "t-link" %>
          </td>
          <td class="t-td whitespace-nowrap align-middle text-right">
            <div class="inline-flex items-center justify-end gap-2">
              <%= link_to edit_stellar_object_path(rogue),
                          class: "text-slate-300 hover:text-traveller-red/90",
                          title: "Edit" do %>
                <i class="fa-solid fa-pen-to-square"></i>
              <% end %>

              <%= button_to stellar_object_path(rogue),
                            method: :delete,
                            form_class: "inline",
                            class: "text-slate-300 hover:text-traveller-red/90",
                            title: "Delete",
                            data: { turbo_confirm: "Delete this #{rogue.type.underscore.humanize(capitalize: false)}?" } do %>
                <i class="fa-solid fa-trash"></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>