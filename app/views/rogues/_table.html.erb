<div class='table-card mt-4'>
  <div class='table-banner'>
    <p>Rogue objects</p>

    <% if local_assigns[:new_url].present? %>
      <div class='actions'>
        <%= link_to new_url, class: 'btn-header' do %>
          <i class='fa-regular fa-plus'></i>
          Add
        <% end %>
      </div>
    <% end %>
  </div>

  <div class='table-scroll'>
    <table>
      <thead>
      <tr>
        <th scope='col' class='w-20'>Hex</th>
        <th scope='col' class='w-40'>Type</th>
        <th scope='col'>Name</th>
        <th scope='col' class='text-right w-16 whitespace-nowrap actions-cell'>Actions</th>
      </tr>
      </thead>

      <tbody>
      <% rogues.each do |rogue| %>
        <tr class='cursor-pointer'
            data-controller='row-link'
            data-row-link-url-value='<%= stellar_object_path(rogue) %>'
            data-action='click->row-link#navigate'>
          <td class='whitespace-nowrap'>
            <span class='pill'><%= rogue.parsec.subsector_hex_code %></span>
          </td>

          <td class='whitespace-nowrap'>
            <%= rogue.type.underscore.humanize %>
          </td>

          <td>
            <%= rogue.name %>
          </td>

          <td class='actions-cell'>
            <div class='action-group'>
              <%= link_to edit_stellar_object_path(rogue),
                          class: 'action',
                          title: 'Edit' do %>
                <i class='fa-regular fa-pen-to-square'></i>
              <% end %>

              <%= button_to stellar_object_path(rogue),
                            method: :delete,
                            class: 'action danger',
                            title: 'Delete',
                            data: { turbo_confirm: "Delete this #{rogue.type.underscore.humanize(capitalize: false)}?" } do %>
                <i class='fa-regular fa-trash'></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>