<% preload_tags(rogues) %>
<div class='table-card mt-4'>
  <div class='table-banner'>
    <p>Rogue objects</p>

    <% if local_assigns[:new_url].present? %>
      <div class='actions'>
        <%= link_to new_url, class: 'btn-header' do %>
          <i class='fa-regular fa-plus'></i>
          Add
        <% end %>
      </div>
    <% end %>
  </div>

  <div class='table-scroll'>
    <table>
      <thead>
      <tr>
        <th scope='col' class='w-20'>Hex</th>
        <th scope='col' class='w-40'>Type</th>
        <th scope='col'>Name</th>
        <th scope='col' class='text-center w-16'>Known</th>
        <th scope='col'>Tags</th>
        <th scope='col' class='text-right w-16 whitespace-nowrap actions-cell'><span class='sr-only'>Actions</span></th>
      </tr>
      </thead>

      <tbody>
      <% rogues.each do |rogue| %>
        <tr class='cursor-pointer'
            data-controller='row-link'
            data-row-link-url-value='<%= stellar_object_path(rogue) %>'
            data-action='click->row-link#navigate'>
          <td class='whitespace-nowrap'>
            <span class='pill'><%= rogue.parsec.subsector_hex_code %></span>
          </td>

          <td class='whitespace-nowrap'>
            <%= rogue.type.underscore.humanize %>
          </td>

          <td>
            <%= rogue.name %>
          </td>

          <td class='text-center'>
            <%= content_tag(:i, '', class: 'fa-regular fa-check') if rogue.known? %>
          </td>

          <td><%= render 'application/tags', record: rogue %></td>

          <%= render 'application/row_actions', record: rogue, label: rogue.display_name,
                edit_url: edit_stellar_object_path(rogue), delete_url: stellar_object_path(rogue),
                delete_confirm: "Delete this #{rogue.type.underscore.humanize(capitalize: false)}?",
                move_modal_url: move_modal_stellar_object_path(rogue),
                return_to: (@subsector ? subsector_path(@subsector) : request.fullpath) %>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>