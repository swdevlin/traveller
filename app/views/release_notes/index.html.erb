<% content_for :title, "Delta" %>
<% content_for :page_kicker, "Operations Manual" %>
<% content_for :page_title, "Deltas" %>

<%= render 'application/page' do %>

  <% @releases.each do |release| %>
    <article class='space-y-4 mb-6'>
      <div class='flex items-center gap-4'>
        <div class='text-sm uppercase tracking-[0.22em] font-semibold text-deepnight-orange'>
          <%= release.date_code %>
        </div>
        <div class='h-px flex-1 bg-slate-700/70'></div>
      </div>

      <div class='release-markdown prose prose-invert max-w-none prose-headings:uppercase prose-headings:tracking-[0.2em] prose-headings:text-slate-200 prose-p:text-slate-300 prose-a:text-deepnight-orange hover:prose-a:text-traveller-red prose-img:rounded-2xl prose-img:border prose-img:border-slate-700/70'>
        <%= render_markdown(release.markdown) %>
      </div>
    </article>
  <% end %>

  <div class='pt-4'>
    <%== @pagy.series_nav %>
  </div>

<% end %>
