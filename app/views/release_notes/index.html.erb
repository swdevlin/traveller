<% content_for :title, "Delta" %>
<% content_for :page_kicker, "Operations Manual" %>
<% content_for :page_title, "Deltas" %>

<% content_for :head do %>
  <%= auto_discovery_link_tag :rss, deltas_feed_url(campaign_slug: nil), title: 'My Traveller Universe Deltas' %>
<% end %>

<% content_for :page_actions do %>
  <button type='button'
          title='Copy RSS feed URL'
          aria-label='Copy RSS feed URL'
          class='text-fg-muted hover:text-highlight-fg'
          data-controller='clipboard'
          data-clipboard-url-value='<%= deltas_feed_url(campaign_slug: nil) %>'
          data-clipboard-icon-value='fa-rss'
          data-action='click->clipboard#copy'>
    <i class='fa-regular fa-rss'></i>
  </button>
<% end %>

<%= render 'application/page' do %>

  <% @releases.each do |release| %>
    <article class='space-y-4 mb-6'>
      <div class='flex items-center gap-4'>
        <div class='text-sm uppercase tracking-[0.22em] font-semibold text-fg-bright'>
          <%= release.date_code %>
        </div>
        <div class='h-px flex-1 bg-panel'></div>
      </div>

      <div class='release-markdown prose prose-theme max-w-none prose-headings:uppercase prose-headings:tracking-[0.2em] prose-headings:text-highlight-fg prose-p:text-fg prose-a:text-highlight-fg hover:prose-a:text-highlight-fg prose-img:rounded-2xl prose-img:border prose-img:border-outline/70'>
        <%= render_markdown(release.markdown) %>
      </div>
    </article>
  <% end %>

  <div class='pt-4'>
    <%== @pagy.series_nav %>
  </div>

<% end %>
