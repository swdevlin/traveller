<%
  city_type_options = City::TYPES.map { |code, attrs| { value: code, label: attrs[:label], meta: "(#{code}, TL#{attrs[:min_tl]}+)" } }
  capital_designation_options = City::CAPITAL_DESIGNATIONS.map { |code, label| { value: code, label: label, meta: "(#{code})" } }
%>
<%= form_with model: city, url: url, data: { controller: 'stop-propagation', action: 'turbo:submit-end->stop-propagation#stop' } do |f| %>
  <div class='space-y-6'>
    <% if city.errors.any? %>
      <div class='rounded-2xl border border-highlight/40 bg-panel p-4'>
        <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Validation</div>
        <div class='mt-1 text-sm font-semibold text-fg-bright'>
          <%= pluralize(city.errors.count, 'error') %> prevented this city from being saved
        </div>
        <ul class='mt-3 list-disc ml-6 text-sm text-fg space-y-1'>
          <% city.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: 'edit-label' %>
      <%= f.text_field :name, class: 'w-full edit-base mt-2' %>
    </div>

    <div>
      <%= f.label :population, class: 'edit-label' %>
      <%= f.number_field :population, min: 0, class: 'w-full edit-base mt-2' %>
    </div>

    <div>
      <%= f.label :city_type, 'City type', class: 'edit-label' %>
      <div data-controller='hint-select' class='relative mt-2'>
        <%= f.hidden_field :city_type, data: { hint_select_target: 'input' } %>

        <button type='button'
                class='edit-base border w-full text-left flex items-center justify-between gap-2'
                data-hint-select-target='trigger'
                data-action='click->hint-select#toggle'>
          <span>
            <span data-hint-select-target='label'>
              <%= city_type_options.find { |o| o[:value] == city.city_type }&.dig(:label) || 'Standard' %>
            </span>
            <span data-hint-select-target='meta' class='text-fg-muted'>
              <%= city_type_options.find { |o| o[:value] == city.city_type }&.dig(:meta) %>
            </span>
          </span>
          <i class='fa-solid fa-chevron-down text-xs text-fg-muted flex-shrink-0'></i>
        </button>

        <div class='hidden absolute z-50 top-full mt-1 w-full rounded-md border border-outline bg-dropdown shadow-xl overflow-hidden max-h-72 overflow-y-auto'
             data-hint-select-target='panel'>
          <button type='button'
                  class='w-full text-left px-3 py-2.5 hover:bg-dropdown-hover border-b border-outline'
                  data-action='click->hint-select#select'
                  data-value=''
                  data-label='Standard'
                  data-meta=''>
            <span class='text-sm text-fg-bright'>Standard</span>
          </button>
          <% city_type_options.each do |opt| %>
            <button type='button'
                    class='w-full text-left px-3 py-2.5 hover:bg-dropdown-hover border-b border-outline last:border-b-0'
                    data-action='click->hint-select#select'
                    data-value='<%= opt[:value] %>'
                    data-label='<%= opt[:label] %>'
                    data-meta='<%= opt[:meta] %>'>
              <span class='text-sm text-fg-bright'><%= opt[:label] %></span>
              <span class='text-sm text-fg-muted'><%= opt[:meta] %></span>
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <div>
      <%= f.label :capital_designation, 'Capital designation', class: 'edit-label' %>
      <div data-controller='hint-select' class='relative mt-2'>
        <%= f.hidden_field :capital_designation, data: { hint_select_target: 'input' } %>

        <button type='button'
                class='edit-base border w-full text-left flex items-center justify-between gap-2'
                data-hint-select-target='trigger'
                data-action='click->hint-select#toggle'>
          <span>
            <span data-hint-select-target='label'>
              <%= capital_designation_options.find { |o| o[:value] == city.capital_designation }&.dig(:label) || 'None' %>
            </span>
            <span data-hint-select-target='meta' class='text-fg-muted'>
              <%= capital_designation_options.find { |o| o[:value] == city.capital_designation }&.dig(:meta) %>
            </span>
          </span>
          <i class='fa-solid fa-chevron-down text-xs text-fg-muted flex-shrink-0'></i>
        </button>

        <div class='hidden absolute z-50 top-full mt-1 w-full rounded-md border border-outline bg-dropdown shadow-xl overflow-hidden'
             data-hint-select-target='panel'>
          <button type='button'
                  class='w-full text-left px-3 py-2.5 hover:bg-dropdown-hover border-b border-outline'
                  data-action='click->hint-select#select'
                  data-value=''
                  data-label='None'
                  data-meta=''>
            <span class='text-sm text-fg-bright'>None</span>
          </button>
          <% capital_designation_options.each do |opt| %>
            <button type='button'
                    class='w-full text-left px-3 py-2.5 hover:bg-dropdown-hover border-b border-outline last:border-b-0'
                    data-action='click->hint-select#select'
                    data-value='<%= opt[:value] %>'
                    data-label='<%= opt[:label] %>'
                    data-meta='<%= opt[:meta] %>'>
              <span class='text-sm text-fg-bright'><%= opt[:label] %></span>
              <span class='text-sm text-fg-muted'><%= opt[:meta] %></span>
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <div class='pt-2'>
      <%= f.submit submit_label, class: 'w-full btn btn-primary' %>
    </div>
  </div>
<% end %>
