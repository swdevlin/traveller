<% content_for :title, @region.name %>
<% content_for :page_kicker, 'Region Data Core' %>
<% content_for :page_title, @region.name %>

<% content_for :page_buttons do %>
  <div class='mt-6 flex flex-col sm:flex-row gap-2'>
    <%= link_to 'Edit', edit_region_path(@region), class: 'w-full sm:w-auto btn' %>
    <%= link_to 'Regions', regions_path(page: @regions_list_page), class: 'w-full sm:w-auto btn' %>
    <%= button_to 'Delete', @region,
                  method: :delete,
                  form_class: 'w-full sm:w-auto inline-flex m-0',
                  class: 'w-full sm:w-auto btn btn-danger cursor-pointer',
                  data: { turbo_confirm: 'Delete this region?' } %>
  </div>
<% end %>

<%= render 'application/page' do %>
  <div class='space-y-8'>
    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3'>
      <%= render 'application/data_block',
                 label: 'Label',
                 value: @region.label.presence || '—' %>

      <div class='min-w-0'>
        <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Label Position</div>
        <div class='mt-2'>
          <% if (lsh = @region.label_sector_and_hex) %>
            <% lsector, hx, hy = lsh %>
            <% lp = @region.label_parsec %>
            <span class='font-mono text-sm text-fg'>
              <%= link_to lsector.name, sector_path(lsector), class: 'no-underline hover:underline' %>
              &#32;<%= lp ? link_to(format('%02d%02d', hx, hy), parsec_path(lp), class: 'no-underline hover:underline') : format('%02d%02d', hx, hy) %>
            </span>
          <% else %>
            <span class='text-fg-muted'>—</span>
          <% end %>
        </div>
      </div>

      <div class='min-w-0'>
        <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Sectors</div>
        <div class='mt-2'>
          <% if @region.sectors.any? %>
            <span class='text-sm text-fg'>
              <% @region.sectors.each_with_index do |sector, i| %>
                <%= link_to sector.name, sector_path(sector), class: 'no-underline hover:underline hover:underline-offset-2' %><%= i < @region.sectors.size - 1 ? ', ' : '' %>
              <% end %>
            </span>
          <% else %>
            <span class='text-fg-muted'>—</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4'>
      <div class='min-w-0'>
        <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Fill</div>
        <div class='mt-2 flex items-center gap-2'>
          <% if @region.colour.present? %>
            <svg width="18" height="20" viewBox="0 0 20 22" aria-hidden="true">
              <polygon points="10,1 19,5.5 19,16.5 10,21 1,16.5 1,5.5"
                       fill="<%= @region.colour %>"
                       stroke="<%= @region.border_colour.presence || 'transparent' %>"
                       stroke-width="2"/>
            </svg>
            <span class='font-mono text-sm text-fg'><%= @region.colour %></span>
          <% else %>
            <span class='text-fg-muted'>—</span>
          <% end %>
        </div>
      </div>

      <div class='min-w-0'>
        <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Border</div>
        <div class='mt-2 flex items-center gap-2'>
          <% if @region.border_colour.present? %>
            <svg width="18" height="20" viewBox="0 0 20 22" aria-hidden="true">
              <polygon points="10,1 19,5.5 19,16.5 10,21 1,16.5 1,5.5"
                       fill="<%= @region.colour.presence || 'transparent' %>"
                       stroke="<%= @region.border_colour %>"
                       stroke-width="2"/>
            </svg>
            <span class='font-mono text-sm text-fg'><%= @region.border_colour %></span>
          <% else %>
            <span class='text-fg-muted'>—</span>
          <% end %>
        </div>
      </div>

      <%= form_with url: region_path(@region), method: :patch, class: 'min-w-0' do |f| %>
        <%= f.hidden_field :player_visible, value: !@region.player_visible? %>
        <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Player Visible</div>
        <div class='mt-2 flex items-center gap-3'>
          <button type='submit'
                  role='switch'
                  aria-checked='<%= @region.player_visible? %>'
                  class='relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none <%= @region.player_visible? ? 'bg-toggle-on' : 'bg-toggle-off' %>'>
            <span class='pointer-events-none inline-block h-5 w-5 transform rounded-full shadow ring-0 transition duration-200 ease-in-out <%= @region.player_visible? ? 'translate-x-5 bg-toggle-knob-on' : 'translate-x-0 bg-toggle-knob-off' %>'></span>
          </button>
          <span class='text-xs text-fg-muted italic'><%= @region.player_visible? ? 'Visible to players' : 'Hidden from players' %></span>
        </div>
      <% end %>
    </div>

    <%= render 'application/observation_block', notes: @region.notes %>

    <div class='table-card'>
      <div class='table-banner'>
        <p>Hexes</p>
        <div class='actions'>
          <%= link_to import_hexes_region_path(@region),
                      class: 'btn-header',
                      title: 'Upload CSV',
                      data: { turbo_frame: 'modal' } do %>
            <i class='fa-regular fa-cloud-arrow-up'></i>
          <% end %>
          <%= link_to download_csv_region_path(@region),
                      class: 'btn-header',
                      title: 'Download CSV',
                      data: { turbo: false } do %>
            <i class='fa-regular fa-cloud-arrow-down'></i>
          <% end %>
        </div>
      </div>
      <div class='px-4 py-3 text-sm text-fg-muted'>
        <%= pluralize(@region.border_parsecs_ordered.count, 'border hex') %>,
        <%= pluralize(@region.region_parsecs.count, 'total hex') %>
      </div>
    </div>

    <turbo-frame id="<%= dom_id(@region, :statistics) %>" src="<%= statistics_region_path(@region) %>" target="_top">
      <%= render 'application/statistics_loading' %>
    </turbo-frame>
  </div>
<% end %>
