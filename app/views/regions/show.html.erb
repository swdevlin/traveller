<% content_for :title, @region.name %>
<% content_for :page_kicker, 'Region Data Core' %>
<% content_for :page_title, @region.name %>

<% content_for :page_buttons do %>
  <div class='mt-6 flex flex-col sm:flex-row gap-2'>
    <%= link_to 'Edit', edit_region_path(@region), class: 'w-full sm:w-auto btn' %>
    <%= link_to 'Regions', regions_path(page: @regions_list_page), class: 'w-full sm:w-auto btn' %>
    <%= button_to 'Delete', @region,
                  method: :delete,
                  form_class: 'w-full sm:w-auto inline-flex m-0',
                  class: 'w-full sm:w-auto btn btn-danger cursor-pointer',
                  data: { turbo_confirm: 'Delete this region?' } %>
  </div>
<% end %>

<div class='w-full' data-controller='region-refresh'
     data-region-refresh-region-id-value='<%= @region.id %>'>
<%= render 'application/page' do %>
  <div class='space-y-8'>
    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3'>
      <%= render 'application/data_block',
                 label: 'Label',
                 value: @region.label.presence || '—' %>

      <div class='min-w-0'>
        <div class='text-xs uppercase tracking-[0.22em] text-slate-400'>Label Position</div>
        <div class='mt-2'>
          <% if (lsh = @region.label_sector_and_hex) %>
            <% lsector, hx, hy = lsh %>
            <% lp = @region.label_parsec %>
            <span class='font-mono text-sm text-slate-300'>
              <%= link_to lsector.name, sector_path(lsector), class: 'no-underline hover:underline' %>
              &#32;<%= lp ? link_to(format('%02d%02d', hx, hy), parsec_path(lp), class: 'no-underline hover:underline') : format('%02d%02d', hx, hy) %>
            </span>
          <% else %>
            <span class='text-slate-500'>—</span>
          <% end %>
        </div>
      </div>

      <div class='min-w-0'>
        <div class='text-xs uppercase tracking-[0.22em] text-slate-400'>Sectors</div>
        <div class='mt-2 flex flex-wrap gap-1'>
          <% if @region.sectors.any? %>
            <% @region.sectors.each do |sector| %>
              <%= link_to sector.name, sector_path(sector), class: 'pill no-underline hover:underline' %>
            <% end %>
          <% else %>
            <span class='text-slate-500'>—</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4'>
      <div class='min-w-0'>
        <div class='text-xs uppercase tracking-[0.22em] text-slate-400'>Fill</div>
        <div class='mt-2 flex items-center gap-2'>
          <% if @region.colour.present? %>
            <svg width="18" height="20" viewBox="0 0 20 22" aria-hidden="true">
              <polygon points="10,1 19,5.5 19,16.5 10,21 1,16.5 1,5.5"
                       fill="<%= @region.colour %>"
                       stroke="<%= @region.border_colour.presence || 'transparent' %>"
                       stroke-width="2"/>
            </svg>
            <span class='font-mono text-sm text-slate-300'><%= @region.colour %></span>
          <% else %>
            <span class='text-slate-500'>—</span>
          <% end %>
        </div>
      </div>

      <div class='min-w-0'>
        <div class='text-xs uppercase tracking-[0.22em] text-slate-400'>Border</div>
        <div class='mt-2 flex items-center gap-2'>
          <% if @region.border_colour.present? %>
            <svg width="18" height="20" viewBox="0 0 20 22" aria-hidden="true">
              <polygon points="10,1 19,5.5 19,16.5 10,21 1,16.5 1,5.5"
                       fill="<%= @region.colour.presence || 'transparent' %>"
                       stroke="<%= @region.border_colour %>"
                       stroke-width="2"/>
            </svg>
            <span class='font-mono text-sm text-slate-300'><%= @region.border_colour %></span>
          <% else %>
            <span class='text-slate-500'>—</span>
          <% end %>
        </div>
      </div>
    </div>

    <%= render 'application/observation_block', notes: @region.notes %>

    <div class='table-card'>
      <div class='table-banner'>
        <p>Components</p>
        <div class='actions'>
          <%= link_to import_hexes_region_path(@region), class: 'btn-header',
                      data: { turbo_frame: 'modal' } do %>
            <i class='fa-regular fa-plus'></i>
            <span>New</span>
          <% end %>
        </div>
      </div>

      <div class='table-scroll'>
        <table>
          <thead>
            <tr>
              <th scope='col'>Sector</th>
              <th scope='col' class='text-right'>Hexes</th>
              <th scope='col' class='text-right actions-cell'>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if @components.any? %>
              <% @components.each do |component| %>
                <tr>
                  <td><%= component.source_sector&.name || '—' %></td>
                  <td class='text-right'><%= component.fill_parsec_count %></td>
                  <td class='actions-cell'>
                    <div class='action-group'>
                      <%= link_to hex_template_region_region_component_path(@region, component),
                                  class: 'action',
                                  title: 'Download CSV',
                                  data: { turbo: false } do %>
                        <i class='fa-regular fa-cloud-arrow-down'></i>
                      <% end %>
                      <%= link_to import_hexes_region_region_component_path(@region, component),
                                  class: 'action',
                                  title: 'Upload CSV',
                                  data: { turbo_frame: 'modal' } do %>
                        <i class='fa-regular fa-cloud-arrow-up'></i>
                      <% end %>
                      <%= button_to region_region_component_path(@region, component),
                                    method: :delete,
                                    class: 'action danger',
                                    title: 'Delete',
                                    data: { turbo_confirm: 'Delete this component and all its hexes?' } do %>
                        <i class='fa-regular fa-trash'></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan='3'>No components.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>
</div>
