<%= modal(title: 'Import Hexes', padding: true, advance: false) do %>
  <div class='space-y-6'>
    <div class='space-y-2'>
      <div class='text-xs uppercase tracking-[0.22em] text-slate-400'>CSV Format</div>
      <p class='text-sm text-slate-300'>
        The file must have the following columns. Rows for sectors or hexes not yet in the system are skipped.
      </p>
      <table class='w-full text-sm font-mono'>
        <thead>
          <tr class='text-left text-xs uppercase tracking-[0.18em] text-slate-500 border-b border-slate-700'>
            <th class='pb-2 pr-4'>Column</th>
            <th class='pb-2'>Description</th>
          </tr>
        </thead>
        <tbody class='text-slate-300 divide-y divide-slate-800'>
          <tr>
            <td class='py-1.5 pr-4 text-deepnight-orange'>sector_x</td>
            <td class='py-1.5 font-sans text-slate-400'>Sector X coordinate</td>
          </tr>
          <tr>
            <td class='py-1.5 pr-4 text-deepnight-orange'>sector_y</td>
            <td class='py-1.5 font-sans text-slate-400'>Sector Y coordinate</td>
          </tr>
          <tr>
            <td class='py-1.5 pr-4 text-deepnight-orange'>hex_x</td>
            <td class='py-1.5 font-sans text-slate-400'>Hex column within sector (1–32)</td>
          </tr>
          <tr>
            <td class='py-1.5 pr-4 text-deepnight-orange'>hex_y</td>
            <td class='py-1.5 font-sans text-slate-400'>Hex row within sector (1–40)</td>
          </tr>
        </tbody>
      </table>
      <%= link_to hex_template_region_path(@region),
                  class: 'inline-flex items-center gap-2 text-sm text-slate-400 hover:text-slate-200 transition no-underline' do %>
        <i class='fa-regular fa-file-csv'></i>
        Download template
      <% end %>
    </div>

    <div class='h-px bg-slate-800'></div>

    <%= form_with url: upload_hexes_region_path(@region), multipart: true, class: 'space-y-4' do |f| %>
      <div>
        <div class='text-xs uppercase tracking-[0.22em] text-slate-400 mb-2'>CSV File</div>
        <%= f.file_field :csv_file, accept: '.csv',
                         class: 'w-full text-sm text-slate-400 file:btn file:mr-3' %>
      </div>
      <div class='flex justify-end'>
        <%= f.submit 'Import', class: 'btn btn-primary' %>
      </div>
    <% end %>
  </div>
<% end %>
