<%= form_with(model: region, class: 'space-y-8') do |form| %>
  <% if region.errors[:base].any? %>
    <div class='rounded-2xl border border-highlight/40 bg-panel p-4'>
      <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Validation</div>
      <ul class='mt-3 list-disc ml-6 text-sm text-fg space-y-1'>
        <% region.errors[:base].each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: 'block text-sm font-semibold mb-1' %>
    <%= form.text_field :name, class: 'edit-base w-full sm:w-1/2' %>
    <%= render 'application/field_error', form: form, attribute: :name %>
  </div>

  <div>
    <%= form.label :label, class: 'block text-sm font-semibold mb-1' %>
    <%= form.text_field :label, class: 'edit-base w-full sm:w-1/2' %>
    <%= render 'application/field_error', form: form, attribute: :label %>
  </div>

  <div class='space-y-4'>
    <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Colours</div>
    <div data-controller='colour-pair' class='flex flex-col sm:flex-row gap-6'>
      <div>
        <%= form.label :colour, 'Fill', class: 'block text-sm font-semibold mb-1' %>
        <%= form.text_field :colour,
              data: { controller: 'coloris', 'colour-pair-target': 'background' },
              class: 'edit-base w-32' %>
        <%= render 'application/field_error', form: form, attribute: :colour %>
      </div>

      <div>
        <%= form.label :border_colour, 'Border', class: 'block text-sm font-semibold mb-1' %>
        <%= form.text_field :border_colour,
              data: { controller: 'coloris', 'colour-pair-target': 'border' },
              class: 'edit-base w-32' %>
        <%= render 'application/field_error', form: form, attribute: :border_colour %>
      </div>

      <div>
        <%= form.label :label_colour, 'Label', class: 'block text-sm font-semibold mb-1' %>
        <%= form.text_field :label_colour,
              data: { controller: 'coloris' },
              class: 'edit-base w-32' %>
        <%= render 'application/field_error', form: form, attribute: :label_colour %>
      </div>
    </div>
  </div>

  <% if region.sectors.any? && label_parsec_options.any? %>
    <div>
      <%= label_tag 'region_label_parsec_id', 'Label Position', class: 'block text-sm font-semibold mb-1' %>
      <% selected_id = region.label_parsec&.id %>
      <% if region.sectors.many? %>
        <%= select_tag 'region[label_parsec_id]',
              grouped_options_for_select(label_parsec_options, selected_id),
              prompt: 'Select a hex',
              class: 'edit-base w-40' %>
      <% else %>
        <%= select_tag 'region[label_parsec_id]',
              options_for_select(label_parsec_options, selected_id),
              prompt: 'Select a hex',
              class: 'edit-base w-40' %>
      <% end %>
    </div>
  <% end %>

  <%= render 'application/boolean_toggle', form: form, attribute: :player_visible,
        checked: region.player_visible, label: 'Visible on player maps' %>

  <div>
    <%= form.label :notes, 'Notes', class: 'block text-sm font-semibold mb-1' %>
    <p class='text-xs text-fg-muted mb-2'>Supports Markdown</p>
    <%= form.text_area :notes, rows: 6, class: 'edit-base w-full resize-y' %>
    <%= render 'application/field_error', form: form, attribute: :notes %>
  </div>

  <div class='flex flex-col sm:flex-row gap-2'>
    <%= form.submit region.persisted? ? 'Save' : 'Create Region', class: 'w-full sm:w-auto btn btn-primary' %>
    <%= link_to 'Cancel', region.persisted? ? region : regions_path, class: 'w-full sm:w-auto btn' %>
  </div>
<% end %>
