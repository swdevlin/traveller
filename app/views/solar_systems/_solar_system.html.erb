<div id="<%= dom_id solar_system %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">X:</strong>
    <%= solar_system.x %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Y:</strong>
    <%= solar_system.y %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= solar_system.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Sector:</strong>
    <%= solar_system.sector_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Origin x:</strong>
    <%= solar_system.origin_x %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Origin y:</strong>
    <%= solar_system.origin_y %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Meta:</strong>
    <%= solar_system.meta %>
  </div>
</div>
