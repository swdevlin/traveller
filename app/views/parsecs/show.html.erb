<% content_for :title, "Hex #{@parsec.display_name}" %>
<% sector = @parsec.sector %>
<% subsector = @parsec&.subsector %>

<% content_for :page_kicker, 'IISS Hex Survey' %>
<% content_for :page_title do %>
  <%= @parsec.display_name %><span class='text-slate-500'>, <%= sector.name %></span>
<% end %>

<% content_for :page_buttons do %>
  <% confirm_msg = "Do you wish to delete all star systems and rogue objects in the parsec?" %>
  <div class='mt-6 flex flex-col sm:flex-row gap-2'>
    <%= button_to 'Clear',
                  clear_parsec_path(@parsec),
                  method: 'post',
                  class: 'w-full sm:w-auto btn btn-danger',
                  data: { turbo_confirm: confirm_msg } %>
  </div>
<% end %>

<% content_for :page_side do %>
  <% if subsector %>
    <%= render 'subsectors/map_embed', subsector: subsector, highlight: @parsec.id %>
  <% end %>
  <strong class='block font-medium mt-2 mb-2'>
    <%= link_to sector.name, sector, class: 'link-traveller-i' %>
  </strong>
  <%= render 'sectors/subsector_grid',
             sector: sector,
             active_subsector: subsector %>
<% end %>

<% if subsector %>
  <div data-controller="subsector-refresh"
       data-subsector-refresh-subsector-id-value="<%= subsector.id %>">
<% end %>
  <%= render 'application/two_column_page' do %>
    <div class='space-y-6'>
      <div class='grid grid-cols-1 gap-4 sm:grid-cols-3'>
        <%= render 'application/data_block',
                   label: 'Subsector',
                   value: link_to(subsector.name,
                                  subsector_path(subsector),
                                  class: 'no-underline hover:underline underline-offset-4') %>

        <%= render 'application/data_block',
                   label: 'Sector',
                   value: link_to(sector.name,
                                  sector_path(sector),
                                  class: 'no-underline hover:underline underline-offset-4') %>
      </div>

      <turbo-frame id="<%= dom_id(@parsec, :star_systems) %>"
                   src="<%= star_systems_table_parsec_path(@parsec) %>"
                   target="_top"
                   <% if subsector %>data-subsector-refresh-target="frame"<% end %>>
        <%= render 'star_systems/table',
                   star_systems: @parsec.star_systems,
                   new_url: new_parsec_star_system_path(@parsec) %>
      </turbo-frame>

      <%= render 'rogues/table',
                 rogues: @parsec.rogues,
                 new_url: new_parsec_rogue_path(@parsec) %>
    </div>
  <% end %>
<% if subsector %>
  </div>
<% end %>
