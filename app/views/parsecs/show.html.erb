<% content_for :title, "Hex #{@parsec.display_name}" %>
<% sector = @parsec.sector %>
<% subsector = @parsec&.subsector %>

<% content_for :page_kicker, 'IISS Hex Survey' %>
<% content_for :page_title do %>
  <%= @parsec.display_name %><span class='text-fg-muted'>, <%= sector.name %></span>
<% end %>

<% content_for :page_buttons do %>
  <% confirm_msg = "Do you wish to delete all star systems and rogue objects in the parsec?" %>
  <div class='mt-6 flex flex-col sm:flex-row gap-2'>
    <%= link_to 'Edit Hex', edit_parsec_path(@parsec), class: 'w-full sm:w-auto btn' %>
    <%= button_to 'Clear',
                  clear_parsec_path(@parsec),
                  method: 'post',
                  class: 'w-full sm:w-auto btn btn-danger',
                  data: { turbo_confirm: confirm_msg } %>
  </div>
<% end %>

<% content_for :page_side do %>
  <% if subsector %>
    <%= render 'subsectors/map_embed', subsector: subsector, highlight: @parsec.id %>
  <% end %>
  <strong class='block font-medium mt-2 mb-2'>
    <%= link_to sector.name, sector, class: 'link-traveller-i' %>
  </strong>
  <%= render 'sectors/subsector_grid',
             sector: sector,
             active_subsector: subsector %>
<% end %>

<% if subsector %>
  <div data-controller="subsector-refresh"
       data-subsector-refresh-subsector-id-value="<%= subsector.id %>">
<% end %>
  <%= render 'application/two_column_page' do %>
    <div class='space-y-6'>
      <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4'>
        <%= render 'application/data_block',
                   label: 'Subsector',
                   value: link_to(subsector.name,
                                  subsector_path(subsector),
                                  class: 'no-underline hover:underline underline-offset-4') %>

        <%= render 'application/data_block',
                   label: 'Sector',
                   value: link_to(sector.name,
                                  sector_path(sector),
                                  class: 'no-underline hover:underline underline-offset-4') %>

        <%= form_with model: @parsec, url: parsec_path(@parsec), method: :patch do |f| %>
          <div class='min-w-0'>
            <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Survey Index</div>
            <div class='mt-2 text-fg-bright'>
              <%= f.select :survey_index,
                           (0..12).map { |i| [i, i] },
                           { selected: @parsec.survey_index },
                           { onchange: 'this.form.requestSubmit()', class: 'edit-base w-20' } %>
            </div>
          </div>
        <% end %>

      </div>
      <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4'>
        <%= render 'application/data_block',
                   label: 'Label',
                   value: @parsec.label.presence || '—' %>

        <%= form_with model: @parsec, url: parsec_path(@parsec), method: :patch do |f| %>
          <div class='min-w-0'>
            <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Known to Players</div>
            <div class='mt-2'>
              <%= hidden_field_tag 'parsec[player_visible]', !@parsec.player_visible? %>
              <button type='submit'
                      role='switch'
                      aria-checked='<%= @parsec.player_visible? %>'
                      class='relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none <%= @parsec.player_visible? ? "bg-toggle-on" : "bg-toggle-off" %>'>
                <span class='pointer-events-none inline-block h-5 w-5 transform rounded-full shadow ring-0 transition duration-200 ease-in-out <%= @parsec.player_visible? ? "translate-x-5 bg-toggle-knob-on" : "translate-x-0 bg-toggle-knob-off" %>'></span>
              </button>
            </div>
          </div>
        <% end %>
      </div>
      <turbo-frame id="<%= dom_id(@parsec, :star_systems) %>"
                   src="<%= star_systems_table_parsec_path(@parsec) %>"
                   target="_top"
                   <% if subsector %>data-subsector-refresh-target="frame"<% end %>>
        <%= render 'star_systems/table',
                   star_systems: @star_systems,
                   new_url: new_parsec_star_system_path(@parsec) %>
      </turbo-frame>

      <%= render 'rogues/table',
                 rogues: @parsec.rogues,
                 new_url: new_parsec_rogue_path(@parsec) %>
    </div>
  <% end %>
<% if subsector %>
  </div>
<% end %>
