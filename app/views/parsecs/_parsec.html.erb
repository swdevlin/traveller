<div id="<%= dom_id parsec %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Sector:</strong>
    <%= parsec.sector_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">X:</strong>
    <%= parsec.x %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Y:</strong>
    <%= parsec.y %>
  </div>
</div>
