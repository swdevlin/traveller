<%= form_with(model: parsec, class: 'space-y-8') do |form| %>
  <% if parsec.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(parsec.errors.count, 'error') %> prohibited this hex from being saved:</h2>

      <ul class="list-disc ml-6">
        <% parsec.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class='space-y-4'>
    <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Hex Label</div>

    <div>
      <%= form.label :label, 'Text', class: 'block text-sm font-semibold mb-1' %>
      <%= form.text_area :label, rows: 3, class: 'edit-base w-full' %>
    </div>

    <%= render 'application/edit_field', form: form, attribute: :label_colour, field_label: 'Colour' do %>
      <%= form.text_field :label_colour,
            data: { controller: 'coloris' },
            class: 'edit-base w-32' %>
    <% end %>

    <%= render 'application/edit_field', form: form, attribute: :icon_class do %>
      <%= form.text_field :icon_class, class: 'edit-base w-64', placeholder: 'fa-solid fa-star' %>
    <% end %>

    <%= render 'application/boolean_toggle', form: form, attribute: :visible,
          checked: parsec.visible, label: 'Visible on map' %>

    <%= render 'application/boolean_toggle', form: form, attribute: :known,
          checked: parsec.known, label: 'Known to players' %>
  </div>

  <div>
    <%= form.label :notes, 'Observations', class: 'block text-sm font-semibold mb-1' %>
    <%= form.text_area :notes, rows: 6, class: 'w-full edit-base' %>
  </div>

  <div>
    <%= form.submit 'Save', class: 'btn btn-primary' %>
  </div>
<% end %>
