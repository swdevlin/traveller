<%= form_with(model: parsec, class: "contents") do |form| %>
  <% if parsec.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(parsec.errors.count, "error") %> prohibited this parsec from being saved:</h2>

      <ul class="list-disc ml-6">
        <% parsec.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :notes, 'Notes', class: 'block text-sm font-semibold mb-1' %>
    <%= form.text_area :notes, rows: 6, class: 'w-full edit-base' %>
  </div>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
