<% content_for :title, "Parsecs" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 border border-notice-outline bg-notice-bg mb-5 text-notice-fg font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Parsecs</h1>
  </div>

  <div id="parsecs" class="min-w-full divide-y divide-outline space-y-5">
    <% if @parsecs.any? %>
      <% @parsecs.each do |parsec| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render parsec %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Show", parsec, class: "btn" %>
            <%= link_to "Edit", edit_parsec_path(parsec), class: "btn" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No parsecs found.</p>
    <% end %>
  </div>
</div>
