<%= form_with(model: subsector, class: 'contents') do |form| %>
  <div class='space-y-6 pb-10'>
    <%= render 'application/form_errors', errors: subsector.errors.where(:base) %>

    <%= render 'application/edit_field', form: form, attribute: :name do %>
      <%= form.text_field :name, class: 'edit-base w-100' %>
    <% end %>

    <div class='edit-row-notes'>
      <div class='edit-label'>Observations</div>
      <%= form.text_area :notes, rows: 6, class: 'edit-base mt-2 w-full resize-y' %>
    </div>

    <div>
      <div class='flex items-end justify-between gap-3'>
        <div>
          <div class='text-xs uppercase tracking-[0.22em] text-slate-400'>
            Build plan
          </div>
          <div class='mt-1 text-lg font-semibold text-slate-400'>
            YAML input
          </div>
        </div>

        <%= link_to 'Build spec reference',
                    help_subsector_build_specification_path,
                    class: 'link-traveller text-xs' %>
      </div>

      <%= form.text_area :build,
                         rows: 16,
                         aria: { label: 'Build plan YAML' },
                         class: [
                           'font-mono edit-base w-full resize-y mt-2',
                           {
                             'border-gray-400 focus:outline-blue-600': subsector.errors[:build].none?,
                             'border-red-400 focus:outline-red-600': subsector.errors[:build].any?
                           }
                         ] %>
    </div>

    <div class='pt-2 flex flex-col sm:flex-row gap-2'>
      <%= form.submit 'Update core', class: 'w-full sm:w-auto btn btn-primary' %>
      <%= link_to 'Cancel', subsector, class: 'w-full sm:w-auto btn' %>
    </div>
  </div>
<% end %>
