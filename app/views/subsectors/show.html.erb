<% content_for :title, "Showing subsector" %>

<% sector = @subsector.sector %>

<div class="w-full">
  <h1 class="font-bold text-4xl mb-4"><%= @subsector.name %>, <%= link_to sector.name, sector_path(sector), class:"text-inherit hover:text-traveller-red/90 hover:underline" %></h1>

  <div class="flex flex-col md:flex-row md:items-start gap-6">
    <div class="flex-1 min-w-0">
      <div>
        <p>
          <strong>Library data:</strong>
          <% if (u = safe_external_url(@subsector.wiki_link)) %>
            <%= link_to "Traveller Wiki", u, target: "_blank", rel: "noopener", class: "link-traveller" %>
          <% else %>
            <span>Undocumented</span>
          <% end %>
        </p>
      </div>

      <% if @subsector.notes.present? %>
        <div class="mb-4">
          <strong class="block text-sm font-semibold mb-1">Deepnight Log</strong>
          <p class="text-sm whitespace-pre-line">
            <%= @subsector.notes %>
          </p>
        </div>
      <% end %>

      <%= render "star_systems/table", star_systems: @subsector.star_systems, new_url: new_subsector_star_system_path(@subsector) %>

      <%= render 'rogues/table', rogues: @subsector.rogues, new_url: new_subsector_rogue_path(@subsector) %>

      <div class="mt-6 flex flex-col sm:flex-row gap-2">
        <%= link_to "Edit",
                    edit_subsector_path(@subsector),
                    class: "w-full sm:w-auto btn btn-primary" %>

      </div>
    </div>

    <div class="w-full md:w-[300px] shrink-0">
      <% subsectors_by_coord = sector.subsectors.index_by { |s| [s.x, s.y] } %>

      <div class="mt-2">
        <strong class="block font-medium mb-2">
          <%= link_to sector.name, sector, class: "link-traveller-i" %>
        </strong>

        <%= render "sectors/subsector_grid",
                   sector: sector,
                   active_subsector: @subsector %>
      </div>
    </div>
  </div>
</div>
