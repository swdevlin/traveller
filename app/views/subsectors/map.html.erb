<%
  svg_width, svg_height = hex_grid_svg_dimensions
  hex_size = SubsectorsHelper::HEX_SIZE

  systems_by_hex = {}
  @star_systems.each do |sys|
    hc = sys.parsec.hex_code
    systems_by_hex[hc] = sys
  end

  sub_x = @subsector.x
  sub_y = @subsector.y
  highlight_hex = @highlight_hex
-%><svg xmlns="http://www.w3.org/2000/svg"
     width="<%= svg_width %>"
     height="<%= svg_height %>"
     preserveAspectRatio='xMidYMid meet'
     viewBox="0 0 <%= svg_width %> <%= svg_height %>">

  <defs>
    <pattern id="gas-giant-bands" patternUnits="userSpaceOnUse" width="4" height="4">
      <rect width="4" height="4" fill="#E8CDA0"/>
      <rect y="1" width="4" height="1" fill="#C4956A"/>
      <rect y="3" width="4" height="0.5" fill="#A67C52"/>
    </pattern>
  </defs>

  <style>
    .hex { fill: #ffffff; stroke: #cccccc; stroke-width: 1; }
    .hex-highlight { fill: #fef3c7; stroke: #f59e0b; stroke-width: 2; }
    .hex-label { font-family: monospace; font-size: 7px; fill: #666666; }
    .hex-label-empty { font-family: monospace; font-size: 7px; fill: #dddddd; }
    .starport { font-family: monospace; font-size: 10px; fill: #333333; font-weight: bold; }
    .star-circle { stroke: #333; stroke-width: 0.5; }
    .gas-giant { fill: url(#gas-giant-bands); stroke: #996633; stroke-width: 0.5; }
    .clickable { cursor: pointer; }
    .clickable:hover { opacity: 0.7; }
  </style>

  <rect width="100%" height="100%" fill="rgba(15, 23, 42, 0.7)"/>

  <% (1..8).each do |col| %>
    <% (1..10).each do |row| %>
      <%
        cx, cy = hex_center(col, row)

        hx = (sub_x - 1) * 8 + col
        hy = (sub_y - 1) * 10 + row
        hex_code = format('%02d%02d', hx, hy)

        star_system = systems_by_hex[hex_code]
      %>

      <polygon class="<%= hex_code == highlight_hex ? 'hex-highlight' : 'hex' %>" points="<%= hex_polygon_points(cx, cy) %>"/>

      <text class="<%= star_system ? 'hex-label' : 'hex-label-empty' %>" x="<%= cx.round(2) %>" y="<%= (cy - hex_size * 0.55).round(2) %>" text-anchor="middle">
        <%= hex_code %>
      </text>

      <% if star_system %>
        <%
          primary = star_system.primary_star
          star_colour = primary&.colour || 'Yellow'
          fill_colour = star_fill_colour(star_colour)
          starport = star_system.main_world_uwp&.first || '?'
          has_gg = star_system.has_gas_giant?
        %>

        <text class="starport" x="<%= cx.round(2) %>" y="<%= (cy - hex_size * 0.25).round(2) %>" text-anchor="middle">
          <%= starport %>
        </text>

        <a href="<%= star_system_path(star_system) %>" target="_top" class="clickable">
          <circle class="star-circle" cx="<%= cx.round(2) %>" cy="<%= (cy + hex_size * 0.15).round(2) %>"
                  r="<%= (hex_size * 0.3).round(2) %>" fill="<%= fill_colour %>"/>
        </a>

        <% if has_gg %>
          <circle class="gas-giant" cx="<%= (cx + hex_size * 0.5).round(2) %>" cy="<%= (cy - hex_size * 0.3).round(2) %>"
                  r="<%= (hex_size * 0.12).round(2) %>"/>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</svg>
