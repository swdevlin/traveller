<div id="<%= dom_id subsector %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= subsector.name %>
  </div>
  <% if (reference_url = safe_external_url(subsector.effective_reference_url(current_campaign))) %>
    <div>
      <p>
        <strong>Library data:</strong>
        <%= link_to "Reference", reference_url, target: "_blank", rel: "noopener", class: "link-traveller" %>
      </p>
    </div>
  <% end %>

</div>
