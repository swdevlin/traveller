<% content_for :title, "Editing #{@subsector.name}, #{@subsector.sector.name}" %>

<div class="w-full">
  <div class='mt-4'>
    <div class='text-xs uppercase tracking-[0.22em] text-slate-400'>
      Subsector Data Core
    </div>
    <div class='mt-1 text-2xl font-header text-deepnight-orange'>
      <%= @subsector.name %>, <%= link_to @subsector.sector.name, sector_path(@subsector.sector), class: 'hover:underline underline-offset-4' %>
    </div>
  </div>

  <%= render "form", subsector: @subsector %>
</div>
