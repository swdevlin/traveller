<% content_for :title, "Load Build Default, #{@subsector.name}" %>

<%= render 'application/page' do %>
  <div class='space-y-6'>
    <div>
      <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>
        Load Build Default
      </div>
      <div class='mt-1 text-2xl font-header text-highlight'>
        <%= link_to @subsector.name, subsector_path(@subsector), class: 'hover:underline underline-offset-4' %>,
        <%= link_to @subsector.sector.name, sector_path(@subsector.sector), class: 'hover:underline underline-offset-4' %>
      </div>
      <p class='mt-2 text-sm text-fg leading-relaxed'>
        Select the source for this subsector's build configuration.
      </p>
    </div>

    <div class='space-y-3'>
      <% if @default_build_source == 'traveller_map' %>
        <div class='flex items-start gap-3'>
          <i class='fa-regular fa-map text-fg mt-0.5'></i>
          <div class='min-w-0'>
            <div class='font-semibold text-fg-bright'>TravellerMap</div>
            <div class='text-sm text-fg'>
              Pulls subsector data from TravellerMap, including system positions, UWPs, and star data.
            </div>
          </div>
          <div class='ml-auto shrink-0'>
            <%= button_to 'Load',
                          load_defaults_subsector_path(@subsector),
                          method: :post,
                          class: 'btn btn-primary',
                          data: {
                            controller: 'busy',
                            action: 'turbo:submit-start@window->busy#start turbo:submit-end@window->busy#stop',
                            turbo_confirm: @subsector.build.present? ? 'This will replace the current build configuration. Continue?' : nil
                          }.compact %>
          </div>
        </div>

        <div class='h-px border-outline/70'></div>
      <% elsif @default_build_source == 'deepnight' %>
        <div class='flex items-start gap-3'>
          <i class='fa-regular fa-satellite text-fg mt-0.5'></i>
          <div class='min-w-0'>
            <div class='font-semibold text-fg-bright'>Deepnight Revelation</div>
            <div class='text-sm text-fg'>
              Campaign-tuned presets with curated density, survey index, and unusual object rates.
            </div>
          </div>
          <div class='ml-auto shrink-0'>
            <%= button_to 'Load',
                          load_defaults_subsector_path(@subsector),
                          method: :post,
                          class: 'btn btn-primary',
                          data: {
                            controller: 'busy',
                            action: 'turbo:submit-start@window->busy#start turbo:submit-end@window->busy#stop',
                            turbo_confirm: @subsector.build.present? ? 'This will replace the current build configuration. Continue?' : nil
                          }.compact %>
          </div>
        </div>

        <div class='h-px border-outline/70'></div>
      <% end %>

      <div class='flex items-start gap-3'>
        <i class='fa-regular fa-cloud-arrow-up text-fg mt-0.5'></i>
        <div class='min-w-0 flex-1'>
          <div class='font-semibold text-fg-bright'>Upload T5 File</div>
          <div class='text-sm text-fg mb-3'>
            Sets the build plan from an uploaded
            <%= link_to 'T5 Tab Delimited', 'https://travellermap.com/doc/fileformats#t5tab', target: '_blank', rel: 'noopener', class: 'no-underline hover:underline hover:underline-offset-2' %>
            sector data file scoped to this subsector&rsquo;s hexes. This replaces the current build plan.
          </div>
          <%= form_with url: upload_t5_subsector_path(@subsector), multipart: true, class: 'flex items-center gap-3', data: { controller: 'file-select' } do |f| %>
            <%= render 'application/file_field', name: 't5_file', accept: '.txt,.tab', compact: true,
                       data: { file_select_target: 'input', action: 'change->file-select#toggle' } %>
            <%= f.submit 'Upload', class: 'btn btn-primary shrink-0', disabled: true,
                         data: {
                           controller: 'busy',
                           action: 'turbo:submit-start@window->busy#start turbo:submit-end@window->busy#stop',
                           file_select_target: 'submit'
                         } %>
          <% end %>
        </div>
      </div>
    </div>

    <div class='space-y-3'>
      <div class='flex items-center justify-between gap-3'>
        <div class='text-xs uppercase tracking-[0.22em] text-fg-muted'>Current build</div>
        <% if @subsector.build.present? %>
          <span class='text-green-400 text-sm'>
            <i class='fa-regular fa-circle-check mr-1'></i><%= @subsector.build_source_label %>
          </span>
        <% else %>
          <span class='text-fg-muted text-sm'>
            <i class='fa-regular fa-circle-minus mr-1'></i>Not configured
          </span>
        <% end %>
      </div>

      <% if @subsector.build.present? %>
        <textarea readonly rows='12'
                  aria-label='Current build plan YAML'
                  class='font-mono edit-base w-full resize-y opacity-80 cursor-not-allowed'><%= @subsector.build %></textarea>
      <% end %>
    </div>
  </div>
<% end %>
