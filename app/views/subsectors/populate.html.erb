<% content_for :title, 'Populating subsector' %>

<% sector = @subsector.sector %>

<div class='w-full'>
  <h1 class='font-bold text-4xl mb-4'>
    <%= @subsector.name %>,
    <%= link_to sector.name,
                sector_path(sector),
                class: 'text-inherit hover:text-traveller-red/90 hover:underline' %>
  </h1>

  <div class='flex flex-col md:flex-row md:items-start gap-6'>
    <div class='flex-1 min-w-0'>
      <% if @subsector.notes.present? %>
        <div class='mb-4'>
          <strong class='block text-sm font-semibold mb-1'>Notes</strong>
          <p class='text-sm whitespace-pre-line'>
            <%= @subsector.notes %>
          </p>
        </div>
      <% end %>

      <%= form_with(model: @subsector, url: generate_subsector_path(@subsector), method: :post, class: 'contents') do |form| %>
        <div class='mt-5'>
          <%= form.label :build, 'Build plan' %>

          <div class='mt-2 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-4 items-start'>
            <div>
              <%= form.text_area :build,
                                 rows: 20,
                                 class: [
                                   'font-mono edit-base w-full resize-y',
                                   {
                                     'border-gray-400 focus:outline-blue-600': @subsector.errors[:build].none?,
                                     'border-red-400 focus:outline-red-600': @subsector.errors[:build].any?
                                   }
                                 ] %>

              <div class='mt-4 flex flex-col sm:flex-row gap-2'>
                <% confirm_msg = "There are #{pluralize(@star_system_count, "star system")} and #{pluralize(@rogue_count, "rogue stellar object")} in the subsector. Are you sure you wish to replace them?" %>

                <%= form.submit 'Generate',
                                class: 'w-full sm:w-auto btn btn-primary',
                                data: { turbo_confirm: confirm_msg } %>

                <%= link_to 'Cancel',
                            @subsector,
                            class: 'w-full sm:w-auto btn' %>
              </div>
            </div>

            <%= render 'build_help' %>
          </div>
        </div>
      <% end %>
    </div>

    <div class='w-full md:w-[300px] shrink-0'>
      <% subsectors_by_coord = sector.subsectors.index_by { |s| [s.x, s.y] } %>

      <div class='mt-2'>
        <strong class='block font-medium mb-2'>
          <%= link_to sector.name, sector, class: 'link-traveller-i' %>
        </strong>

        <%= render 'sectors/subsector_grid',
                   sector: sector,
                   active_subsector: @subsector %>
      </div>
    </div>
  </div>
</div>
