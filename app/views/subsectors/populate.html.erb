<% content_for :title, 'Populating subsector' %>

<% sector = @subsector.sector %>

<div class='w-full'>
  <h1 class='font-bold text-4xl mb-4'>
    <%= @subsector.name %>,
    <%= link_to sector.name,
                sector_path(sector),
                class: 'text-inherit hover:text-traveller-red/90 hover:underline' %>
  </h1>

  <div class='flex flex-col md:flex-row md:items-start gap-6'>
    <div class='flex-1 min-w-0'>
      <% if @subsector.notes.present? %>
        <div class='mb-4'>
          <strong class='block text-sm font-semibold mb-1'>Notes</strong>
          <p class='text-sm whitespace-pre-line'>
            <%= @subsector.notes %>
          </p>
        </div>
      <% end %>

      <%= form_with(model: @subsector, class: 'contents') do |form| %>
        <div class='mt-5'>
          <%= form.label :build, 'Build plan' %>

          <div class='mt-2 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-4 items-start'>
            <div>
              <%= form.text_area :build,
                                 rows: 20,
                                 class: [
                                   'font-mono edit-base w-full resize-y',
                                   {
                                     'border-gray-400 focus:outline-blue-600': @subsector.errors[:build].none?,
                                     'border-red-400 focus:outline-red-600': @subsector.errors[:build].any?
                                   }
                                 ] %>

              <div class='mt-4 flex flex-col sm:flex-row gap-2'>
                <% confirm_msg = 'There are stuff. Are you sure you wish to generate?' %>

                <%= form.submit 'Generate',
                                class: 'w-full sm:w-auto btn btn-primary',
                                data: { turbo_confirm: confirm_msg } %>

                <%= link_to 'Cancel',
                            @subsector,
                            class: 'w-full sm:w-auto btn' %>
              </div>
            </div>

            <aside class='rounded-2xl bg-slate-950/60 p-4'>
              <div class='flex items-center gap-2 mb-3'>
                <i class='fa-solid fa-circle-info text-slate-300'></i>
                <h2 class='text-sm font-semibold text-slate-200'>Build plan help</h2>
              </div>

              <dl class='space-y-3 text-sm'>
                <div>
                  <dt class='font-semibold text-slate-200'>
                    <i class='fa-solid fa-dice text-slate-400 mr-2'></i>
                    unusualChance
                  </dt>
                  <dd class='text-slate-300 mt-1'>
                    Chance (typically 0..6) that an &lsquo;unusual&rsquo; result overrides normal generation for a system.
                    Higher means stranger subsector outcomes.
                  </dd>
                </div>

                <div>
                  <dt class='font-semibold text-slate-200'>
                    <i class='fa-solid fa-signal text-slate-400 mr-2'></i>
                    defaultSI
                  </dt>
                  <dd class='text-slate-300 mt-1'>
                    Default Survey Index used when a system does not specify one explicitly.
                  </dd>
                </div>

                <div>
                  <dt class='font-semibold text-slate-200'>
                    <i class='fa-solid fa-percent text-slate-400 mr-2'></i>
                    chance
                  </dt>
                  <dd class='text-slate-300 mt-1'>
                    Density profile name. This controls the per-hex probability that a star system is placed when not using
                    <span class='font-mono text-slate-200'>systems</span> whitelist mode.
                  </dd>

                  <div class='mt-2 rounded-xl bg-slate-900/30 p-3'>
                    <p class='text-xs text-slate-300 font-semibold mb-2'>Options</p>

                    <ul class='text-xs text-slate-300 space-y-1'>
                      <li><span class='font-mono text-slate-200'>DENSE</span> – 60%</li>
                      <li><span class='font-mono text-slate-200'>STANDARD</span> – 50%</li>
                      <li><span class='font-mono text-slate-200'>MODERATE</span> – 40%</li>
                      <li><span class='font-mono text-slate-200'>LOW</span> – 30%</li>
                      <li><span class='font-mono text-slate-200'>SPARSE</span> – 20%</li>
                      <li><span class='font-mono text-slate-200'>MINIMAL</span> – 10%</li>
                      <li><span class='font-mono text-slate-200'>RIFT</span> – 3%</li>
                      <li><span class='font-mono text-slate-200'>RIFT_FADE</span> – 2%</li>
                      <li><span class='font-mono text-slate-200'>DEEP_RIFT</span> – 1%</li>
                      <li><span class='font-mono text-slate-200'>EMPTY</span> – 0%</li>
                    </ul>

                    <p class='mt-2 text-xs text-slate-400'>
                      Example: <span class='font-mono text-slate-200'>chance: STANDARD</span>
                    </p>
                  </div>
                </div>

                <div>
                  <dt class='font-semibold text-slate-200'>
                    <i class='fa-solid fa-ban text-slate-400 mr-2'></i>
                    exclude
                  </dt>
                  <dd class='text-slate-300 mt-1'>
                    List of hex coordinates (e.g. <span class='font-mono text-slate-200'>0101</span> .. <span class='font-mono text-slate-200'>0810</span>)
                    where the generator must <span class='font-semibold text-slate-200'>not</span> place a star system.
                  </dd>
                </div>

                <div>
                  <dt class='font-semibold text-slate-200'>
                    <i class='fa-solid fa-circle-check text-slate-400 mr-2'></i>
                    required
                  </dt>
                  <dd class='text-slate-300 mt-1'>
                    List of hex coordinates that must <span class='font-semibold text-slate-200'>always</span> have a star system.
                    If a coordinate appears in both <span class='font-mono text-slate-200'>required</span> and
                    <span class='font-mono text-slate-200'>exclude</span>, treat that as a config mistake.
                  </dd>
                </div>

                <div>
                  <dt class='font-semibold text-slate-200'>
                    <i class='fa-solid fa-grid-2-plus text-slate-400 mr-2'></i>
                    systems
                  </dt>
                  <dd class='text-slate-300 mt-1'>
                    If this list is present and non-empty, the generator will place star systems
                    <span class='font-semibold text-slate-200'>only</span> in these hexes.
                    In this mode, <span class='font-mono text-slate-200'>exclude</span> and
                    <span class='font-mono text-slate-200'>required</span> are ignored.
                  </dd>

                  <div class='mt-2 rounded-xl bg-slate-900/30 p-3'>
                    <p class='text-xs text-slate-300 font-semibold mb-2'>
                      Examples
                    </p>

                    <pre class='text-xs font-mono text-slate-200 whitespace-pre-wrap'>exclude:
  - 0101
  - 0203

required:
  - 0404
  - 0810

systems:
  - 0101
  - 0810</pre>

                    <p class='mt-2 text-xs text-slate-400'>
                      When <span class='font-mono text-slate-200'>systems</span> is set, only those hexes get systems. Nothing else does.
                    </p>
                  </div>
                </div>
              </dl>

              <p class='mt-4 text-xs text-slate-400'>
                Tip: keep indentation at 2 spaces. YAML is picky about that.
              </p>
            </aside>
          </div>
        </div>
      <% end %>
    </div>

    <div class='w-full md:w-[300px] shrink-0'>
      <% subsectors_by_coord = sector.subsectors.index_by { |s| [s.x, s.y] } %>

      <div class='mt-2'>
        <strong class='block font-medium mb-2'>
          <%= link_to sector.name, sector, class: 'link-traveller-i' %>
        </strong>

        <%= render 'sectors/subsector_grid',
                   sector: sector,
                   active_subsector: @subsector %>
      </div>
    </div>
  </div>
</div>
