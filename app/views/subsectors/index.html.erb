<% content_for :title, "Subsectors" %>

<div class="w-full">
  <div id="subsectors" class="min-w-full divide-y divide-outline space-y-5">
    <% if @subsectors.any? %>
      <% @subsectors.each do |subsector| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render subsector %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Show", subsector, class: "btn" %>
            <%= link_to "Edit", edit_subsector_path(subsector), class: "btn" %>
            <%= button_to "Destroy", subsector, method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No subsectors found.</p>
    <% end %>
  </div>
</div>
