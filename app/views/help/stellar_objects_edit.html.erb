<% content_for :title, 'Edit planetary body' %>

<%= render 'help/page', title: 'Edit Planetary Body' do %>
  <div class='max-w-2xl space-y-6'>
    <div class='rounded-2xl bg-slate-950/50 p-5 space-y-6'>
      <div class='space-y-3 text-sm text-slate-300'>
        <p>
          The edit form applies to terrestrial planets, planetoids, and moons.
          The Orbital section is only shown when the body orbits a star.
          Press <span class='font-semibold text-slate-200'>Update core</span> to save changes.
        </p>
      </div>

      <div>
        <p class='text-sm font-semibold text-deepnight-orange mb-2'>Name</p>
        <dl class='space-y-5 text-sm'>
          <div>
            <dt class='font-semibold text-slate-200'>Name</dt>
            <dd class='mt-1 text-slate-300'>The body's designation or proper name.</dd>
          </div>
        </dl>
      </div>

      <div>
        <p class='text-sm font-semibold text-deepnight-orange mb-2'>Orbital</p>
        <dl class='space-y-5 text-sm'>
          <div>
            <dt class='font-semibold text-slate-200'>Orbit</dt>
            <dd class='mt-1 text-slate-300'>Orbital radius as an orbit number. Must be at or beyond the parent star's minimum allowable orbit.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Period</dt>
            <dd class='mt-1 text-slate-300'>Orbital period around the parent body.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Retrograde</dt>
            <dd class='mt-1 text-slate-300'>Enable if the body orbits opposite to the primary star's rotation.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Rotation</dt>
            <dd class='mt-1 text-slate-300'>Sidereal rotation period in hours.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Inclination</dt>
            <dd class='mt-1 text-slate-300'>Orbital plane inclination in degrees.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Eccentricity</dt>
            <dd class='mt-1 text-slate-300'>Orbital eccentricity (0 = circular).</dd>
          </div>
        </dl>
      </div>

      <div>
        <p class='text-sm font-semibold text-deepnight-orange mb-2'>Starport</p>
        <dl class='space-y-5 text-sm'>
          <div>
            <dt class='font-semibold text-slate-200'>Starport</dt>
            <dd class='mt-1 text-slate-300'>Class of the primary port facility (A–E, X for none).</dd>
          </div>
        </dl>
      </div>

      <div>
        <p class='text-sm font-semibold text-deepnight-orange mb-2'>Physical</p>
        <dl class='space-y-5 text-sm'>
          <div>
            <dt class='font-semibold text-slate-200'>Size</dt>
            <dd class='mt-1 text-slate-300'>UWP size code. Changing size recalculates diameter, mass, and gravity.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Diameter</dt>
            <dd class='mt-1 text-slate-300'>Surface diameter in kilometres. Editing diameter recalculates mass and gravity.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Density</dt>
            <dd class='mt-1 text-slate-300'>Mean density relative to Earth (☉). Editing density recalculates mass and gravity.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Mass / Gravity</dt>
            <dd class='mt-1 text-slate-300'>Calculated from diameter and density. Can be overridden manually.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Temperature</dt>
            <dd class='mt-1 text-slate-300'>Mean surface temperature in Kelvin.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Axial Tilt</dt>
            <dd class='mt-1 text-slate-300'>Axial tilt in degrees.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Albedo</dt>
            <dd class='mt-1 text-slate-300'>Fraction of incident solar radiation reflected (0–1).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Greenhouse</dt>
            <dd class='mt-1 text-slate-300'>Greenhouse effect factor.</dd>
          </div>
        </dl>
      </div>

      <div>
        <p class='text-sm font-semibold text-deepnight-orange mb-2'>Atmosphere</p>
        <dl class='space-y-5 text-sm'>
          <div>
            <dt class='font-semibold text-slate-200'>Atmosphere</dt>
            <dd class='mt-1 text-slate-300'>Atmosphere type code (UWP digit).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Composition</dt>
            <dd class='mt-1 text-slate-300'>Free-text description of atmospheric composition.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Irritant / Taint Severity / Taint Persistence</dt>
            <dd class='mt-1 text-slate-300'>Atmospheric taint type, how dangerous it is, and how quickly it disperses.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Hazard</dt>
            <dd class='mt-1 text-slate-300'>Insidious atmospheric hazard code (B Biological, R Radioactive, G Gas, T Thermal).</dd>
          </div>
        </dl>
      </div>

      <div>
        <p class='text-sm font-semibold text-deepnight-orange mb-2'>Hydrographics</p>
        <dl class='space-y-5 text-sm'>
          <div>
            <dt class='font-semibold text-slate-200'>Hydrographics</dt>
            <dd class='mt-1 text-slate-300'>Percentage of surface covered by liquid (UWP code).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Liquid</dt>
            <dd class='mt-1 text-slate-300'>Type of liquid present (e.g. water, hydrocarbons).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Distribution</dt>
            <dd class='mt-1 text-slate-300'>Pattern of liquid distribution across the surface.</dd>
          </div>
        </dl>
      </div>

      <div>
        <p class='text-sm font-semibold text-deepnight-orange mb-2'>Population</p>
        <dl class='space-y-5 text-sm'>
          <div>
            <dt class='font-semibold text-slate-200'>Population</dt>
            <dd class='mt-1 text-slate-300'>Population code 0–12.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Concentration Rating</dt>
            <dd class='mt-1 text-slate-300'>How concentrated the population is (0 = extremely dispersed, 9 = extremely concentrated).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Urbanisation %</dt>
            <dd class='mt-1 text-slate-300'>Percentage of the population living in urban settlements (0–100).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Major Cities</dt>
            <dd class='mt-1 text-slate-300'>Number of significant urban centres.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Native / Extinct Sophont</dt>
            <dd class='mt-1 text-slate-300'>Whether a sophont species is or was native to this body.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Habitability Rating</dt>
            <dd class='mt-1 text-slate-300'>
              A score from 0 to 10 indicating suitability for unprotected human habitation.
              0 is actively hostile; 10 is a Terra-equivalent garden world. See WBH p. 132.
            </dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Biomass Rating</dt>
            <dd class='mt-1 text-slate-300'>Total biological mass on a comparative scale.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Biodiversity Rating</dt>
            <dd class='mt-1 text-slate-300'>Number of distinct species or ecological niches.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Biocomplexity Rating</dt>
            <dd class='mt-1 text-slate-300'>Highest level of biological complexity present (1–10).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Resource Rating</dt>
            <dd class='mt-1 text-slate-300'>Economic value of extractable resources (2–12).</dd>
          </div>
        </dl>
      </div>

      <div>
        <p class='text-sm font-semibold text-deepnight-orange mb-2'>Government</p>
        <dl class='space-y-5 text-sm'>
          <div>
            <dt class='font-semibold text-slate-200'>Government</dt>
            <dd class='mt-1 text-slate-300'>Government type code (0–F hex). See WBH p. 156.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Judicial / Executive / Legislative</dt>
            <dd class='mt-1 text-slate-300'>
              Structural composition of each branch: D Demos (elected assembly), S Single Council,
              M Multiple Councils, R Ruler. See WBH p. 158.
            </dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Authority</dt>
            <dd class='mt-1 text-slate-300'>
              Which branch holds supreme authority: L Legislative, E Executive, J Judicial, B Balance (no dominant branch). See WBH p. 159.
            </dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Centralisation</dt>
            <dd class='mt-1 text-slate-300'>
              Degree of central control: C Confederal (constituent units hold power), F Federal (power shared between centre and units), U Unitary (centre holds power). See WBH p. 159.
            </dd>
          </div>
        </dl>
      </div>

      <div>
        <p class='text-sm font-semibold text-deepnight-orange mb-2'>Law Level</p>
        <dl class='space-y-5 text-sm'>
          <div>
            <dt class='font-semibold text-slate-200'>Law Level</dt>
            <dd class='mt-1 text-slate-300'>
              Overall degree of legal restriction (0–F hex). Changing this value automatically resets
              all five sub-classification selects to match, providing a baseline that can then be
              adjusted individually.
            </dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Weapons &amp; Armour</dt>
            <dd class='mt-1 text-slate-300'>Law level governing possession and carry of weapons and personal armour.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Criminal Law</dt>
            <dd class='mt-1 text-slate-300'>Law level for criminal offences and prosecution thresholds.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Economic Law</dt>
            <dd class='mt-1 text-slate-300'>Law level regulating commerce, licensing, and trade.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Private Law</dt>
            <dd class='mt-1 text-slate-300'>Law level governing civil disputes and private contracts.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Personal Rights</dt>
            <dd class='mt-1 text-slate-300'>Law level covering individual freedoms such as identification requirements and movement.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Uniformity</dt>
            <dd class='mt-1 text-slate-300'>How consistently laws are applied: P Personal (varies by individual), T Territorial (varies by region), U Universal (applied equally to all).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Judicial System</dt>
            <dd class='mt-1 text-slate-300'>Court structure: I Inquisitorial (state-led investigation), A Adversarial (opposing counsel), T Traditional (customary or religious law).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Death Penalty</dt>
            <dd class='mt-1 text-slate-300'>Whether capital punishment is in use.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Presumed Innocence</dt>
            <dd class='mt-1 text-slate-300'>Whether defendants are presumed innocent until proven guilty.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Econometric Infractions Administrative</dt>
            <dd class='mt-1 text-slate-300'>Whether economic violations are handled administratively rather than criminally.</dd>
          </div>
        </dl>
      </div>

      <div>
        <p class='text-sm font-semibold text-deepnight-orange mb-2'>Tech Level</p>
        <dl class='space-y-5 text-sm'>
          <div>
            <dt class='font-semibold text-slate-200'>Tech Level</dt>
            <dd class='mt-1 text-slate-300'>Technological sophistication of the dominant culture (0–35). Sets the overall tech level recorded in the UWP.</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Electronics</dt>
            <dd class='mt-1 text-slate-300'>Tech level for electronics and computing. May differ from the overall level where a society has specialised in this field (WBH p. 173).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Energy</dt>
            <dd class='mt-1 text-slate-300'>Tech level for energy production and distribution (WBH p. 173).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Land</dt>
            <dd class='mt-1 text-slate-300'>Tech level for land transport (WBH p. 173).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Sea</dt>
            <dd class='mt-1 text-slate-300'>Tech level for sea transport (WBH p. 173).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Air</dt>
            <dd class='mt-1 text-slate-300'>Tech level for air transport (WBH p. 173).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Space</dt>
            <dd class='mt-1 text-slate-300'>Tech level for space transport and operations (WBH p. 173).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Personal Military</dt>
            <dd class='mt-1 text-slate-300'>Tech level for personal-scale military equipment (WBH p. 173).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Heavy Military</dt>
            <dd class='mt-1 text-slate-300'>Tech level for heavy military equipment and vehicles (WBH p. 173).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Manufacturing</dt>
            <dd class='mt-1 text-slate-300'>Tech level for industrial manufacturing (WBH p. 173).</dd>
          </div>
          <div>
            <dt class='font-semibold text-slate-200'>Medical</dt>
            <dd class='mt-1 text-slate-300'>Tech level for medical technology (WBH p. 173).</dd>
          </div>
        </dl>
      </div>

      <div>
        <p class='text-sm font-semibold text-deepnight-orange mb-2'>Observations</p>
        <dl class='space-y-5 text-sm'>
          <div>
            <dt class='font-semibold text-slate-200'>Observations</dt>
            <dd class='mt-1 text-slate-300'>Free-text notes in CommonMark (Markdown) format.</dd>
          </div>
        </dl>
      </div>

      <div class='pt-2 text-right uppercase font-mono text-xs tracking-[0.22em] text-slate-500'>
        REFERENCE 0423PB
      </div>
    </div>
  </div>
<% end %>
