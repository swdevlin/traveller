<% content_for :title, 'Star Map' %>

<% content_for :head do %>
  <link rel='preconnect' href='https://fonts.googleapis.com'>
  <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>
  <link
    href='https://fonts.googleapis.com/css2?family=Tomorrow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap'
    rel='stylesheet'>
<% end %>

<div
  id='root'
  class='h-screen w-screen overflow-hidden font-[Tomorrow]'
  data-starmap-flags='<%= json_escape(@starmap_flags.to_json) %>'>
</div>

<script src='/starmap.js?v=<%= File.mtime(Rails.root.join('public', 'starmap.js')).to_i rescue 0 %>'></script>
