<%= content_for :title, "Tech levels" %>
<%= content_for :page_kicker, "Reference Manual" %>
<%= content_for :page_title, "Tech levels" %>

<%= render 'application/page' do %>
  <div class='table-card'>
    <div class='table-banner'>
      <p>Tech level registry</p>

      <div class='actions'>
        <%= link_to new_tech_level_path, class: 'btn-header' do %>
          <i class='fa-regular fa-plus'></i>
          Add
        <% end %>
      </div>
    </div>

    <div class='table-scroll'>
      <table>
        <thead>
        <tr>
          <th scope='col'>Code</th>
          <th scope='col'>Energy</th>
          <th scope='col'>Electronics</th>
          <th scope='col'>Manufacturing</th>
          <th scope='col'>Medical</th>
          <th scope='col'>Environmental</th>
          <th scope='col'>Land</th>
          <th scope='col'>Sea</th>
          <th scope='col'>Air</th>
          <th scope='col'>Space</th>
          <th scope='col'>Personal military</th>
          <th scope='col'>Heavy military</th>
          <th scope='col' class='text-right actions-cell'>Actions</th>
        </tr>
        </thead>

        <tbody>
        <% @tech_levels.each do |tech_level| %>
          <tr>
            <td class='whitespace-nowrap'>
              <%= link_to tech_level_path(tech_level), class: 't-link' do %>
                <span class='pill'><%= traveller_hex(tech_level.code) %></span>
              <% end %>
            </td>

            <td><%= tech_level.energy %></td>
            <td><%= tech_level.electronics %></td>
            <td><%= tech_level.manufacturing %></td>
            <td><%= tech_level.medical %></td>
            <td><%= tech_level.environmental %></td>
            <td><%= tech_level.land %></td>
            <td><%= tech_level.sea %></td>
            <td><%= tech_level.air %></td>
            <td><%= tech_level.space %></td>
            <td><%= tech_level.personal_military %></td>
            <td><%= tech_level.heavy_military %></td>

            <td class='actions-cell'>
              <div class='action-group'>
                <%= link_to edit_tech_level_path(tech_level), class: 'action' do %>
                  <i class='fa-regular fa-pen-to-square'></i>
                <% end %>

                <%= button_to tech_level,
                              method: :delete,
                              class: 'action danger',
                              data: { turbo_confirm: 'Delete this tech level?' } do %>
                  <i class='fa-regular fa-trash'></i>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
