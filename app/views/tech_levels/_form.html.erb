<%= form_with(model: tech_level, class: 'contents') do |form| %>
  <%= hidden_field_tag :return_to, @return_to %>
  <div class='space-y-6 pb-10'>
    <% if tech_level.errors.any? %>
      <div class='rounded-2xl border border-traveller-red/40 bg-slate-950/60 p-4'>
        <div class='text-xs uppercase tracking-[0.22em] text-slate-400'>
          Validation
        </div>
        <div class='mt-1 text-sm font-semibold text-slate-200'>
          <%= pluralize(tech_level.errors.count, 'error') %> prevented this tech level from being saved
        </div>

        <ul class='mt-3 list-disc ml-6 text-sm text-slate-300 space-y-1'>
          <% tech_level.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class='mt-4'>
      <%= form.label :code, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.number_field :code,
                          class: [
                            'w-full edit-base mt-2 sm:w-1/2',
                            {
                              'border-gray-400 focus:outline-blue-600': tech_level.errors[:code].none?,
                              'border-red-400 focus:outline-red-600': tech_level.errors[:code].any?
                            }
                          ] %>
    </div>

    <div>
      <%= form.label :energy, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.text_field :energy,
                          class: [
                            'w-full edit-base mt-2',
                            {
                              'border-gray-400 focus:outline-blue-600': tech_level.errors[:energy].none?,
                              'border-red-400 focus:outline-red-600': tech_level.errors[:energy].any?
                            }
                          ] %>
    </div>

    <div>
      <%= form.label :electronics, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.text_field :electronics,
                          class: [
                            'w-full edit-base mt-2',
                            {
                              'border-gray-400 focus:outline-blue-600': tech_level.errors[:electronics].none?,
                              'border-red-400 focus:outline-red-600': tech_level.errors[:electronics].any?
                            }
                          ] %>
    </div>

    <div>
      <%= form.label :manufacturing, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.text_field :manufacturing,
                          class: [
                            'w-full edit-base mt-2',
                            {
                              'border-gray-400 focus:outline-blue-600': tech_level.errors[:manufacturing].none?,
                              'border-red-400 focus:outline-red-600': tech_level.errors[:manufacturing].any?
                            }
                          ] %>
    </div>

    <div>
      <%= form.label :medical, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.text_field :medical,
                          class: [
                            'w-full edit-base mt-2',
                            {
                              'border-gray-400 focus:outline-blue-600': tech_level.errors[:medical].none?,
                              'border-red-400 focus:outline-red-600': tech_level.errors[:medical].any?
                            }
                          ] %>
    </div>

    <div>
      <%= form.label :environmental, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.text_field :environmental,
                          class: [
                            'w-full edit-base mt-2',
                            {
                              'border-gray-400 focus:outline-blue-600': tech_level.errors[:environmental].none?,
                              'border-red-400 focus:outline-red-600': tech_level.errors[:environmental].any?
                            }
                          ] %>
    </div>

    <div>
      <%= form.label :land, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.text_field :land,
                          class: [
                            'w-full edit-base mt-2',
                            {
                              'border-gray-400 focus:outline-blue-600': tech_level.errors[:land].none?,
                              'border-red-400 focus:outline-red-600': tech_level.errors[:land].any?
                            }
                          ] %>
    </div>

    <div>
      <%= form.label :sea, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.text_field :sea,
                          rows: 4,
                          class: [
                            'w-full edit-base mt-2',
                            {
                              'border-gray-400 focus:outline-blue-600': tech_level.errors[:sea].none?,
                              'border-red-400 focus:outline-red-600': tech_level.errors[:sea].any?
                            }
                          ] %>
    </div>

    <div>
      <%= form.label :air, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.text_field :air,
                          class: [
                            'w-full edit-base mt-2',
                            {
                              'border-gray-400 focus:outline-blue-600': tech_level.errors[:air].none?,
                              'border-red-400 focus:outline-red-600': tech_level.errors[:air].any?
                            }
                          ] %>
    </div>

    <div>
      <%= form.label :space, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.text_field :space,
                          class: [
                            'w-full edit-base mt-2',
                            {
                              'border-gray-400 focus:outline-blue-600': tech_level.errors[:space].none?,
                              'border-red-400 focus:outline-red-600': tech_level.errors[:space].any?
                            }
                          ] %>
    </div>

    <div>
      <%= form.label :personal_military, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.text_field :personal_military,
                          class: [
                            'w-full edit-base mt-2',
                            {
                              'border-gray-400 focus:outline-blue-600': tech_level.errors[:personal_military].none?,
                              'border-red-400 focus:outline-red-600': tech_level.errors[:personal_military].any?
                            }
                          ] %>
    </div>

    <div>
      <%= form.label :heavy_military, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.text_field :heavy_military,
                          class: [
                            'w-full edit-base mt-2 resize-y',
                            {
                              'border-gray-400 focus:outline-blue-600': tech_level.errors[:heavy_military].none?,
                              'border-red-400 focus:outline-red-600': tech_level.errors[:heavy_military].any?
                            }
                          ] %>
    </div>

    <div>
      <%= form.label :notes, class: 'text-xs uppercase tracking-[0.22em] text-slate-400' %>
      <%= form.text_area :notes,
                          rows: 4,
                          class: [
                            'w-full edit-base mt-2 resize-y',
                            {
                              'border-gray-400 focus:outline-blue-600': tech_level.errors[:notes].none?,
                              'border-red-400 focus:outline-red-600': tech_level.errors[:notes].any?
                            }
                          ] %>
    </div>

    <div class='pt-2 flex flex-col sm:flex-row gap-2'>
      <%= form.submit 'Update core', class: 'w-full sm:w-auto btn btn-primary' %>
      <%= link_to 'Cancel', tech_level.persisted? ? tech_level : tech_levels_path, class: 'w-full sm:w-auto btn' %>
    </div>
  </div>
<% end %>
