<% content_for :title, @jump_route.name %>
<% content_for :page_kicker, 'Jump Route' %>
<% content_for :page_title, @jump_route.name %>

<%= render 'application/page' do %>
  <%= render @jump_route %>

  <% if @jump_route.plotted? %>
    <% systems = @jump_route.ordered_systems %>
    <% if @show_map && @map_svg %>
      <div class='flex gap-6 items-start my-4'>
        <div class='flex-1 min-w-0'>
          <div class='mb-1 relative flex items-center justify-end h-9'>
            <%= link_to map_jump_route_path(@jump_route),
                        target: '_blank',
                        rel: 'noopener',
                        class: 'text-fg-muted hover:text-fg-bright',
                        title: 'Open map in new tab' do %>
              <i class='fa-regular fa-arrow-up-right-from-square'></i>
            <% end %>
          </div>
          <div class='overflow-auto rounded-md'>
            <%= @map_svg.html_safe %>
          </div>
        </div>
        <div class='shrink-0'>
          <%= render 'application/subsection', title: 'Path' %>
          <% if systems.any? %>
            <div class='table-card'>
              <div class='table-scroll'>
                <table>
                  <thead>
                    <tr>
                      <th class='text-right w-12'>#</th>
                      <th>System</th>
                      <th>UWP</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% systems.each_with_index do |sys, i| %>
                      <tr class='<%= 'text-highlight font-medium' if i == 0 || i == systems.size - 1 %>'>
                        <td class='text-right tabular-nums text-fg-muted'><%= i + 1 %></td>
                        <td>
                          <%= render 'star_systems/system_link', star_system: sys %>
                        </td>
                        <td class='font-mono'><%= sys.main_world_uwp %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
            <div class='mt-2'>
              <%= link_to export_path_jump_route_path(@jump_route), class: 'btn btn-sm' do %>
                <i class='fa-regular fa-download mr-1'></i> Export CSV
              <% end %>
            </div>
          <% else %>
            <p class='text-sm text-fg-muted mb-4'>Path could not be resolved. Edit the route to recalculate.</p>
          <% end %>
        </div>
      </div>
    <% else %>
      <%= render 'application/subsection', title: 'Path' %>
      <% if systems.any? %>
        <div class='table-card'>
          <div class='table-scroll'>
            <table>
              <thead>
                <tr>
                  <th class='text-right w-12'>#</th>
                  <th>System</th>
                  <th>UWP</th>
                </tr>
              </thead>
              <tbody>
                <% systems.each_with_index do |sys, i| %>
                  <tr class='<%= 'text-highlight font-medium' if i == 0 || i == systems.size - 1 %>'>
                    <td class='text-right tabular-nums text-fg-muted'><%= i + 1 %></td>
                    <td>
                      <%= render 'star_systems/system_link', star_system: sys %>
                    </td>
                    <td class='font-mono'><%= sys.main_world_uwp %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <div class='mt-2'>
          <%= link_to export_path_jump_route_path(@jump_route), class: 'btn btn-sm' do %>
            <i class='fa-regular fa-download mr-1'></i> Export CSV
          <% end %>
        </div>
      <% else %>
        <p class='text-sm text-fg-muted mb-4'>Path could not be resolved. Edit the route to recalculate.</p>
      <% end %>
    <% end %>
  <% else %>
    <% links = @jump_route.jump_route_links.includes(from_star_system: { parsec: :sector }, to_star_system: { parsec: :sector }).order(:id) %>
    <% if @show_map && @map_svg %>
      <div class='flex gap-6 items-start my-4'>
        <div class='flex-1 min-w-0'>
          <div class='mb-1 relative flex items-center justify-end h-9'>
            <%= link_to map_jump_route_path(@jump_route),
                        target: '_blank',
                        rel: 'noopener',
                        class: 'text-fg-muted hover:text-fg-bright',
                        title: 'Open map in new tab' do %>
              <i class='fa-regular fa-arrow-up-right-from-square'></i>
            <% end %>
          </div>
          <div class='overflow-auto rounded-md'>
            <%= @map_svg.html_safe %>
          </div>
        </div>
        <div class='shrink-0'>
          <%= render 'application/subsection', title: 'Links' %>
          <% if links.any? %>
            <div class='table-card'>
              <div class='table-scroll'>
                <table>
                  <thead>
                    <tr>
                      <th>From System</th>
                      <th>To System</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% links.each do |link| %>
                      <tr id="<%= dom_id link %>">
                        <td>
                          <%= render 'star_systems/system_link', star_system: link.from_star_system %>
                        </td>
                        <td>
                          <%= render 'star_systems/system_link', star_system: link.to_star_system %>
                        </td>
                        <td class='text-right'>
                          <%= button_to jump_route_link_path(link),
                                method: :delete,
                                class: 'btn btn-sm btn-danger',
                                data: { turbo_confirm: 'Remove this link?' } do %>
                            <i class='fa-regular fa-trash'></i>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
            <div class='mt-2 flex gap-2 flex-wrap'>
              <%= link_to export_links_jump_route_path(@jump_route), class: 'btn btn-sm' do %>
                <i class='fa-regular fa-download mr-1'></i> Export CSV
              <% end %>
              <%= form_with url: jump_route_jump_route_import_path(@jump_route),
                            multipart: true, class: 'inline-flex items-center gap-2' do |f| %>
                <%= f.file_field :file, accept: '.csv', class: 'text-xs text-fg-muted' %>
                <%= f.submit 'Import CSV', class: 'btn btn-sm' %>
              <% end %>
            </div>
          <% else %>
            <p class='text-sm text-fg-muted mb-4'>No links defined yet. Import a CSV or add links from individual star systems.</p>
          <% end %>
        </div>
      </div>
    <% else %>
      <%= render 'application/subsection', title: 'Links' %>
      <% if links.any? %>
        <div class='table-card'>
          <div class='table-scroll'>
            <table>
              <thead>
                <tr>
                  <th>From System</th>
                  <th>To System</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% links.each do |link| %>
                  <tr id="<%= dom_id link %>">
                    <td>
                      <%= render 'star_systems/system_link', star_system: link.from_star_system %>
                    </td>
                    <td>
                      <%= render 'star_systems/system_link', star_system: link.to_star_system %>
                    </td>
                    <td class='text-right'>
                      <%= button_to jump_route_link_path(link),
                            method: :delete,
                            class: 'btn btn-sm btn-danger',
                            data: { turbo_confirm: 'Remove this link?' } do %>
                        <i class='fa-regular fa-trash'></i>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <div class='mt-2 flex gap-2 flex-wrap'>
          <%= link_to export_links_jump_route_path(@jump_route), class: 'btn btn-sm' do %>
            <i class='fa-regular fa-download mr-1'></i> Export CSV
          <% end %>
          <%= form_with url: jump_route_jump_route_import_path(@jump_route),
                        multipart: true, class: 'inline-flex items-center gap-2' do |f| %>
            <%= f.file_field :file, accept: '.csv', class: 'text-xs text-fg-muted' %>
            <%= f.submit 'Import CSV', class: 'btn btn-sm' %>
          <% end %>
        </div>
      <% else %>
        <p class='text-sm text-fg-muted mb-4'>No links defined yet. Import a CSV or add links from individual star systems.</p>
      <% end %>
    <% end %>
  <% end %>

  <%= link_to 'Edit', edit_jump_route_path(@jump_route), class: 'w-full sm:w-auto btn btn-primary' %>
  <%= render 'application/back_button',
             path: jump_routes_path,
             label: 'Jump Routes',
             class: 'w-full sm:w-auto' %>
  <%= button_to 'Delete',
                @jump_route,
                method: :delete,
                form_class: 'w-full sm:w-auto inline-flex m-0',
                class: 'w-full sm:w-auto btn btn-danger cursor-pointer',
                data: { turbo_confirm: "Delete #{@jump_route.name}?" } %>
<% end %>
