<% content_for :title, @jump_route.name %>
<% content_for :page_kicker, 'Jump Route' %>
<% content_for :page_title, @jump_route.name %>

<%= render 'application/page' do %>
  <%= render @jump_route %>

  <turbo-frame id='<%= dom_id(@jump_route, :statistics) %>' src='<%= statistics_jump_route_path(@jump_route) %>' target='_top'>
    <%= render 'application/statistics_loading' %>
  </turbo-frame>

  <%= link_to 'Edit', edit_jump_route_path(@jump_route), class: 'w-full sm:w-auto btn btn-primary' %>
  <%= render 'application/back_button',
             path: jump_routes_path,
             label: 'Jump Routes',
             class: 'w-full sm:w-auto' %>
  <%= button_to 'Delete',
                @jump_route,
                method: :delete,
                form_class: 'w-full sm:w-auto inline-flex m-0',
                class: 'w-full sm:w-auto btn btn-danger cursor-pointer',
                data: { turbo_confirm: "Delete #{@jump_route.name}?" } %>
<% end %>
