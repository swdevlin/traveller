<% content_for :title, @jump_route.name %>
<% content_for :page_kicker, 'Jump Route' %>
<% content_for :page_title, @jump_route.name %>

<%= render 'application/page' do %>
  <%= render @jump_route %>

  <% if @show_map %>
    <%= render 'application/subsection', title: 'Map' %>
    <div class='my-4'>
      <div class='mb-1 relative flex items-center justify-end h-9'>
        <%= link_to map_jump_route_path(@jump_route),
                    target: '_blank',
                    rel: 'noopener',
                    class: 'text-fg-muted hover:text-fg-bright',
                    title: 'Open map in new tab' do %>
          <i class='fa-regular fa-arrow-up-right-from-square'></i>
        <% end %>
      </div>
      <img src="<%= map_jump_route_path(@jump_route) %>"
           class='w-full h-auto rounded-md'
           alt='Route map' />
    </div>
  <% end %>

  <%= render 'application/subsection', title: 'Links' %>

  <div class='flex justify-between items-start mb-3'>
    <div class='flex gap-2 flex-wrap'>
      <%= link_to export_links_jump_route_path(@jump_route),
                  class: 'btn btn-sm' do %>
        <i class='fa-regular fa-download mr-1'></i> Export CSV
      <% end %>

      <%= form_with url: jump_route_jump_route_import_path(@jump_route),
                    multipart: true, class: 'inline-flex items-center gap-2' do |f| %>
        <%= f.file_field :file, accept: '.csv', class: 'text-xs text-fg-muted' %>
        <%= f.submit 'Import CSV', class: 'btn btn-sm' %>
      <% end %>
    </div>
  </div>

  <% links = @jump_route.jump_route_links.includes(from_star_system: :parsec, to_star_system: :parsec).order(:id) %>
  <% if links.any? %>
    <div class='table-card'>
      <div class='table-scroll'>
    <table>
      <thead>
        <tr>
          <th>From System</th>
          <th>Hex</th>
          <th>To System</th>
          <th>Hex</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% links.each do |link| %>
          <tr id="<%= dom_id link %>">
            <td>
              <%= link_to link.from_star_system.display_name,
                          star_system_path(link.from_star_system),
                          class: 'no-underline hover:underline hover:underline-offset-2' %>
            </td>
            <td><span class='identifier'><%= link.from_star_system.parsec.hex_code %></span></td>
            <td>
              <%= link_to link.to_star_system.display_name,
                          star_system_path(link.to_star_system),
                          class: 'no-underline hover:underline hover:underline-offset-2' %>
            </td>
            <td><span class='identifier'><%= link.to_star_system.parsec.hex_code %></span></td>
            <td class='text-right'>
              <%= button_to jump_route_link_path(link),
                    method: :delete,
                    class: 'btn btn-sm btn-danger',
                    data: { turbo_confirm: 'Remove this link?' } do %>
                <i class='fa-regular fa-trash'></i>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
      </div>
    </div>
  <% else %>
    <p class='text-sm text-fg-muted mb-4'>No links defined yet. Import a CSV or add links from individual star systems.</p>
  <% end %>

  <%= link_to 'Edit', edit_jump_route_path(@jump_route), class: 'w-full sm:w-auto btn btn-primary' %>
  <%= render 'application/back_button',
             path: jump_routes_path,
             label: 'Jump Routes',
             class: 'w-full sm:w-auto' %>
  <%= button_to 'Delete',
                @jump_route,
                method: :delete,
                form_class: 'w-full sm:w-auto inline-flex m-0',
                class: 'w-full sm:w-auto btn btn-danger cursor-pointer',
                data: { turbo_confirm: "Delete #{@jump_route.name}?" } %>
<% end %>
