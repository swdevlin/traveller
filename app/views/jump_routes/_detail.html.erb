<% if jump_route.plotted? %>
  <%= render 'application/subsection', title: 'Path' %>
  <div class='mb-2 text-sm flex gap-4'>
    <span>
      <span class='text-fg-muted text-xs uppercase tracking-wider'>Total Time</span>
      <span class='font-semibold text-fg ml-1'>
        <%= format_duration_range(@route_total[:total_min_hours], @route_total[:total_avg_hours], @route_total[:total_max_hours]) %>
      </span>
    </span>
    <span>
      <span class='text-fg-muted text-xs uppercase tracking-wider'>Jump Time</span>
      <span class='font-semibold text-fg ml-1'>
        <%= format_duration_range(@route_total[:jump_min_hours], @route_total[:jump_avg_hours], @route_total[:jump_max_hours]) %>
      </span>
    </span>
    <span>
      <span class='text-fg-muted text-xs uppercase tracking-wider'>Transit Time</span>
      <span class='font-semibold text-fg ml-1'><%= format_duration_hours(@route_total[:transit_hours]) %></span>
    </span>
  </div>
  <div class='table-card no-row-dividers'>
    <div class='table-scroll'>
      <table>
        <thead>
          <tr>
            <th class='text-right w-12'>#</th>
            <th>System</th>
            <th>UWP</th>
            <th class='text-right'>Transit Time (one-way)</th>
            <th class='text-right'>Elapsed</th>
          </tr>
        </thead>
        <tbody>
          <% @ordered_systems.each_with_index do |sys, i| %>
            <tr class='<%= 'text-highlight font-medium' if i == 0 || i == @ordered_systems.size - 1 %>'>
              <td class='text-right tabular-nums text-fg-muted'><%= i + 1 %></td>
              <td>
                <%= render 'star_systems/system_link', star_system: sys %>
              </td>
              <td class='font-mono'><%= sys.main_world_uwp %></td>
              <td class='text-right tabular-nums text-fg-muted'>
                <%= format_duration_hours(@hop_timings[i].transit_hours) %>
              </td>
              <td class='text-right tabular-nums text-fg-muted'>
                <%= format_duration_hours(@hop_timings[i].elapsed_avg_hours) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <%= render 'application/subsection', title: 'Links' %>
  <div class='table-card'>
    <div class='table-scroll'>
      <table>
        <thead>
          <tr>
            <th>From System</th>
            <th>To System</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @links.each do |link| %>
            <tr id="<%= dom_id link %>">
              <td>
                <%= render 'star_systems/system_link', star_system: link.from_star_system %>
              </td>
              <td>
                <%= render 'star_systems/system_link', star_system: link.to_star_system %>
              </td>
              <td class='text-right'>
                <%= button_to jump_route_link_path(link),
                      method: :delete,
                      class: 'btn btn-sm btn-danger',
                      data: { turbo_confirm: 'Remove this link?' } do %>
                  <i class='fa-regular fa-trash'></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
