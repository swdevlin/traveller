<% allegiance = gravity_anomaly.allegiance %>
<% star = gravity_anomaly.orbiting_star %>
<% star_system = star&.star_system %>
<% parsec = gravity_anomaly.parsec || star_system&.parsec %>
<% subsector = parsec&.subsector %>
<% sector = parsec&.sector %>

<% allegiance_value =
     if allegiance
       safe_join([
                   allegiance.name,
                   content_tag(:span, allegiance.code, class: "identifier")
                 ])
     else
       "None"
     end
%>

<div id="<%= dom_id gravity_anomaly %>" class="space-y-6">
  <div class="mt-5 grid grid-cols-1 gap-2 sm:grid-cols-5">
    <% if star %>
      <%= render 'application/data_block',
                 label: 'Orbiting',
                 value: link_to(star.display_name,
                                star_path(star),
                                class: 'hover:underline underline-offset-4') %>
    <% end %>
    <% if star_system %>
      <%= render 'application/data_block',
                 label: 'Star System',
                 value: link_to(star_system.display_name,
                                star_system_path(star_system),
                                class: 'hover:underline underline-offset-4') %>
    <% end %>

    <% if subsector %>
      <%= render 'application/data_block',
                 label: 'Subsector',
                 value: link_to(subsector.name,
                                subsector_path(subsector),
                                class: 'hover:underline underline-offset-4') %>
    <% end %>

    <% if sector %>
      <%= render 'application/data_block',
                 label: 'Sector',
                 value: link_to(
                   sector.name,
                   sector_path(sector),
                   class: 'hover:underline underline-offset-4'
                 ),
                 value_wrap_class: 'flex flex-wrap items-center gap-2',
                 suffix: tag.span(parsec.hex_code, class: 'identifier') %>
    <% end %>

    <%= render 'application/data_block',
               label: 'Allegiance',
               value: allegiance_value %>
  </div>

  <% if star %>
    <div class="flex items-center gap-2 pt-2">
      <div class="text-xs uppercase tracking-[0.22em] text-deepnight-orange">
        Orbital Data
      </div>
      <div class="h-px flex-1 bg-slate-700/70"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2">
      <%= render 'application/data_block', label: 'Orbit', value: number_with_precision(gravity_anomaly.orbit, precision: 2, strip_insignificant_zeros: true) %>
      <%= render 'application/data_block', label: 'AU', value: number_with_precision(gravity_anomaly.au, precision: 2, strip_insignificant_zeros: true) %>
      <%= render 'application/data_block', label: 'Effective HZCO Deviation', value: number_with_precision(gravity_anomaly.effective_hzco_deviation, precision: 2, strip_insignificant_zeros: true) %>
      <%= render 'application/data_block', label: 'Inclination', value: number_with_precision(gravity_anomaly.inclination, precision: 2, strip_insignificant_zeros: true), suffix: '°' %>
      <%= render 'application/data_block', label: 'Eccentricity', value: number_with_precision(gravity_anomaly.eccentricity, precision: 2, strip_insignificant_zeros: true) %>
    </div>

    <%= render 'stellar_objects/jump_shadow_times', stellar_object: gravity_anomaly %>
  <% end %>

  <%= render 'application/observation_block',
             notes: gravity_anomaly.notes %>
</div>
