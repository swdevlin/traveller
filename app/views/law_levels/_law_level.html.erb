<div id="<%= dom_id law_level %>" class='space-y-6 mb-4'>
  <%= render 'application/data_block',
             label: 'Code',
             value_wrap_class: 'mt-2 flex flex-wrap items-center gap-2 text-slate-100',
             value: law_level.code
  %>

  <%= render 'application/data_block',
             label: 'Armour',
             value_wrap_class: 'mt-2 flex flex-wrap items-center gap-2 text-slate-100',
             value: law_level.armour
  %>

  <%= render 'application/data_block',
             label: 'Weapons',
             value_wrap_class: 'mt-2 flex flex-wrap items-center gap-2 text-slate-100',
             value: law_level.weapons
  %>

  <%= render 'application/data_block',
             label: 'Economic law',
             value_wrap_class: 'mt-2 flex flex-wrap items-center gap-2 text-slate-100',
             value: law_level.economic_law
  %>

  <%= render 'application/data_block',
             label: 'Criminal law',
             value_wrap_class: 'mt-2 flex flex-wrap items-center gap-2 text-slate-100',
             value: law_level.criminal_law
  %>

  <%= render 'application/data_block',
             label: 'Private law',
             value_wrap_class: 'mt-2 flex flex-wrap items-center gap-2 text-slate-100',
             value: law_level.private_law
  %>

  <%= render 'application/data_block',
             label: 'Personal law',
             value_wrap_class: 'mt-2 flex flex-wrap items-center gap-2 text-slate-100',
             value: law_level.personal_law
  %>

  <%= render 'application/data_block',
             label: 'Notes',
             value_wrap_class: 'mt-2 flex flex-wrap items-center gap-2 text-slate-100',
             value: law_level.notes
  %>

</div>
