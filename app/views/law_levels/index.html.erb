<%= content_for :title, "Law levels" %>
<%= content_for :page_kicker, "Reference Manual" %>
<%= content_for :page_title, "Law levels" %>

<%= render 'application/page' do %>
  <div class='t-card'>
    <div class='t-card-header flex items-center justify-between gap-3'>
      <p class='t-card-title'>Law level registry</p>
      <%= link_to new_law_level_path, class: "btn-header" do %>
        <i class="fa-solid fa-plus text-[0.7rem]"></i>
        Add
      <% end %>
    </div>

    <div class='t-scroll-x'>
      <table class='t-table'>
        <thead class='t-thead'>
          <tr>
            <th scope='col' class='t-th'>Code</th>
            <th scope='col' class='t-th'>Armour</th>
            <th scope='col' class='t-th'>Weapons</th>
            <th scope='col' class='t-th-right'>Actions</th>
          </tr>
        </thead>

        <tbody class='t-tbody'>
          <% @law_levels.each do |law_level| %>
            <tr class='t-tr'>
              <td class='t-td'>
                <%= link_to law_level_path(law_level), class: "no-underline" do %>
                  <%= traveller_hex(law_level.code) %>
                <% end %>
              </td>
              <td class='t-td'>
                <%= law_level.armour %>
              </td>
              <td class='t-td'>
                <%= law_level.weapons %>
              </td>
              <td class='t-td-right'>
                <div class='t-actions'>
                  <%= link_to edit_law_level_path(law_level), class: 't-action' do %>
                    <i class='fa-regular fa-pen-to-square'></i>
                  <% end %>

                  <%= button_to law_level,
                                method: :delete,
                                class: 't-action-danger',
                                data: { turbo_confirm: "Delete this law level?" } do %>
                    <i class='fa-regular fa-trash'></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
